<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <!-- Real supervisor coverage needs Windows.Storage; pure model/parser tests remain portable. -->
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('Windows'))">net10.0;net10.0-windows10.0.26100.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <!-- A test-only entry point imports fixtures in a child with no inherited environment. -->
    <GenerateProgramFile>false</GenerateProgramFile>
    <StartupObject>WslContainerDesktop.Tests.Services.ComposeConformanceWorker</StartupObject>
    <NoWarn>$(NoWarn);MVVMTK0045</NoWarn>
  </PropertyGroup>

