<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="WslContainerDesktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i18n="using:WslContainerDesktop.Helpers"
    xmlns:controls="using:WslContainerDesktop.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WslContainerDesktop"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="WSL Container Desktop"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="WSL Container Desktop"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="TitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
            <TitleBar.RightHeader>
                <Button
                    x:Name="AssistantButton"
                    MinWidth="0"
                    Height="36"
                    Margin="0,0,8,0"
                    Padding="12,6"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Open Container AI Assistant"
                    Background="{ThemeResource AccentFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    CornerRadius="{ThemeResource ControlCornerRadius}"
                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                    Click="AssistantButton_Click"
                    x:Uid="Root_AssistantButton" i18n:Localization.Uid="Root_AssistantButton"
                    Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon
                            Width="16"
                            Height="16"
                            Data="M8,0 L9.6,6.4 L16,8 L9.6,9.6 L8,16 L6.4,9.6 L0,8 L6.4,6.4 Z" />
                        <TextBlock
                            x:Name="AssistantLabel"
                            VerticalAlignment="Center"
                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                            x:Uid="Nav_Assistant" i18n:Localization.Uid="Nav_Assistant" />
                    </StackPanel>
                </Button>
            </TitleBar.RightHeader>
        </TitleBar>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="True"
            PaneDisplayMode="Auto"
            PaneClosing="NavView_PaneClosing"
            PaneOpening="NavView_PaneOpening"
            ItemInvoked="NavView_ItemInvoked"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="Nav_Dashboard" i18n:Localization.Uid="Nav_Dashboard" IsSelected="True" Tag="dashboard">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Nav_Containers" i18n:Localization.Uid="Nav_Containers" Tag="containers">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7F4;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Nav_Images" i18n:Localization.Uid="Nav_Images" Tag="images">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEB9F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Nav_Volumes" i18n:Localization.Uid="Nav_Volumes" Tag="volumes">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Nav_Networks" i18n:Localization.Uid="Nav_Networks" Tag="networks">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE968;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Nav_Endpoints" i18n:Localization.Uid="Nav_Endpoints" Tag="endpoints">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE774;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Nav_Activity" i18n:Localization.Uid="Nav_Activity" Tag="activity">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Nav_Registries" i18n:Localization.Uid="Nav_Registries" Tag="registries">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE753;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Nav_Compose" i18n:Localization.Uid="Nav_Compose" Tag="compose">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81E;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <!-- Hidden until we have a better VS Code integration; re-enable by removing Visibility="Collapsed" -->
                <NavigationViewItem x:Uid="Nav_DevContainers" i18n:Localization.Uid="Nav_DevContainers" Tag="devcontainers" Visibility="Collapsed">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Nav_Templates" i18n:Localization.Uid="Nav_Templates" Tag="templates">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE71D;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Nav_Kubernetes" i18n:Localization.Uid="Nav_Kubernetes" Tag="kubernetes">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEB3C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Uid="Nav_WslEngine" i18n:Localization.Uid="Nav_WslEngine" Tag="wsl">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE977;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Nav_Reclaim" i18n:Localization.Uid="Nav_Reclaim" Tag="reclaim">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEDA2;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <NavigationView.PaneFooter>
                <StackPanel x:Name="PaneFooterPanel" Margin="12,8,12,12" Spacing="6">
                    <Border
                        Padding="10,6"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="6"
                        Visibility="{x:Bind Shell.KubernetesVisibility, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse
                                Width="10"
                                Height="10"
                                VerticalAlignment="Center"
                                Fill="{x:Bind Shell.KubernetesStatusBrush, Mode=OneWay}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Text="{x:Bind Shell.KubernetesStatusText, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                    <Border
                        Padding="10,6"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse
                                Width="10"
                                Height="10"
                                VerticalAlignment="Center"
                                Fill="{x:Bind Shell.EngineStatusBrush, Mode=OneWay}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Text="{x:Bind Shell.EngineStatusText, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </NavigationView.PaneFooter>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  App update notification bar  -->
                <InfoBar
                    x:Name="UpdateBar"
                    Margin="16,8,16,0"
                    AutomationProperties.AutomationId="AppUpdateInfoBar"
                    CloseButtonClick="UpdateBar_CloseButtonClick"
                    IsClosable="{x:Bind Updates.IsBarClosable, Mode=OneWay}"
                    IsOpen="{x:Bind Updates.IsBarOpen, Mode=OneWay}"
                    Message="{x:Bind Updates.BarMessageDisplay, Mode=OneWay}"
                    Severity="{x:Bind Updates.BarSeverity, Mode=OneWay}"
                    Title="{x:Bind Updates.BarTitleDisplay, Mode=OneWay}">
                    <InfoBar.Content>
                        <StackPanel Margin="0,0,0,12" Spacing="8">
                            <ProgressBar
                                IsIndeterminate="{x:Bind Updates.IsProgressIndeterminate, Mode=OneWay}"
                                Maximum="100"
                                Visibility="{x:Bind local:MainWindow.ToVisibility(Updates.IsProgressVisible), Mode=OneWay}"
                                Value="{x:Bind Updates.ProgressValue, Mode=OneWay}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    AutomationProperties.AutomationId="AppUpdateNowButton"
                                    Command="{x:Bind Updates.UpdateNowCommand}"
                                    Content="{x:Bind Updates.UpdateButtonTextDisplay, Mode=OneWay}"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    Visibility="{x:Bind local:MainWindow.ToVisibility(Updates.IsUpdateButtonVisible), Mode=OneWay}" />
                                <Button
                                    x:Name="WhatsNewButton"
                                    Command="{x:Bind Updates.ViewReleaseNotesCommand}"
                                    x:Uid="Update_WhatsNew" i18n:Localization.Uid="Update_WhatsNew"
                                    Visibility="{x:Bind local:MainWindow.ToVisibility(Updates.IsReleaseNotesVisible), Mode=OneWay}" />
                            </StackPanel>
                        </StackPanel>
                    </InfoBar.Content>
                </InfoBar>

                <Grid Grid.Row="1">
                    <Frame x:Name="NavFrame" />
                    <controls:RequirementGateView
                        x:Name="RequirementGate"
                        Visibility="Collapsed" />
                </Grid>
            </Grid>
        </NavigationView>

        <Border
            Grid.Row="2"
            Padding="16,5"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind Shell.EngineStatusText, Mode=OneWay}" />
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="|"
                    Visibility="{x:Bind Shell.KubernetesVisibility, Mode=OneWay}" />
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind Shell.KubernetesStatusText, Mode=OneWay}"
                    Visibility="{x:Bind Shell.KubernetesVisibility, Mode=OneWay}" />
            </StackPanel>
        </Border>

        <Grid
            x:Name="AssistantOverlay"
            Grid.Row="1"
            Grid.RowSpan="2"
            Background="#66000000"
            Visibility="Collapsed">
            <Button
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="Transparent"
                BorderThickness="0"
                Click="AssistantScrim_Click" />
            <Border
                Width="480"
                MinWidth="380"
                MaxWidth="640"
                HorizontalAlignment="Right"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="1,0,0,0">
                <controls:AssistantPanel x:Name="AssistantPanel" CloseRequested="AssistantPanel_CloseRequested" />
            </Border>
        </Grid>
    </Grid>
</Window>
