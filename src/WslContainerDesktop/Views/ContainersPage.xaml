<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WslContainerDesktop.Views.ContainersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i18n="using:WslContainerDesktop.Helpers"
    xmlns:converters="using:WslContainerDesktop.Helpers"
    xmlns:controls="using:WslContainerDesktop.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:WslContainerDesktop.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:WslContainerDesktop.ViewModels"
    x:Name="Root"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:StateToBrushConverter x:Key="StateToBrush" />
        <converters:StateToStringConverter x:Key="StateToString" />
        <converters:HealthToBrushConverter x:Key="HealthToBrush" />
        <converters:RelativeTimeConverter x:Key="RelativeTime" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:EmptyToVisibilityConverter x:Key="EmptyToVis" />
        <converters:BoolToSelectionModeConverter x:Key="BoolToSelMode" />
        <converters:InverseBoolConverter x:Key="InverseBool" />
    </Page.Resources>

    <Grid Margin="24,16,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header  -->
        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock x:Uid="Resource_Containers_001" i18n:Localization.Uid="Resource_Containers_001" Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.StatusMessageDisplay, Mode=OneWay}" />
        </StackPanel>

        <!-- Toolbar  -->
        <Grid Grid.Row="1">
            <Grid Visibility="{x:Bind ViewModel.IsSelectionMode, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <converters:WrapPanel
                    Grid.Column="0"
                    HorizontalSpacing="8"
                    VerticalSpacing="8">
                    <Button Command="{x:Bind ViewModel.RunCommand}" Style="{ThemeResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE768;" />
                            <TextBlock x:Uid="Resource_Containers_002" i18n:Localization.Uid="Resource_Containers_002" />
                        </StackPanel>
                    </Button>
                    <Button x:Uid="Resource_Containers_003" i18n:Localization.Uid="Resource_Containers_003"

                        Command="{x:Bind ViewModel.ImportDockerRunCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE8B5;" />
                            <TextBlock x:Uid="Resource_Containers_004" i18n:Localization.Uid="Resource_Containers_004" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.RefreshCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE72C;" />
                            <TextBlock x:Uid="Resource_Containers_005" i18n:Localization.Uid="Resource_Containers_005" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.PruneCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE74D;" />
                            <TextBlock x:Uid="Resource_Containers_006" i18n:Localization.Uid="Resource_Containers_006" />
                        </StackPanel>
                    </Button>
                    <ToggleButton x:Uid="Resource_Containers_007" i18n:Localization.Uid="Resource_Containers_007" IsChecked="{x:Bind ViewModel.IsSelectionMode, Mode=TwoWay}" >
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE762;" />
                            <TextBlock x:Uid="Resource_Containers_008" i18n:Localization.Uid="Resource_Containers_008" />
                        </StackPanel>
                    </ToggleButton>
                </converters:WrapPanel>
                <StackPanel
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <TextBlock x:Uid="Resource_Containers_009" i18n:Localization.Uid="Resource_Containers_009" VerticalAlignment="Center" />
                    <controls:InfoTip
                        Title="{x:Bind helpers:FlagHelp.ContainersShowAll.Title}"
                        Flag="{x:Bind helpers:FlagHelp.ContainersShowAll.Flag}"
                        Text="{x:Bind helpers:FlagHelp.ContainersShowAll.Text}" />
                    <ToggleSwitch MinWidth="0" IsOn="{x:Bind ViewModel.ShowAll, Mode=TwoWay}" />
                </StackPanel>
            </Grid>

            <!-- Bulk-action bar (shown while selecting)  -->
            <StackPanel
                Orientation="Horizontal"
                Spacing="8"
                Visibility="{x:Bind ViewModel.IsSelectionMode, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <TextBlock
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="{x:Bind ViewModel.SelectionSummary, Mode=OneWay}" />
                <Button Click="BulkStart_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE768;" />
                        <TextBlock x:Uid="Resource_Containers_010" i18n:Localization.Uid="Resource_Containers_010" />
                    </StackPanel>
                </Button>
                <Button Click="BulkStop_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE71A;" />
                        <TextBlock x:Uid="Resource_Containers_011" i18n:Localization.Uid="Resource_Containers_011" />
                    </StackPanel>
                </Button>
                <Button Click="BulkRemove_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                        <TextBlock x:Uid="Resource_Containers_012" i18n:Localization.Uid="Resource_Containers_012" />
                    </StackPanel>
                </Button>
                <Button Click="BulkCancel_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE711;" />
                        <TextBlock x:Uid="Resource_Containers_013" i18n:Localization.Uid="Resource_Containers_013" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Table: column header (wide only) + list  -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="HeaderWide">
                        <VisualState.StateTriggers>
                            <converters:ControlSizeTrigger MinWidth="680" TargetElement="{Binding ElementName=Root}" />
                        </VisualState.StateTriggers>
                    </VisualState>
                    <VisualState x:Name="HeaderNarrow">
                        <VisualState.StateTriggers>
                            <converters:ControlSizeTrigger MaxWidth="680" TargetElement="{Binding ElementName=Root}" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="HeaderBorder.Visibility" Value="Collapsed" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

                <!-- Column header  -->
                <Border
                    x:Name="HeaderBorder"
                    Grid.Row="0"
                    Padding="16,8,20,8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6,6,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="1.8*" MinWidth="110" />
                    <ColumnDefinition Width="1.9*" MinWidth="110" />
                    <ColumnDefinition Width="1.2*" MinWidth="80" />
                    <ColumnDefinition Width="1.1*" MinWidth="80" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="84" />
                    <ColumnDefinition Width="156" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Uid="Resource_Containers_014" i18n:Localization.Uid="Resource_Containers_014" Grid.Column="1" Margin="10,0,0,0" Style="{ThemeResource CaptionTextBlockStyle}" />
                <TextBlock x:Uid="Resource_Containers_015" i18n:Localization.Uid="Resource_Containers_015" Grid.Column="2" Style="{ThemeResource CaptionTextBlockStyle}" />
                <TextBlock x:Uid="Resource_Containers_016" i18n:Localization.Uid="Resource_Containers_016" Grid.Column="3" Style="{ThemeResource CaptionTextBlockStyle}" />
                <TextBlock x:Uid="Resource_Containers_017" i18n:Localization.Uid="Resource_Containers_017" Grid.Column="4" Style="{ThemeResource CaptionTextBlockStyle}" />
                <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4">
                    <TextBlock x:Uid="Resource_Containers_018" i18n:Localization.Uid="Resource_Containers_018" Style="{ThemeResource CaptionTextBlockStyle}" />
                    <controls:InfoTip
                        Title="{x:Bind helpers:FlagHelp.ContainersSize.Title}"
                        Flag="{x:Bind helpers:FlagHelp.ContainersSize.Flag}"
                        Text="{x:Bind helpers:FlagHelp.ContainersSize.Text}" />
                </StackPanel>
                <TextBlock x:Uid="Resource_Containers_019" i18n:Localization.Uid="Resource_Containers_019" Grid.Column="6" Style="{ThemeResource CaptionTextBlockStyle}" />
                <TextBlock x:Uid="Resource_Containers_020" i18n:Localization.Uid="Resource_Containers_020"
                    Grid.Column="7"
                    HorizontalAlignment="Right"
                    Style="{ThemeResource CaptionTextBlockStyle}" />
            </Grid>
        </Border>

        <!-- List  -->
        <Border
            Grid.Row="1"
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="1,0,1,1"
            CornerRadius="0,0,6,6">
            <Grid>
                <ListView
                    x:Name="ContainersList"
                    Padding="0,4"
                    IsItemClickEnabled="{x:Bind ViewModel.IsSelectionMode, Mode=OneWay, Converter={StaticResource InverseBool}}"
                    ItemClick="ContainersList_ItemClick"
                    SelectionChanged="ContainersList_SelectionChanged"
                    SelectionMode="{x:Bind ViewModel.IsSelectionMode, Mode=OneWay, Converter={StaticResource BoolToSelMode}, ConverterParameter=None}">
                    <ListView.GroupStyle>
                        <GroupStyle HidesIfEmpty="True">
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate x:DataType="vm:ContainerGroup">
                                    <Border Padding="10,10,10,4">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontWeight="SemiBold"
                                                Text="{x:Bind DisplayTitle, Mode=OneWay}" />
                                            <Border
                                                Padding="6,0"
                                                VerticalAlignment="Center"
                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                CornerRadius="9">
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind Count}" />
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListView.GroupStyle>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="16,6,20,6" />
                            <Setter Property="MinHeight" Value="56" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ContainerRowViewModel">
                            <Grid x:Name="RowRoot">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup>
                                        <VisualState x:Name="RowWide">
                                            <VisualState.StateTriggers>
                                                <converters:ControlSizeTrigger MinWidth="600" TargetElement="{Binding ElementName=RowRoot}" />
                                            </VisualState.StateTriggers>
                                        </VisualState>
                                        <VisualState x:Name="RowNarrow">
                                            <VisualState.StateTriggers>
                                                <converters:ControlSizeTrigger MaxWidth="600" TargetElement="{Binding ElementName=RowRoot}" />
                                            </VisualState.StateTriggers>
                                            <VisualState.Setters>
                                                <Setter Target="WideGrid.Visibility" Value="Collapsed" />
                                                <Setter Target="NarrowPanel.Visibility" Value="Visible" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <Grid x:Name="WideGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="1.8*" MinWidth="110" />
                                    <ColumnDefinition Width="1.9*" MinWidth="110" />
                                    <ColumnDefinition Width="1.2*" MinWidth="80" />
                                    <ColumnDefinition Width="1.1*" MinWidth="80" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="156" />
                                </Grid.ColumnDefinitions>

                                <Ellipse
                                    Grid.Column="0"
                                    Width="12"
                                    Height="12"
                                    VerticalAlignment="Center"
                                    Fill="{Binding State, Converter={StaticResource StateToBrush}}"
                                    ToolTipService.ToolTip="{Binding State, Converter={StaticResource StateToString}}" />

                                <StackPanel
                                    Grid.Column="1"
                                    Margin="10,0,8,0"
                                    VerticalAlignment="Center"
                                    Spacing="2">
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis" />
                                        <Border
                                            Grid.Column="1"
                                            Padding="5,1"
                                            VerticalAlignment="Center"
                                            Background="#1F7A3D"
                                            CornerRadius="4"
                                            ToolTipService.ToolTip="{Binding GpuTooltip}"
                                            Visibility="{Binding HasGpu, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal" Spacing="3">
                                                <FontIcon FontSize="10" Foreground="White" Glyph="&#xE950;" />
                                                <TextBlock FontSize="10" Foreground="White" Text="GPU" />
                                            </StackPanel>
                                        </Border>
                                        <Border
                                            Grid.Column="2"
                                            Padding="5,1"
                                            VerticalAlignment="Center"
                                            Background="{Binding Health, Converter={StaticResource HealthToBrush}}"
                                            CornerRadius="4"
                                            ToolTipService.ToolTip="{Binding HealthTooltip}"
                                            Visibility="{Binding HasHealthCheck, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal" Spacing="3">
                                                <FontIcon FontSize="10" Foreground="White" Glyph="&#xEB51;" />
                                                <TextBlock x:Uid="Resource_Containers_021" i18n:Localization.Uid="Resource_Containers_021" FontSize="10" Foreground="White" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <TextBlock
                                        FontFamily="Consolas"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Text="{Binding ShortId}" />
                                </StackPanel>

                                <TextBlock
                                    Grid.Column="2"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{Binding Image}"
                                    TextTrimming="CharacterEllipsis" />

                                <TextBlock
                                    Grid.Column="3"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Text="{Binding PortsDisplayText}"
                                    TextTrimming="CharacterEllipsis" />

                                <TextBlock
                                    Grid.Column="4"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{Binding Network}"
                                    TextTrimming="CharacterEllipsis" />

                                <TextBlock
                                    Grid.Column="5"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Text="{Binding SizeShortDisplay}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{Binding SizeDisplayText}" />

                                <TextBlock
                                    Grid.Column="6"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{Binding Created, Converter={StaticResource RelativeTime}}" />

                                <StackPanel
                                    Grid.Column="7"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="2">
                                    <Button x:Uid="Resource_Containers_022" i18n:Localization.Uid="Resource_Containers_022"
                                        Width="34"
                                        Height="34"
                                        Padding="0"

                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="StartButton_Click"

                                        Visibility="{Binding IsStopped, Converter={StaticResource BoolToVis}}">
                                        <FontIcon FontSize="15" Glyph="&#xE768;" />
                                    </Button>
                                    <Button x:Uid="Resource_Containers_023" i18n:Localization.Uid="Resource_Containers_023"
                                        Width="34"
                                        Height="34"
                                        Padding="0"

                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="StopButton_Click"

                                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                        <FontIcon FontSize="15" Glyph="&#xE71A;" />
                                    </Button>
                                    <Button x:Uid="Resource_Containers_024" i18n:Localization.Uid="Resource_Containers_024"
                                        Width="34"
                                        Height="34"
                                        Padding="0"

                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="RestartButton_Click"

                                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                        <FontIcon FontSize="15" Glyph="&#xE72C;" />
                                    </Button>
                                    <Button x:Uid="Resource_Containers_025" i18n:Localization.Uid="Resource_Containers_025"
                                        Width="34"
                                        Height="34"
                                        Padding="0"

                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="TerminalButton_Click"

                                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                        <FontIcon FontSize="15" Glyph="&#xE756;" />
                                    </Button>
                                    <Button x:Uid="Resource_Containers_026" i18n:Localization.Uid="Resource_Containers_026"
                                        Width="34"
                                        Height="34"
                                        Padding="0"

                                        Background="Transparent"
                                        BorderThickness="0">
                                        <FontIcon FontSize="15" Glyph="&#xE712;" />
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem x:Uid="Resource_Containers_027" i18n:Localization.Uid="Resource_Containers_027" Click="OpenPortMenu_Click" Visibility="{Binding CanOpenInBrowser, Converter={StaticResource BoolToVis}}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE774;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem x:Uid="Resource_Containers_028" i18n:Localization.Uid="Resource_Containers_028" Click="HealthCheckMenu_Click" >
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xEB51;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem x:Uid="Resource_Containers_029" i18n:Localization.Uid="Resource_Containers_029" Click="SaveAsProfileMenu_Click" >
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE78C;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem x:Uid="Resource_Containers_030" i18n:Localization.Uid="Resource_Containers_030" Click="ExportMenu_Click" ToolTipService.ToolTip="{x:Bind helpers:FlagHelp.ContainerExport.Text}" />
                                                <MenuFlyoutItem x:Uid="Resource_Containers_031" i18n:Localization.Uid="Resource_Containers_031" Click="AttachMenu_Click" ToolTipService.ToolTip="{x:Bind helpers:FlagHelp.ContainerAttach.Text}" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                                                <MenuFlyoutItem x:Uid="Resource_Containers_032" i18n:Localization.Uid="Resource_Containers_032" Click="KillMenu_Click" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem x:Uid="Resource_Containers_033" i18n:Localization.Uid="Resource_Containers_033" Click="RemoveMenu_Click" >
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE74D;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                                </Grid>

                                <!-- Narrow: stacked card layout (shown when the row is too narrow for columns)  -->
                                <StackPanel x:Name="NarrowPanel" Spacing="8" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Ellipse
                                            Width="12"
                                            Height="12"
                                            VerticalAlignment="Center"
                                            Fill="{Binding State, Converter={StaticResource StateToBrush}}"
                                            ToolTipService.ToolTip="{Binding State, Converter={StaticResource StateToString}}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis" />
                                        <Border
                                            Padding="5,1"
                                            VerticalAlignment="Center"
                                            Background="#1F7A3D"
                                            CornerRadius="4"
                                            ToolTipService.ToolTip="{Binding GpuTooltip}"
                                            Visibility="{Binding HasGpu, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal" Spacing="3">
                                                <FontIcon FontSize="10" Foreground="White" Glyph="&#xE950;" />
                                                <TextBlock FontSize="10" Foreground="White" Text="GPU" />
                                            </StackPanel>
                                        </Border>
                                        <Border
                                            Padding="5,1"
                                            VerticalAlignment="Center"
                                            Background="{Binding Health, Converter={StaticResource HealthToBrush}}"
                                            CornerRadius="4"
                                            ToolTipService.ToolTip="{Binding HealthTooltip}"
                                            Visibility="{Binding HasHealthCheck, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal" Spacing="3">
                                                <FontIcon FontSize="10" Foreground="White" Glyph="&#xEB51;" />
                                                <TextBlock x:Uid="Resource_Containers_034" i18n:Localization.Uid="Resource_Containers_034" FontSize="10" Foreground="White" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <TextBlock
                                        FontFamily="Consolas"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Text="{Binding ShortId}" />

                                    <Grid ColumnSpacing="8" RowSpacing="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="76" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock x:Uid="Resource_Containers_035" i18n:Localization.Uid="Resource_Containers_035" Grid.Row="0" Grid.Column="0" Style="{ThemeResource CaptionTextBlockStyle}" />
                                        <TextBlock
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding Image}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Uid="Resource_Containers_036" i18n:Localization.Uid="Resource_Containers_036" Grid.Row="1" Grid.Column="0" Style="{ThemeResource CaptionTextBlockStyle}" />
                                        <TextBlock
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            FontSize="12"
                                            Text="{Binding PortsDisplayText}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Uid="Resource_Containers_037" i18n:Localization.Uid="Resource_Containers_037" Grid.Row="2" Grid.Column="0" Style="{ThemeResource CaptionTextBlockStyle}" />
                                        <TextBlock
                                            Grid.Row="2"
                                            Grid.Column="1"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding Network}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Uid="Resource_Containers_038" i18n:Localization.Uid="Resource_Containers_038" Grid.Row="3" Grid.Column="0" Style="{ThemeResource CaptionTextBlockStyle}" />
                                        <TextBlock
                                            Grid.Row="3"
                                            Grid.Column="1"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding Created, Converter={StaticResource RelativeTime}}" />
                                        <TextBlock x:Uid="Resource_Containers_039" i18n:Localization.Uid="Resource_Containers_039" Grid.Row="4" Grid.Column="0" Style="{ThemeResource CaptionTextBlockStyle}" />
                                        <TextBlock
                                            Grid.Row="4"
                                            Grid.Column="1"
                                            FontSize="12"
                                            Text="{Binding SizeShortDisplay}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{Binding SizeDisplayText}" />
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <Button x:Uid="Resource_Containers_040" i18n:Localization.Uid="Resource_Containers_040"
                                            Width="34"
                                            Height="34"
                                            Padding="0"

                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="StartButton_Click"

                                            Visibility="{Binding IsStopped, Converter={StaticResource BoolToVis}}">
                                            <FontIcon FontSize="15" Glyph="&#xE768;" />
                                        </Button>
                                        <Button x:Uid="Resource_Containers_041" i18n:Localization.Uid="Resource_Containers_041"
                                            Width="34"
                                            Height="34"
                                            Padding="0"

                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="StopButton_Click"

                                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                            <FontIcon FontSize="15" Glyph="&#xE71A;" />
                                        </Button>
                                        <Button x:Uid="Resource_Containers_042" i18n:Localization.Uid="Resource_Containers_042"
                                            Width="34"
                                            Height="34"
                                            Padding="0"

                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="RestartButton_Click"

                                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                            <FontIcon FontSize="15" Glyph="&#xE72C;" />
                                        </Button>
                                        <Button x:Uid="Resource_Containers_043" i18n:Localization.Uid="Resource_Containers_043"
                                            Width="34"
                                            Height="34"
                                            Padding="0"

                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="TerminalButton_Click"

                                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                            <FontIcon FontSize="15" Glyph="&#xE756;" />
                                        </Button>
                                        <Button x:Uid="Resource_Containers_044" i18n:Localization.Uid="Resource_Containers_044"
                                            Width="34"
                                            Height="34"
                                            Padding="0"

                                            Background="Transparent"
                                            BorderThickness="0">
                                            <FontIcon FontSize="15" Glyph="&#xE712;" />
                                            <Button.Flyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem x:Uid="Resource_Containers_045" i18n:Localization.Uid="Resource_Containers_045" Click="OpenPortMenu_Click" Visibility="{Binding CanOpenInBrowser, Converter={StaticResource BoolToVis}}">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE774;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem x:Uid="Resource_Containers_046" i18n:Localization.Uid="Resource_Containers_046" Click="HealthCheckMenu_Click" >
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xEB51;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem x:Uid="Resource_Containers_047" i18n:Localization.Uid="Resource_Containers_047" Click="SaveAsProfileMenu_Click" >
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE78C;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem x:Uid="Resource_Containers_048" i18n:Localization.Uid="Resource_Containers_048" Click="ExportMenu_Click" ToolTipService.ToolTip="{x:Bind helpers:FlagHelp.ContainerExport.Text}" />
                                                    <MenuFlyoutItem x:Uid="Resource_Containers_049" i18n:Localization.Uid="Resource_Containers_049" Click="AttachMenu_Click" ToolTipService.ToolTip="{x:Bind helpers:FlagHelp.ContainerAttach.Text}" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                                                    <MenuFlyoutItem x:Uid="Resource_Containers_050" i18n:Localization.Uid="Resource_Containers_050" Click="KillMenu_Click" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                                                    <MenuFlyoutSeparator />
                                                    <MenuFlyoutItem x:Uid="Resource_Containers_051" i18n:Localization.Uid="Resource_Containers_051" Click="RemoveMenu_Click" >
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE74D;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Empty state  -->
                <StackPanel
                    Margin="0,70,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Spacing="10"
                    Visibility="{x:Bind ViewModel.Containers.Count, Mode=OneWay, Converter={StaticResource EmptyToVis}}">
                    <FontIcon
                        HorizontalAlignment="Center"
                        FontSize="44"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Glyph="&#xE7F4;" />
                    <TextBlock x:Uid="Resource_Containers_052" i18n:Localization.Uid="Resource_Containers_052"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <ProgressBar
                    VerticalAlignment="Top"
                    IsIndeterminate="True"
                    Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </Border>
        </Grid>
    </Grid>
</Page>
