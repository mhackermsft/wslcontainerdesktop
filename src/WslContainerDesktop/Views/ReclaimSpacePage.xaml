<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WslContainerDesktop.Views.ReclaimSpacePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i18n="using:WslContainerDesktop.Helpers"
    xmlns:converters="using:WslContainerDesktop.Helpers"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WslContainerDesktop.Models"
    x:Name="Root"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:EmptyToVisibilityConverter x:Key="EmptyToVis" />
        <converters:BytesToSizeConverter x:Key="BytesToSize" />
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="18,16" />
        </Style>
        <Style x:Key="ListCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,10" />
        </Style>
    </Page.Resources>

    <Grid>
        <ScrollViewer>
            <StackPanel Margin="24,16,24,24" Spacing="16">

                <!-- Header  -->
                <StackPanel Spacing="2">
                    <TextBlock x:Uid="Resource_ReclaimSpace_001" i18n:Localization.Uid="Resource_ReclaimSpace_001" Style="{ThemeResource TitleTextBlockStyle}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.StatusMessageDisplay, Mode=OneWay}" />
                </StackPanel>

                <!-- Actions  -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.PruneAllCommand}" Style="{ThemeResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE74D;" />
                            <TextBlock x:Uid="Resource_ReclaimSpace_002" i18n:Localization.Uid="Resource_ReclaimSpace_002" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.RefreshCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE72C;" />
                            <TextBlock x:Uid="Resource_ReclaimSpace_003" i18n:Localization.Uid="Resource_ReclaimSpace_003" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Reclaimable summary banner  -->
                <Border Style="{StaticResource StatCard}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Uid="Resource_ReclaimSpace_004" i18n:Localization.Uid="Resource_ReclaimSpace_004" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            FontSize="30"
                            FontWeight="SemiBold"
                            Text="{x:Bind ViewModel.TotalReclaimableSize, Mode=OneWay}" />
                        <TextBlock>
                            <Run x:Uid="Resource_ReclaimSpace_005" i18n:Localization.Uid="Resource_ReclaimSpace_005" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Run Text="{x:Bind ViewModel.StorageLocationDisplay, Mode=OneWay}" />
                        </TextBlock>
                        <Button x:Uid="Resource_ReclaimSpace_006" i18n:Localization.Uid="Resource_ReclaimSpace_006"
                            HorizontalAlignment="Left"
                            Click="OpenStorageSettings_Click" />
                        <TextBlock x:Uid="Resource_ReclaimSpace_007" i18n:Localization.Uid="Resource_ReclaimSpace_007"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Per-resource cards  -->
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Images  -->
                    <Border Grid.Column="0" Style="{StaticResource StatCard}">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    FontSize="16"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Glyph="&#xEB9F;" />
                                <TextBlock x:Uid="Resource_ReclaimSpace_008" i18n:Localization.Uid="Resource_ReclaimSpace_008" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock>
                                <Run x:Uid="Resource_ReclaimSpace_009" i18n:Localization.Uid="Resource_ReclaimSpace_009" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Run Text="{x:Bind ViewModel.ImagesTotalSize, Mode=OneWay}" />
                                <Run Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="  ·" />
                                <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.ImageCount, Mode=OneWay}" />
                                <Run x:Uid="Resource_ReclaimSpace_010" i18n:Localization.Uid="Resource_ReclaimSpace_010" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </TextBlock>
                            <TextBlock>
                                <Run x:Uid="Resource_ReclaimSpace_011" i18n:Localization.Uid="Resource_ReclaimSpace_011" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Run Text="{x:Bind ViewModel.ImagesReclaimableSize, Mode=OneWay}" />
                                <Run Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="  ·" />
                                <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.DanglingImageCount, Mode=OneWay}" />
                                <Run x:Uid="Resource_ReclaimSpace_012" i18n:Localization.Uid="Resource_ReclaimSpace_012" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </TextBlock>
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.RetainedDanglingNote, Mode=OneWay, Converter={StaticResource UiTextConverter}}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind ViewModel.HasRetainedDanglingImages, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                            <Button x:Uid="Resource_ReclaimSpace_013" i18n:Localization.Uid="Resource_ReclaimSpace_013"
                                HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.PruneImagesCommand}" />
                        </StackPanel>
                    </Border>

                    <!-- Containers  -->
                    <Border Grid.Column="1" Style="{StaticResource StatCard}">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    FontSize="16"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Glyph="&#xE7F4;" />
                                <TextBlock x:Uid="Resource_ReclaimSpace_014" i18n:Localization.Uid="Resource_ReclaimSpace_014" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock>
                                <Run x:Uid="Resource_ReclaimSpace_015" i18n:Localization.Uid="Resource_ReclaimSpace_015" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Run Text="{x:Bind ViewModel.ContainerCount, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock>
                                <Run x:Uid="Resource_ReclaimSpace_016" i18n:Localization.Uid="Resource_ReclaimSpace_016" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Run Text="{x:Bind ViewModel.StoppedContainerCount, Mode=OneWay}" />
                                <Run x:Uid="Resource_ReclaimSpace_017" i18n:Localization.Uid="Resource_ReclaimSpace_017" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </TextBlock>
                            <TextBlock>
                                <Run x:Uid="Resource_ReclaimSpace_018" i18n:Localization.Uid="Resource_ReclaimSpace_018" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Run Text="{x:Bind ViewModel.StoppedContainersReclaimableSize, Mode=OneWay}" />
                            </TextBlock>
                            <Button x:Uid="Resource_ReclaimSpace_019" i18n:Localization.Uid="Resource_ReclaimSpace_019"
                                HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.PruneContainersCommand}" />
                        </StackPanel>
                    </Border>

                    <!-- Volumes  -->
                    <Border Grid.Column="2" Style="{StaticResource StatCard}">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    FontSize="16"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Glyph="&#xE8B7;" />
                                <TextBlock x:Uid="Resource_ReclaimSpace_020" i18n:Localization.Uid="Resource_ReclaimSpace_020" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock>
                                <Run x:Uid="Resource_ReclaimSpace_021" i18n:Localization.Uid="Resource_ReclaimSpace_021" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Run Text="{x:Bind ViewModel.VolumeCount, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock>
                                <Run x:Uid="Resource_ReclaimSpace_022" i18n:Localization.Uid="Resource_ReclaimSpace_022" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Run Text="{x:Bind ViewModel.UnusedVolumeCount, Mode=OneWay}" />
                                <Run x:Uid="Resource_ReclaimSpace_023" i18n:Localization.Uid="Resource_ReclaimSpace_023" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </TextBlock>
                            <Button x:Uid="Resource_ReclaimSpace_024" i18n:Localization.Uid="Resource_ReclaimSpace_024"
                                HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.PruneVolumesCommand}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Largest images  -->
                <TextBlock x:Uid="Resource_ReclaimSpace_025" i18n:Localization.Uid="Resource_ReclaimSpace_025"
                    Margin="2,4,0,0"
                    Style="{ThemeResource BodyStrongTextBlockStyle}" />
                <Border Style="{StaticResource ListCard}">
                    <StackPanel Spacing="2">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.LargestImages, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:ImageInfo">
                                    <Grid Padding="0,6" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="160" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            FontFamily="Consolas"
                                            FontSize="13"
                                            Text="{x:Bind Reference}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontFamily="Consolas"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind ShortId}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            Text="{x:Bind Size, Converter={StaticResource BytesToSize}}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Uid="Resource_ReclaimSpace_026" i18n:Localization.Uid="Resource_ReclaimSpace_026"
                            Margin="0,8"
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"

                            Visibility="{x:Bind ViewModel.LargestImages.Count, Mode=OneWay, Converter={StaticResource EmptyToVis}}" />
                    </StackPanel>
                </Border>

                <!-- Dangling images  -->
                <TextBlock x:Uid="Resource_ReclaimSpace_027" i18n:Localization.Uid="Resource_ReclaimSpace_027"
                    Margin="2,4,0,0"
                    Style="{ThemeResource BodyStrongTextBlockStyle}" />
                <Border Style="{StaticResource ListCard}">
                    <StackPanel Spacing="2">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.DanglingImages, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:ImageInfo">
                                    <Grid Padding="0,6" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="160" />
                                            <ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock
                                                FontFamily="Consolas"
                                                FontSize="13"
                                                Text="{x:Bind ShortId}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind UsedByCaption, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis"
                                                Visibility="{x:Bind IsInUse, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="1"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            Text="{x:Bind Size, Converter={StaticResource BytesToSize}}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Uid="Resource_ReclaimSpace_028" i18n:Localization.Uid="Resource_ReclaimSpace_028"
                            Margin="0,8"
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"

                            Visibility="{x:Bind ViewModel.DanglingImages.Count, Mode=OneWay, Converter={StaticResource EmptyToVis}}" />
                    </StackPanel>
                </Border>

                <!-- Unused volumes  -->
                <TextBlock x:Uid="Resource_ReclaimSpace_029" i18n:Localization.Uid="Resource_ReclaimSpace_029"
                    Margin="2,4,0,0"
                    Style="{ThemeResource BodyStrongTextBlockStyle}" />
                <Border Style="{StaticResource ListCard}">
                    <StackPanel Spacing="2">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.UnusedVolumes, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:VolumeInfo">
                                    <Grid Padding="0,6" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="160" />
                                            <ColumnDefinition Width="110" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            FontFamily="Consolas"
                                            FontSize="13"
                                            Text="{x:Bind DisplayName}"
                                            ToolTipService.ToolTip="{x:Bind Name}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Grid.Column="1"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind TypeLabel, Mode=OneWay}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Uid="Resource_ReclaimSpace_030" i18n:Localization.Uid="Resource_ReclaimSpace_030"
                            Margin="0,8"
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"

                            Visibility="{x:Bind ViewModel.UnusedVolumes.Count, Mode=OneWay, Converter={StaticResource EmptyToVis}}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <ProgressBar
            VerticalAlignment="Top"
            IsIndeterminate="True"
            Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
    </Grid>
</Page>
