<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WslContainerDesktop.Views.WslEnginePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i18n="using:WslContainerDesktop.Helpers"
    xmlns:converters="using:WslContainerDesktop.Helpers"
    xmlns:controls="using:WslContainerDesktop.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:WslContainerDesktop.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WslContainerDesktop.Models"
    x:Name="Root"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:EmptyToVisibilityConverter x:Key="EmptyToVis" />
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="18,16" />
        </Style>
        <Style x:Key="ListCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,10" />
        </Style>
    </Page.Resources>

    <Grid>
        <ScrollViewer>
            <StackPanel Margin="24,16,24,24" Spacing="16">

                <!-- Header  -->
                <StackPanel Spacing="2">
                    <TextBlock x:Uid="Resource_WslEngine_001" i18n:Localization.Uid="Resource_WslEngine_001" Style="{ThemeResource TitleTextBlockStyle}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.StatusMessageDisplay, Mode=OneWay}" />
                </StackPanel>

                <!-- Actions  -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.RestartSessionCommand}" Style="{ThemeResource AccentButtonStyle}">
                        <ToolTipService.ToolTip>
                            <ToolTip>
                                <StackPanel MaxWidth="380" Spacing="4">
                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind helpers:FlagHelp.RestartWslSession.Title}" />
                                    <TextBlock FontFamily="Consolas" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind helpers:FlagHelp.RestartWslSession.Flag}" />
                                    <TextBlock Text="{x:Bind helpers:FlagHelp.RestartWslSession.Text}" TextWrapping="Wrap" />
                                </StackPanel>
                            </ToolTip>
                        </ToolTipService.ToolTip>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE72C;" />
                            <TextBlock x:Uid="Resource_WslEngine_002" i18n:Localization.Uid="Resource_WslEngine_002" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.ShutdownWslCommand}">
                        <ToolTipService.ToolTip>
                            <ToolTip>
                                <StackPanel MaxWidth="380" Spacing="4">
                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind helpers:FlagHelp.ShutdownWsl.Title}" />
                                    <TextBlock FontFamily="Consolas" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind helpers:FlagHelp.ShutdownWsl.Flag}" />
                                    <TextBlock Text="{x:Bind helpers:FlagHelp.ShutdownWsl.Text}" TextWrapping="Wrap" />
                                </StackPanel>
                            </ToolTip>
                        </ToolTipService.ToolTip>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE7E8;" />
                            <TextBlock x:Uid="Resource_WslEngine_003" i18n:Localization.Uid="Resource_WslEngine_003" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.RefreshCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE72C;" />
                            <TextBlock x:Uid="Resource_WslEngine_004" i18n:Localization.Uid="Resource_WslEngine_004" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- WSL updates  -->
                <Border Style="{StaticResource StatCard}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                FontSize="16"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE895;" />
                            <TextBlock x:Uid="Resource_WslEngine_005" i18n:Localization.Uid="Resource_WslEngine_005"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold" />
                            <ProgressRing
                                Width="16"
                                Height="16"
                                VerticalAlignment="Center"
                                IsActive="{x:Bind ViewModel.IsCheckingUpdate, Mode=OneWay}" />
                        </StackPanel>

                        <!-- Installed + latest available versions (latest depends on the channel toggle)  -->
                        <StackPanel Spacing="4">
                            <TextBlock>
                                <Run x:Uid="Resource_WslEngine_006" i18n:Localization.Uid="Resource_WslEngine_006" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Run Text="{x:Bind ViewModel.WslVersionDisplay, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock>
                                <Run x:Uid="Resource_WslEngine_007" i18n:Localization.Uid="Resource_WslEngine_007" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Run Text="{x:Bind ViewModel.LatestWslVersionDisplay, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>

                        <!-- Up to date  -->
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8"
                            Visibility="{x:Bind ViewModel.IsUpToDate, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <FontIcon
                                FontSize="16"
                                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                Glyph="&#xE73E;" />
                            <TextBlock x:Uid="Resource_WslEngine_008" i18n:Localization.Uid="Resource_WslEngine_008"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                        </StackPanel>

                        <!-- Update available  -->
                        <InfoBar x:Uid="Resource_WslEngine_Extra1" i18n:Localization.Uid="Resource_WslEngine_Extra1"
                            IsClosable="False"
                            IsOpen="{x:Bind ViewModel.UpdateAvailable, Mode=OneWay}"
                            Message="{x:Bind ViewModel.UpdateMessageDisplay, Mode=OneWay}"
                            Severity="Informational">
                            <InfoBar.ActionButton>
                                <Button x:Uid="Resource_WslEngine_009" i18n:Localization.Uid="Resource_WslEngine_009"

                                    Command="{x:Bind ViewModel.UpdateWslCommand}"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.BeforeUpdateNote, Converter={StaticResource UiTextConverter}}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="14" Glyph="&#xEA18;" />
                                        <TextBlock x:Uid="Resource_WslEngine_010" i18n:Localization.Uid="Resource_WslEngine_010" />
                                    </StackPanel>
                                </Button>
                            </InfoBar.ActionButton>
                        </InfoBar>

                        <!-- Administrator prompt guidance while the WSL update runs  -->
                        <InfoBar
                            Title="{x:Bind ViewModel.ElevationTitle, Mode=OneWay, Converter={StaticResource UiTextConverter}}"
                            IsClosable="False"
                            IsOpen="{x:Bind ViewModel.IsUpdatingWsl, Mode=OneWay}"
                            Message="{x:Bind ViewModel.ElevationGuidance, Converter={StaticResource UiTextConverter}}"
                            Severity="Warning" />

                        <!-- Check failed  -->
                        <InfoBar x:Uid="Resource_WslEngine_Extra2" i18n:Localization.Uid="Resource_WslEngine_Extra2"
                            IsClosable="False"
                            IsOpen="{x:Bind ViewModel.UpdateCheckFailed, Mode=OneWay}"
                            Message="{x:Bind ViewModel.UpdateCheckFailedMessageDisplay, Mode=OneWay}"
                            Severity="Warning" />

                        <ToggleSwitch x:Uid="Resource_WslEngine_011" i18n:Localization.Uid="Resource_WslEngine_011"
                            IsOn="{x:Bind ViewModel.IncludePreRelease, Mode=TwoWay}"
>
                            <ToggleSwitch.Header>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock x:Uid="Resource_WslEngine_012" i18n:Localization.Uid="Resource_WslEngine_012" VerticalAlignment="Center" />
                                    <controls:InfoTip
                                        Title="{x:Bind helpers:FlagHelp.WslPreRelease.Title}"
                                        Flag="{x:Bind helpers:FlagHelp.WslPreRelease.Flag}"
                                        Text="{x:Bind helpers:FlagHelp.WslPreRelease.Text}" />
                                </StackPanel>
                            </ToggleSwitch.Header>
                        </ToggleSwitch>
                        <TextBlock x:Uid="Resource_WslEngine_013" i18n:Localization.Uid="Resource_WslEngine_013"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"

                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Engine status banner  -->
                <Border Style="{StaticResource StatCard}">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Ellipse
                                Width="12"
                                Height="12"
                                VerticalAlignment="Center"
                                Fill="{x:Bind ViewModel.EngineStatusBrush, Mode=OneWay}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Text="{x:Bind ViewModel.EngineStatusTextDisplay, Mode=OneWay}" />
                        </StackPanel>
                        <TextBlock
                            FontFamily="Consolas"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind ViewModel.EngineVersionDisplay, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Container storage  -->
                <Border Style="{StaticResource StatCard}">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                FontSize="16"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xEDA2;" />
                            <TextBlock x:Uid="Resource_WslEngine_014" i18n:Localization.Uid="Resource_WslEngine_014" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock>
                            <Run x:Uid="Resource_WslEngine_015" i18n:Localization.Uid="Resource_WslEngine_015" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Run Text="{x:Bind ViewModel.ContainerStorageLocationDisplay, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock>
                            <Run x:Uid="Resource_WslEngine_016" i18n:Localization.Uid="Resource_WslEngine_016" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Run Text="{x:Bind ViewModel.ContainerStorageSizeDisplay, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock x:Uid="Resource_WslEngine_017" i18n:Localization.Uid="Resource_WslEngine_017"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"

                            TextWrapping="Wrap" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                            Text="{x:Bind ViewModel.StorageEditNoteDisplay, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Uid="Resource_WslEngine_018" i18n:Localization.Uid="Resource_WslEngine_018"
                                Click="ChangeStorageLocation_Click"

                                IsEnabled="{x:Bind ViewModel.StorageEditAvailable, Mode=OneWay}">
                                <ToolTipService.ToolTip>
                                    <ToolTip>
                                        <StackPanel MaxWidth="380" Spacing="4">
                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind helpers:FlagHelp.StorageChangeLocation.Title}" />
                                            <TextBlock FontFamily="Consolas" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind helpers:FlagHelp.StorageChangeLocation.Flag}" />
                                            <TextBlock Text="{x:Bind helpers:FlagHelp.StorageChangeLocation.Text}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </ToolTip>
                                </ToolTipService.ToolTip>
                            </Button>
                            <Button x:Uid="Resource_WslEngine_019" i18n:Localization.Uid="Resource_WslEngine_019"
                                Command="{x:Bind ViewModel.ResetStorageLocationCommand}"

                                IsEnabled="{x:Bind ViewModel.StorageEditAvailable, Mode=OneWay}" />
                        </StackPanel>
                        <TextBlock x:Uid="Resource_WslEngine_020" i18n:Localization.Uid="Resource_WslEngine_020"
                            Margin="0,6,0,0"
                            FontWeight="SemiBold" />
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock>
                                    <Run x:Uid="Resource_WslEngine_021" i18n:Localization.Uid="Resource_WslEngine_021" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Run Text="{x:Bind ViewModel.SessionCpuCountDisplay, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock>
                                    <Run x:Uid="Resource_WslEngine_022" i18n:Localization.Uid="Resource_WslEngine_022" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Run Text="{x:Bind ViewModel.SessionMemorySizeDisplay, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock>
                                    <Run x:Uid="Resource_WslEngine_023" i18n:Localization.Uid="Resource_WslEngine_023" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Run Text="{x:Bind ViewModel.SessionMaxStorageSizeDisplay, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock>
                                    <Run x:Uid="Resource_WslEngine_024" i18n:Localization.Uid="Resource_WslEngine_024" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Run Text="{x:Bind ViewModel.SessionDefaultBindingAddressDisplay, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock>
                                    <Run x:Uid="Resource_WslEngine_025" i18n:Localization.Uid="Resource_WslEngine_025" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Run Text="{x:Bind ViewModel.CredentialStoreDisplay, Mode=OneWay}" />
                                </TextBlock>
                                <!-- The one way to change these: opens wslc's own settings.yaml in the default editor.  -->
                                <Button x:Uid="Resource_WslEngine_026" i18n:Localization.Uid="Resource_WslEngine_026"
                                    HorizontalAlignment="Left"
                                    Command="{x:Bind ViewModel.EditSettingsFileCommand}"

                                    ToolTipService.ToolTip="{x:Bind ViewModel.SettingsFilePathDisplay, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Platform + resources  -->
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- WSL platform  -->
                    <Border Grid.Column="0" Style="{StaticResource StatCard}">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    FontSize="16"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Glyph="&#xE977;" />
                                <TextBlock x:Uid="Resource_WslEngine_027" i18n:Localization.Uid="Resource_WslEngine_027" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock>
                                <Run x:Uid="Resource_WslEngine_028" i18n:Localization.Uid="Resource_WslEngine_028" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Run Text="{x:Bind ViewModel.WslVersionDisplay, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock>
                                <Run x:Uid="Resource_WslEngine_029" i18n:Localization.Uid="Resource_WslEngine_029" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Run Text="{x:Bind ViewModel.KernelVersionDisplay, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Resource limits  -->
                    <Border Grid.Column="1" Style="{StaticResource StatCard}">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    FontSize="16"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Glyph="&#xE950;" />
                                <TextBlock x:Uid="Resource_WslEngine_030" i18n:Localization.Uid="Resource_WslEngine_030" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock>
                                <Run x:Uid="Resource_WslEngine_031" i18n:Localization.Uid="Resource_WslEngine_031" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Run Text="{x:Bind ViewModel.MemoryLimit, Mode=OneWay, Converter={StaticResource UiTextConverter}}" />
                            </TextBlock>
                            <TextBlock>
                                <Run x:Uid="Resource_WslEngine_032" i18n:Localization.Uid="Resource_WslEngine_032" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Run Text="{x:Bind ViewModel.ProcessorLimit, Mode=OneWay, Converter={StaticResource UiTextConverter}}" />
                            </TextBlock>
                            <TextBlock>
                                <Run x:Uid="Resource_WslEngine_033" i18n:Localization.Uid="Resource_WslEngine_033" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Run Text="{x:Bind ViewModel.SwapLimit, Mode=OneWay, Converter={StaticResource UiTextConverter}}" />
                            </TextBlock>
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="{x:Bind ViewModel.ConfigNoteDisplay, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Distros  -->
                <TextBlock x:Uid="Resource_WslEngine_034" i18n:Localization.Uid="Resource_WslEngine_034"
                    Margin="2,4,0,0"
                    Style="{ThemeResource BodyStrongTextBlockStyle}" />
                <Border Style="{StaticResource ListCard}">
                    <StackPanel Spacing="2">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Distros, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:WslDistroStatus">
                                    <Grid Padding="0,6" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="160" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            FontFamily="Consolas"
                                            FontSize="13"
                                            Text="{x:Bind Name}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind State, Converter={StaticResource UiTextConverter}}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Text="{x:Bind Version}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel
                            Margin="0,8"
                            HorizontalAlignment="Center"
                            Spacing="4"
                            Visibility="{x:Bind ViewModel.NoDistrosInstalled, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <TextBlock x:Uid="Resource_WslEngine_035" i18n:Localization.Uid="Resource_WslEngine_035"
                                HorizontalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Uid="Resource_WslEngine_036" i18n:Localization.Uid="Resource_WslEngine_036"
                                MaxWidth="560"
                                HorizontalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"

                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                            <HyperlinkButton x:Uid="Resource_WslEngine_037" i18n:Localization.Uid="Resource_WslEngine_037"
                                HorizontalAlignment="Center"

                                NavigateUri="https://learn.microsoft.com/windows/wsl/install" />
                        </StackPanel>
                        <TextBlock x:Uid="Resource_WslEngine_038" i18n:Localization.Uid="Resource_WslEngine_038"
                            Margin="0,8"
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"

                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.DistroListUnavailable, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <ProgressBar
            VerticalAlignment="Top"
            IsIndeterminate="True"
            Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
    </Grid>
</Page>
