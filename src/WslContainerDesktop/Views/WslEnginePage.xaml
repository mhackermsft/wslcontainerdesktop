<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WslContainerDesktop.Views.WslEnginePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:WslContainerDesktop.Helpers"
    xmlns:controls="using:WslContainerDesktop.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:WslContainerDesktop.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WslContainerDesktop.Models"
    x:Name="Root"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:EmptyToVisibilityConverter x:Key="EmptyToVis" />
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="18,16" />
        </Style>
        <Style x:Key="ListCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,10" />
        </Style>
    </Page.Resources>

    <Grid>
        <ScrollViewer>
            <StackPanel Margin="24,16,24,24" Spacing="16">

                <!--  Header  -->
                <StackPanel Spacing="2">
                    <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="WSL engine" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
                </StackPanel>

                <!--  Actions  -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.RestartSessionCommand}" Style="{ThemeResource AccentButtonStyle}">
                        <ToolTipService.ToolTip>
                            <ToolTip>
                                <StackPanel MaxWidth="380" Spacing="4">
                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind helpers:FlagHelp.RestartWslSession.Title}" />
                                    <TextBlock FontFamily="Consolas" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind helpers:FlagHelp.RestartWslSession.Flag}" />
                                    <TextBlock Text="{x:Bind helpers:FlagHelp.RestartWslSession.Text}" TextWrapping="Wrap" />
                                </StackPanel>
                            </ToolTip>
                        </ToolTipService.ToolTip>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE72C;" />
                            <TextBlock Text="Restart WSL session" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.ShutdownWslCommand}">
                        <ToolTipService.ToolTip>
                            <ToolTip>
                                <StackPanel MaxWidth="380" Spacing="4">
                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind helpers:FlagHelp.ShutdownWsl.Title}" />
                                    <TextBlock FontFamily="Consolas" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind helpers:FlagHelp.ShutdownWsl.Flag}" />
                                    <TextBlock Text="{x:Bind helpers:FlagHelp.ShutdownWsl.Text}" TextWrapping="Wrap" />
                                </StackPanel>
                            </ToolTip>
                        </ToolTipService.ToolTip>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE7E8;" />
                            <TextBlock Text="Shut down WSL" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.RefreshCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE72C;" />
                            <TextBlock Text="Refresh" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!--  WSL updates  -->
                <Border Style="{StaticResource StatCard}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                FontSize="16"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE895;" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="WSL updates" />
                            <ProgressRing
                                Width="16"
                                Height="16"
                                VerticalAlignment="Center"
                                IsActive="{x:Bind ViewModel.IsCheckingUpdate, Mode=OneWay}" />
                        </StackPanel>

                        <!--  Installed + latest available versions (latest depends on the channel toggle)  -->
                        <StackPanel Spacing="4">
                            <TextBlock>
                                <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Installed version:" />
                                <Run Text="{x:Bind ViewModel.WslVersion, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock>
                                <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Latest available:" />
                                <Run Text="{x:Bind ViewModel.LatestWslVersion, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>

                        <!--  Up to date  -->
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8"
                            Visibility="{x:Bind ViewModel.IsUpToDate, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <FontIcon
                                FontSize="16"
                                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                Glyph="&#xE73E;" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                Text="WSL is up to date." />
                        </StackPanel>

                        <!--  Update available  -->
                        <InfoBar
                            IsClosable="False"
                            IsOpen="{x:Bind ViewModel.UpdateAvailable, Mode=OneWay}"
                            Message="{x:Bind ViewModel.UpdateMessage, Mode=OneWay}"
                            Severity="Informational"
                            Title="Update available">
                            <InfoBar.ActionButton>
                                <Button
                                    Command="{x:Bind ViewModel.UpdateWslCommand}"
                                    Content="Update now"
                                    Style="{ThemeResource AccentButtonStyle}" />
                            </InfoBar.ActionButton>
                        </InfoBar>

                        <!--  Check failed  -->
                        <InfoBar
                            IsClosable="False"
                            IsOpen="{x:Bind ViewModel.UpdateCheckFailed, Mode=OneWay}"
                            Message="{x:Bind ViewModel.UpdateCheckFailedMessage, Mode=OneWay}"
                            Severity="Warning"
                            Title="Couldn't check for updates" />

                        <ToggleSwitch
                            IsOn="{x:Bind ViewModel.IncludePreRelease, Mode=TwoWay}"
                            OffContent="Stable channel (recommended)"
                            OnContent="Early-access builds included">
                            <ToggleSwitch.Header>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Include early-access (pre-release) WSL builds" VerticalAlignment="Center" />
                                    <controls:InfoTip
                                        Title="{x:Bind helpers:FlagHelp.WslPreRelease.Title}"
                                        Flag="{x:Bind helpers:FlagHelp.WslPreRelease.Flag}"
                                        Text="{x:Bind helpers:FlagHelp.WslPreRelease.Text}" />
                                </StackPanel>
                            </ToggleSwitch.Header>
                        </ToggleSwitch>
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="WSL containers are generally available on the stable channel (WSL 3.0.1 or later). Turn this on only to try optional early-access builds, which may be less stable."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!--  Engine status banner  -->
                <Border Style="{StaticResource StatCard}">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Ellipse
                                Width="12"
                                Height="12"
                                VerticalAlignment="Center"
                                Fill="{x:Bind ViewModel.EngineStatusBrush, Mode=OneWay}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Text="{x:Bind ViewModel.EngineStatusText, Mode=OneWay}" />
                        </StackPanel>
                        <TextBlock
                            FontFamily="Consolas"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind ViewModel.EngineVersion, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!--  Container storage  -->
                <Border Style="{StaticResource StatCard}">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                FontSize="16"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xEDA2;" />
                            <TextBlock FontWeight="SemiBold" Text="Container storage" />
                        </StackPanel>
                        <TextBlock>
                            <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Location:" />
                            <Run Text="{x:Bind ViewModel.ContainerStorageLocation, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock>
                            <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Session disk size:" />
                            <Run Text="{x:Bind ViewModel.ContainerStorageSize, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="Changing the location only affects future session storage. Existing images, containers and volumes are not migrated."
                            TextWrapping="Wrap" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                            Text="{x:Bind ViewModel.StorageEditNote, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                Click="ChangeStorageLocation_Click"
                                Content="Change location…"
                                IsEnabled="{x:Bind ViewModel.StorageEditAvailable, Mode=OneWay}">
                                <ToolTipService.ToolTip>
                                    <ToolTip>
                                        <StackPanel MaxWidth="380" Spacing="4">
                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind helpers:FlagHelp.StorageChangeLocation.Title}" />
                                            <TextBlock FontFamily="Consolas" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind helpers:FlagHelp.StorageChangeLocation.Flag}" />
                                            <TextBlock Text="{x:Bind helpers:FlagHelp.StorageChangeLocation.Text}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </ToolTip>
                                </ToolTipService.ToolTip>
                            </Button>
                            <Button
                                Command="{x:Bind ViewModel.ResetStorageLocationCommand}"
                                Content="Reset to default"
                                IsEnabled="{x:Bind ViewModel.StorageEditAvailable, Mode=OneWay}" />
                        </StackPanel>
                        <TextBlock
                            Margin="0,6,0,0"
                            FontWeight="SemiBold"
                            Text="Container session settings" />
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock>
                                    <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="CPU count:" />
                                    <Run Text="{x:Bind ViewModel.SessionCpuCount, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock>
                                    <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Memory:" />
                                    <Run Text="{x:Bind ViewModel.SessionMemorySize, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock>
                                    <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Max storage:" />
                                    <Run Text="{x:Bind ViewModel.SessionMaxStorageSize, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock>
                                    <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Default bind address:" />
                                    <Run Text="{x:Bind ViewModel.SessionDefaultBindingAddress, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock>
                                    <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Credential store:" />
                                    <Run Text="{x:Bind ViewModel.CredentialStore, Mode=OneWay}" />
                                </TextBlock>
                                <!--  The one way to change these: opens wslc's own settings.yaml in the default editor.  -->
                                <Button
                                    HorizontalAlignment="Left"
                                    Command="{x:Bind ViewModel.EditSettingsFileCommand}"
                                    Content="Edit settings file"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.SettingsFilePath, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!--  Platform + resources  -->
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  WSL platform  -->
                    <Border Grid.Column="0" Style="{StaticResource StatCard}">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    FontSize="16"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Glyph="&#xE977;" />
                                <TextBlock FontWeight="SemiBold" Text="WSL platform" />
                            </StackPanel>
                            <TextBlock>
                                <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="WSL version:" />
                                <Run Text="{x:Bind ViewModel.WslVersion, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock>
                                <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Kernel:" />
                                <Run Text="{x:Bind ViewModel.KernelVersion, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!--  Resource limits  -->
                    <Border Grid.Column="1" Style="{StaticResource StatCard}">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    FontSize="16"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Glyph="&#xE950;" />
                                <TextBlock FontWeight="SemiBold" Text="Resource limits (.wslconfig)" />
                            </StackPanel>
                            <TextBlock>
                                <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Memory:" />
                                <Run Text="{x:Bind ViewModel.MemoryLimit, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock>
                                <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Processors:" />
                                <Run Text="{x:Bind ViewModel.ProcessorLimit, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock>
                                <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Swap:" />
                                <Run Text="{x:Bind ViewModel.SwapLimit, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="{x:Bind ViewModel.ConfigNote, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!--  Distros  -->
                <TextBlock
                    Margin="2,4,0,0"
                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                    Text="Distributions" />
                <Border Style="{StaticResource ListCard}">
                    <StackPanel Spacing="2">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Distros, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:WslDistroStatus">
                                    <Grid Padding="0,6" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="160" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            FontFamily="Consolas"
                                            FontSize="13"
                                            Text="{x:Bind Name}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind State}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Text="{x:Bind Version}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock
                            Margin="0,8"
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="No distributions found."
                            Visibility="{x:Bind ViewModel.Distros.Count, Mode=OneWay, Converter={StaticResource EmptyToVis}}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <ProgressBar
            VerticalAlignment="Top"
            IsIndeterminate="True"
            Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
    </Grid>
</Page>
