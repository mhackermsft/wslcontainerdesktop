<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WslContainerDesktop.Views.ImagesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i18n="using:WslContainerDesktop.Helpers"
    xmlns:converters="using:WslContainerDesktop.Helpers"
    xmlns:controls="using:WslContainerDesktop.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:WslContainerDesktop.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WslContainerDesktop.Models"
    x:Name="Root"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BytesToSizeConverter x:Key="BytesToSize" />
        <converters:RelativeTimeConverter x:Key="RelativeTime" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:EmptyToVisibilityConverter x:Key="EmptyToVis" />
        <converters:BoolToSelectionModeConverter x:Key="BoolToSelMode" />
    </Page.Resources>

    <Grid Margin="24,16,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock x:Uid="Resource_Images_001" i18n:Localization.Uid="Resource_Images_001" Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.StatusMessageDisplay, Mode=OneWay}" />
        </StackPanel>

        <!-- Actions wrap on narrow windows; Select and the view toggle stay pinned right.  -->
        <Grid
            Grid.Row="1"
            ColumnSpacing="12"
            Visibility="{x:Bind ViewModel.IsSelectionMode, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <converters:WrapPanel
                Grid.Column="0"
                HorizontalSpacing="8"
                VerticalSpacing="8">
            <Button Command="{x:Bind ViewModel.PullCommand}" Style="{ThemeResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE896;" />
                    <TextBlock x:Uid="Resource_Images_002" i18n:Localization.Uid="Resource_Images_002" />
                </StackPanel>
            </Button>
            <Button
                Command="{x:Bind ViewModel.BuildCommand}"
                IsEnabled="{x:Bind ViewModel.CanBuild, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind ViewModel.BuildPolicyMessageDisplay, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE9F9;" />
                    <TextBlock x:Uid="Resource_Images_003" i18n:Localization.Uid="Resource_Images_003" />
                </StackPanel>
            </Button>
            <DropDownButton x:Uid="Resource_Images_004" i18n:Localization.Uid="Resource_Images_004" >
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE8B5;" />
                    <TextBlock x:Uid="Resource_Images_005" i18n:Localization.Uid="Resource_Images_005" />
                </StackPanel>
                <DropDownButton.Flyout>
                    <!-- Each option says what it does and which action makes its file, because the two are easy to confuse.  -->
                    <Flyout x:Name="ImportFlyout" Placement="BottomEdgeAlignedLeft">
                        <!-- The default presenter caps width at 456px, which forced a horizontal scrollbar.  -->
                        <Flyout.FlyoutPresenterStyle>
                            <Style BasedOn="{StaticResource DefaultFlyoutPresenterStyle}" TargetType="FlyoutPresenter">
                                <Setter Property="MaxWidth" Value="520" />
                                <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
                                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                            </Style>
                        </Flyout.FlyoutPresenterStyle>
                        <StackPanel Width="440" Spacing="4">
                            <Button x:Uid="Resource_Images_006" i18n:Localization.Uid="Resource_Images_006"
                                Padding="12,10"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                AutomationProperties.AutomationId="RestoreSavedImages"

                                Background="Transparent"
                                BorderThickness="0"
                                Click="LoadImage_Click">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon VerticalAlignment="Top" Margin="0,3,0,0" FontSize="18" Glyph="&#xE777;" />
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock x:Uid="Resource_Images_007" i18n:Localization.Uid="Resource_Images_007" FontWeight="SemiBold" />
                                        <TextBlock x:Uid="Resource_Images_008" i18n:Localization.Uid="Resource_Images_008"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"

                                            TextWrapping="Wrap" />
                                        <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="12" TextWrapping="Wrap">
                                            <Run x:Uid="Resource_Images_009" i18n:Localization.Uid="Resource_Images_009" FontWeight="SemiBold" />
                                            <Run x:Uid="Resource_Images_010" i18n:Localization.Uid="Resource_Images_010" />
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <Button x:Uid="Resource_Images_011" i18n:Localization.Uid="Resource_Images_011"
                                Padding="12,10"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                AutomationProperties.AutomationId="CreateImageFromExport"

                                Background="Transparent"
                                BorderThickness="0"
                                Click="ImportImage_Click">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon VerticalAlignment="Top" Margin="0,3,0,0" FontSize="18" Glyph="&#xE8B7;" />
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock x:Uid="Resource_Images_012" i18n:Localization.Uid="Resource_Images_012" FontWeight="SemiBold" />
                                        <TextBlock x:Uid="Resource_Images_013" i18n:Localization.Uid="Resource_Images_013"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"

                                            TextWrapping="Wrap" />
                                        <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="12" TextWrapping="Wrap">
                                            <Run x:Uid="Resource_Images_014" i18n:Localization.Uid="Resource_Images_014" FontWeight="SemiBold" />
                                            <Run x:Uid="Resource_Images_015" i18n:Localization.Uid="Resource_Images_015" />
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Flyout>
                </DropDownButton.Flyout>
            </DropDownButton>
            <Button Command="{x:Bind ViewModel.RefreshCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                    <TextBlock x:Uid="Resource_Images_016" i18n:Localization.Uid="Resource_Images_016" />
                </StackPanel>
            </Button>
            <Button x:Uid="Resource_Images_017" i18n:Localization.Uid="Resource_Images_017" Command="{x:Bind ViewModel.CheckUpdatesCommand}" >
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE895;" />
                    <TextBlock x:Uid="Resource_Images_018" i18n:Localization.Uid="Resource_Images_018" />
                </StackPanel>
            </Button>
            <Button Command="{x:Bind ViewModel.PruneCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE74D;" />
                    <TextBlock x:Uid="Resource_Images_019" i18n:Localization.Uid="Resource_Images_019" />
                </StackPanel>
            </Button>
            </converters:WrapPanel>
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">
                <ToggleButton x:Uid="Resource_Images_020" i18n:Localization.Uid="Resource_Images_020" IsChecked="{x:Bind ViewModel.IsSelectionMode, Mode=TwoWay}" >
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE762;" />
                        <TextBlock x:Uid="Resource_Images_021" i18n:Localization.Uid="Resource_Images_021" />
                    </StackPanel>
                </ToggleButton>
            </StackPanel>
        </Grid>

        <!-- Bulk-action bar (shown while selecting)  -->
        <StackPanel
            Grid.Row="1"
            Orientation="Horizontal"
            Spacing="8"
            Visibility="{x:Bind ViewModel.IsSelectionMode, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <TextBlock
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Text="{x:Bind ViewModel.SelectionSummary, Mode=OneWay}" />
            <Button Click="BulkRemove_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE74D;" />
                    <TextBlock x:Uid="Resource_Images_022" i18n:Localization.Uid="Resource_Images_022" />
                </StackPanel>
            </Button>
            <Button Click="BulkSave_Click">
                <ToolTipService.ToolTip>
                    <ToolTip>
                        <StackPanel MaxWidth="380" Spacing="4">
                            <TextBlock FontWeight="SemiBold" Text="{x:Bind helpers:FlagHelp.ImageSave.Title}" />
                            <TextBlock FontFamily="Consolas" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind helpers:FlagHelp.ImageSave.Flag}" />
                            <TextBlock Text="{x:Bind helpers:FlagHelp.ImageSave.Text}" TextWrapping="Wrap" />
                        </StackPanel>
                    </ToolTip>
                </ToolTipService.ToolTip>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE74E;" />
                    <TextBlock x:Uid="Resource_Images_023" i18n:Localization.Uid="Resource_Images_023" />
                </StackPanel>
            </Button>
            <Button Click="BulkCancel_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE711;" />
                    <TextBlock x:Uid="Resource_Images_024" i18n:Localization.Uid="Resource_Images_024" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Table: column header (wide only) + list  -->
        <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="HeaderWide">
                        <VisualState.StateTriggers>
                            <converters:ControlSizeTrigger MinWidth="720" TargetElement="{Binding ElementName=Root}" />
                        </VisualState.StateTriggers>
                    </VisualState>
                    <VisualState x:Name="HeaderNarrow">
                        <VisualState.StateTriggers>
                            <converters:ControlSizeTrigger MaxWidth="720" TargetElement="{Binding ElementName=Root}" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="HeaderBorder.Visibility" Value="Collapsed" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

        <Border
            x:Name="HeaderBorder"
            Grid.Row="0"
            Padding="16,8,20,8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6,6,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.6*" MinWidth="150" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="92" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Uid="Resource_Images_025" i18n:Localization.Uid="Resource_Images_025" Grid.Column="0" Style="{ThemeResource CaptionTextBlockStyle}" />
                <TextBlock x:Uid="Resource_Images_026" i18n:Localization.Uid="Resource_Images_026" Grid.Column="1" Style="{ThemeResource CaptionTextBlockStyle}" />
                <TextBlock x:Uid="Resource_Images_027" i18n:Localization.Uid="Resource_Images_027" Grid.Column="2" Style="{ThemeResource CaptionTextBlockStyle}" />
                <TextBlock x:Uid="Resource_Images_028" i18n:Localization.Uid="Resource_Images_028" Grid.Column="3" Style="{ThemeResource CaptionTextBlockStyle}" />
                <TextBlock x:Uid="Resource_Images_029" i18n:Localization.Uid="Resource_Images_029" Grid.Column="4" Style="{ThemeResource CaptionTextBlockStyle}" />
                <TextBlock x:Uid="Resource_Images_030" i18n:Localization.Uid="Resource_Images_030"
                    Grid.Column="5"
                    HorizontalAlignment="Right"
                    Style="{ThemeResource CaptionTextBlockStyle}" />
            </Grid>
        </Border>

        <Border
            Grid.Row="1"
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="1,0,1,1"
            CornerRadius="0,0,6,6">
            <Grid>
                <ListView
                    x:Name="ImagesList"
                    Padding="0,4"
                    ItemsSource="{x:Bind ViewModel.Images, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}"
                    SelectionChanged="List_SelectionChanged"
                    SelectionMode="{x:Bind ViewModel.IsSelectionMode, Mode=OneWay, Converter={StaticResource BoolToSelMode}}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="16,6,20,6" />
                            <Setter Property="MinHeight" Value="48" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:ImageInfo">
                            <Grid x:Name="RowRoot">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup>
                                        <VisualState x:Name="RowWide">
                                            <VisualState.StateTriggers>
                                                <converters:ControlSizeTrigger MinWidth="680" TargetElement="{Binding ElementName=RowRoot}" />
                                            </VisualState.StateTriggers>
                                        </VisualState>
                                        <VisualState x:Name="RowNarrow">
                                            <VisualState.StateTriggers>
                                                <converters:ControlSizeTrigger MaxWidth="680" TargetElement="{Binding ElementName=RowRoot}" />
                                            </VisualState.StateTriggers>
                                            <VisualState.Setters>
                                                <Setter Target="WideGrid.Visibility" Value="Collapsed" />
                                                <Setter Target="NarrowPanel.Visibility" Value="Visible" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <Grid x:Name="WideGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.6*" MinWidth="150" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="92" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="{x:Bind Repository}"
                                            TextTrimming="CharacterEllipsis" />
                                        <!-- An untagged image reads "<none>", which says nothing about why it is still here.  -->
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind UsedByCaption, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{x:Bind UsedByCaption, Mode=OneWay}"
                                            Visibility="{x:Bind IsInUse, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                                    </StackPanel>
                                    <!-- A real button: the badge looks actionable, so clicking it pulls the update.  -->
                                    <Button x:Uid="Resource_Images_031" i18n:Localization.Uid="Resource_Images_031"
                                        Grid.Column="1"
                                        MinWidth="0"
                                        MinHeight="0"
                                        Padding="7,1"
                                        VerticalAlignment="Center"

                                        Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                        BorderThickness="0"
                                        Click="PullUpdateMenu_Click"
                                        CornerRadius="9"
                                        ToolTipService.ToolTip="{x:Bind UpdateTooltip, Mode=OneWay}"
                                        Visibility="{x:Bind UpdateAvailable, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon FontSize="11" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Glyph="&#xE896;" />
                                            <TextBlock x:Uid="Resource_Images_032" i18n:Localization.Uid="Resource_Images_032"
                                                FontSize="11"
                                                Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                        </StackPanel>
                                    </Button>
                                    <ProgressRing
                                        Grid.Column="2"
                                        Width="14"
                                        Height="14"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        IsActive="{x:Bind IsCheckingUpdate, Mode=OneWay}"
                                        Visibility="{x:Bind IsCheckingUpdate, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind Tag}" />
                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    Text="{x:Bind ShortId}" />
                                <TextBlock
                                    Grid.Column="3"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind Size, Converter={StaticResource BytesToSize}}" />
                                <TextBlock
                                    Grid.Column="4"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind CreatedUtc, Converter={StaticResource RelativeTime}}" />

                                <StackPanel
                                    Grid.Column="5"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="4">
                                    <Button x:Uid="Resource_Images_033" i18n:Localization.Uid="Resource_Images_033"
                                        Padding="7,5"

                                        Click="RunButton_Click">
                                        <FontIcon FontSize="14" Glyph="&#xE768;" />
                                    </Button>
                                    <Button x:Uid="Resource_Images_034" i18n:Localization.Uid="Resource_Images_034" Padding="7,5" >
                                        <FontIcon FontSize="14" Glyph="&#xE712;" />
                                        <Button.Flyout>
                                            <MenuFlyout Opening="MoreFlyout_Opening">
                                                <MenuFlyoutItem x:Uid="Resource_Images_035" i18n:Localization.Uid="Resource_Images_035" Click="PullUpdateMenu_Click" >
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE896;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSubItem x:Uid="Resource_Images_036" i18n:Localization.Uid="Resource_Images_036" >
                                                    <MenuFlyoutSubItem.Icon>
                                                        <FontIcon Glyph="&#xE768;" />
                                                    </MenuFlyoutSubItem.Icon>
                                                </MenuFlyoutSubItem>
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem x:Uid="Resource_Images_037" i18n:Localization.Uid="Resource_Images_037" Click="TagMenu_Click" />
                                                <MenuFlyoutItem x:Uid="Resource_Images_038" i18n:Localization.Uid="Resource_Images_038" Click="PushMenu_Click" >
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE898;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem x:Uid="Resource_Images_039" i18n:Localization.Uid="Resource_Images_039" Click="SaveImageMenu_Click" ToolTipService.ToolTip="{x:Bind helpers:FlagHelp.ImageSave.Text}" />
                                                <MenuFlyoutItem x:Uid="Resource_Images_040" i18n:Localization.Uid="Resource_Images_040" Click="CopyDigestMenu_Click" />
                                                <MenuFlyoutItem x:Uid="Resource_Images_041" i18n:Localization.Uid="Resource_Images_041" Click="InspectMenu_Click" />
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem x:Uid="Resource_Images_042" i18n:Localization.Uid="Resource_Images_042" Click="RemoveMenu_Click" >
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE74D;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                                </Grid>

                                <!-- Narrow: stacked card layout (shown when the row is too narrow for columns)  -->
                                <StackPanel x:Name="NarrowPanel" Spacing="8" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xEB9F;" />
                                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{x:Bind Repository}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <Grid ColumnSpacing="8" RowSpacing="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="76" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock x:Uid="Resource_Images_043" i18n:Localization.Uid="Resource_Images_043" Grid.Row="0" Grid.Column="0" Style="{ThemeResource CaptionTextBlockStyle}" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Tag}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Uid="Resource_Images_044" i18n:Localization.Uid="Resource_Images_044" Grid.Row="1" Grid.Column="0" Style="{ThemeResource CaptionTextBlockStyle}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" FontFamily="Consolas" FontSize="12" Text="{x:Bind ShortId}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Uid="Resource_Images_045" i18n:Localization.Uid="Resource_Images_045" Grid.Row="2" Grid.Column="0" Style="{ThemeResource CaptionTextBlockStyle}" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind Size, Converter={StaticResource BytesToSize}}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Uid="Resource_Images_046" i18n:Localization.Uid="Resource_Images_046" Grid.Row="3" Grid.Column="0" Style="{ThemeResource CaptionTextBlockStyle}" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind CreatedUtc, Converter={StaticResource RelativeTime}}" />
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Button x:Uid="Resource_Images_047" i18n:Localization.Uid="Resource_Images_047" Padding="7,5" Click="RunButton_Click" >
                                            <FontIcon FontSize="14" Glyph="&#xE768;" />
                                        </Button>
                                        <Button x:Uid="Resource_Images_048" i18n:Localization.Uid="Resource_Images_048" Padding="7,5" >
                                            <FontIcon FontSize="14" Glyph="&#xE712;" />
                                            <Button.Flyout>
                                                <MenuFlyout Opening="MoreFlyout_Opening">
                                                    <MenuFlyoutItem x:Uid="Resource_Images_049" i18n:Localization.Uid="Resource_Images_049" Click="PullUpdateMenu_Click" >
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE896;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutSubItem x:Uid="Resource_Images_050" i18n:Localization.Uid="Resource_Images_050" >
                                                        <MenuFlyoutSubItem.Icon>
                                                            <FontIcon Glyph="&#xE768;" />
                                                        </MenuFlyoutSubItem.Icon>
                                                    </MenuFlyoutSubItem>
                                                    <MenuFlyoutSeparator />
                                                    <MenuFlyoutItem x:Uid="Resource_Images_051" i18n:Localization.Uid="Resource_Images_051" Click="TagMenu_Click" />
                                                    <MenuFlyoutItem x:Uid="Resource_Images_052" i18n:Localization.Uid="Resource_Images_052" Click="PushMenu_Click" >
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE898;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem x:Uid="Resource_Images_053" i18n:Localization.Uid="Resource_Images_053" Click="SaveImageMenu_Click" ToolTipService.ToolTip="{x:Bind helpers:FlagHelp.ImageSave.Text}" />
                                                    <MenuFlyoutItem x:Uid="Resource_Images_054" i18n:Localization.Uid="Resource_Images_054" Click="CopyDigestMenu_Click" />
                                                    <MenuFlyoutItem x:Uid="Resource_Images_055" i18n:Localization.Uid="Resource_Images_055" Click="InspectMenu_Click" />
                                                    <MenuFlyoutSeparator />
                                                    <MenuFlyoutItem x:Uid="Resource_Images_056" i18n:Localization.Uid="Resource_Images_056" Click="RemoveMenu_Click" >
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE74D;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel
                    Margin="0,60,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.Images.Count, Mode=OneWay, Converter={StaticResource EmptyToVis}}">
                    <FontIcon
                        HorizontalAlignment="Center"
                        FontSize="40"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Glyph="&#xEB9F;" />
                    <TextBlock x:Uid="Resource_Images_057" i18n:Localization.Uid="Resource_Images_057"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <ProgressBar
                    VerticalAlignment="Top"
                    IsIndeterminate="True"
                    Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </Border>
        </Grid>
    </Grid>
</Page>
