<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WslContainerDesktop.Views.NetworksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i18n="using:WslContainerDesktop.Helpers"
    xmlns:converters="using:WslContainerDesktop.Helpers"
    xmlns:controls="using:WslContainerDesktop.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WslContainerDesktop.Models"
    x:Name="Root"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:EmptyToVisibilityConverter x:Key="EmptyToVis" />
        <converters:BoolToSelectionModeConverter x:Key="BoolToSelMode" />
    </Page.Resources>

    <Grid Margin="24,16,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock x:Uid="Resource_Networks_001" i18n:Localization.Uid="Resource_Networks_001" Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.StatusMessageDisplay, Mode=OneWay}" />
            <TextBlock Foreground="{ThemeResource SystemFillColorCautionBrush}"
                Text="{x:Bind ViewModel.CombinedWarning, Mode=OneWay}" TextWrapping="Wrap" />
            <TextBlock x:Uid="ResourceSessionWakeNotice" i18n:Localization.Uid="ResourceSessionWakeNotice"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            <TextBlock Text="{x:Bind ViewModel.ManagementDestination, Mode=OneWay}" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
        <converters:WrapPanel
            Grid.Column="0"
            HorizontalSpacing="8"
            VerticalSpacing="8"
            Visibility="{x:Bind ViewModel.IsSelectionMode, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
            <Button Command="{x:Bind ViewModel.CreateCommand}" Style="{ThemeResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                    <TextBlock x:Uid="Resource_Networks_002" i18n:Localization.Uid="Resource_Networks_002" />
                </StackPanel>
            </Button>
            <Button Command="{x:Bind ViewModel.RefreshCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                    <TextBlock x:Uid="Resource_Networks_003" i18n:Localization.Uid="Resource_Networks_003" />
                </StackPanel>
            </Button>
            <Button Command="{x:Bind ViewModel.PruneCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE74D;" />
                    <TextBlock x:Uid="Resource_Networks_004" i18n:Localization.Uid="Resource_Networks_004" />
                </StackPanel>
            </Button>
            <ToggleButton x:Uid="Resource_Networks_005" i18n:Localization.Uid="Resource_Networks_005" IsChecked="{x:Bind ViewModel.IsSelectionMode, Mode=TwoWay}" >
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE762;" />
                    <TextBlock x:Uid="Resource_Networks_006" i18n:Localization.Uid="Resource_Networks_006" />
                </StackPanel>
            </ToggleButton>
        </converters:WrapPanel>

        <!-- Bulk-action bar (shown while selecting)  -->
        <converters:WrapPanel
            Grid.Column="0"
            HorizontalSpacing="8"
            VerticalSpacing="8"
            Visibility="{x:Bind ViewModel.IsSelectionMode, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <TextBlock
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Text="{x:Bind ViewModel.SelectionSummary, Mode=OneWay}" />
            <Button Click="BulkRemove_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE74D;" />
                    <TextBlock x:Uid="Resource_Networks_007" i18n:Localization.Uid="Resource_Networks_007" />
                </StackPanel>
            </Button>
            <Button Click="BulkCancel_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE711;" />
                    <TextBlock x:Uid="Resource_Networks_008" i18n:Localization.Uid="Resource_Networks_008" />
                </StackPanel>
            </Button>
        </converters:WrapPanel>
        <controls:ResourceGridToolbar Grid.Column="1" VerticalAlignment="Top"
            State="{x:Bind ViewModel.Grid, Mode=OneWay}" />
        </Grid>

        <!-- Table: column header (wide only) + list  -->
        <Grid x:Name="TableRoot" Grid.Row="2" SizeChanged="TableRoot_SizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

        <Border
            x:Name="HeaderBorder"
            Grid.Row="0"
            Padding="12,8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6,6,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="100" />
                    <ColumnDefinition Width="*" MinWidth="140" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" MinWidth="120" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>
                <controls:ResourceSortHeader Grid.Column="0" State="{x:Bind ViewModel.Grid}" SortKey="session"><controls:ResourceSortHeader.Header><TextBlock x:Uid="ResourceSessionColumn" i18n:Localization.Uid="ResourceSessionColumn" Style="{ThemeResource CaptionTextBlockStyle}" /></controls:ResourceSortHeader.Header></controls:ResourceSortHeader>
                <controls:ResourceSortHeader Grid.Column="1" State="{x:Bind ViewModel.Grid}" SortKey="name"><controls:ResourceSortHeader.Header><TextBlock x:Uid="Resource_Networks_009" i18n:Localization.Uid="Resource_Networks_009" Style="{ThemeResource CaptionTextBlockStyle}" /></controls:ResourceSortHeader.Header></controls:ResourceSortHeader>
                <controls:ResourceSortHeader Grid.Column="2" State="{x:Bind ViewModel.Grid}" SortKey="driver"><controls:ResourceSortHeader.Header><TextBlock x:Uid="Resource_Networks_010" i18n:Localization.Uid="Resource_Networks_010" Style="{ThemeResource CaptionTextBlockStyle}" /></controls:ResourceSortHeader.Header></controls:ResourceSortHeader>
                <controls:ResourceSortHeader Grid.Column="3" State="{x:Bind ViewModel.Grid}" SortKey="usedby"><controls:ResourceSortHeader.Header><TextBlock x:Uid="Resource_Networks_011" i18n:Localization.Uid="Resource_Networks_011" Style="{ThemeResource CaptionTextBlockStyle}" /></controls:ResourceSortHeader.Header></controls:ResourceSortHeader>
                <controls:ResourceSortHeader Grid.Column="4" State="{x:Bind ViewModel.Grid}" SortKey="id"><controls:ResourceSortHeader.Header><TextBlock x:Uid="ResourceGrid_IdHeader" i18n:Localization.Uid="ResourceGrid_IdHeader" Style="{ThemeResource CaptionTextBlockStyle}" /></controls:ResourceSortHeader.Header></controls:ResourceSortHeader>
                <TextBlock x:Uid="Resource_Networks_012" i18n:Localization.Uid="Resource_Networks_012"
                    Grid.Column="5"
                    HorizontalAlignment="Right"
                    Style="{ThemeResource CaptionTextBlockStyle}" />
            </Grid>
        </Border>

        <Border
            Grid.Row="1"
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="1,0,1,1"
            CornerRadius="0,0,6,6">
            <Grid>
                <ListView
                    x:Name="NetworksList"
                    Padding="0,4"
                    ItemsSource="{x:Bind ViewModel.Grid.Items, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}"
                    SelectionChanged="List_SelectionChanged"
                    SelectionMode="{x:Bind ViewModel.IsSelectionMode, Mode=OneWay, Converter={StaticResource BoolToSelMode}}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="12,6" />
                            <Setter Property="MinHeight" Value="46" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:NetworkInfo">
                            <Grid x:Name="RowRoot" SizeChanged="RowRoot_SizeChanged">
                                <Grid x:Name="WideGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="100" />
                                    <ColumnDefinition Width="*" MinWidth="140" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" MinWidth="120" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{x:Bind SessionName}"
                                    TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind SessionName}" />
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="10">
                                    <FontIcon
                                        FontSize="16"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Glyph="&#xE968;" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind Name}"
                                        TextTrimming="CharacterEllipsis" />
                                    <Border x:Uid="Resource_Networks_013" i18n:Localization.Uid="Resource_Networks_013"
                                        Padding="8,2"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="10"

                                        Visibility="{x:Bind IsBuiltIn, Converter={StaticResource BoolToVis}}">
                                        <TextBlock x:Uid="Resource_Networks_014" i18n:Localization.Uid="Resource_Networks_014"
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind DriverDisplay}" />
                                <TextBlock
                                    Grid.Column="3"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind UsedByDisplay, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{x:Bind UsedByTooltip, Mode=OneWay}" />
                                <TextBlock
                                    Grid.Column="4"
                                    VerticalAlignment="Center"
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ShortId, Mode=OneWay}" />

                                <StackPanel
                                    Grid.Column="5"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    Visibility="{x:Bind CanModify, Converter={StaticResource BoolToVis}}">
                                    <Button x:Uid="Resource_Networks_015" i18n:Localization.Uid="Resource_Networks_015"
                                        Padding="7,5"

                                        Click="InspectButton_Click">
                                        <FontIcon FontSize="14" Glyph="&#xE946;" />
                                    </Button>
                                    <Button x:Uid="Resource_Networks_016" i18n:Localization.Uid="Resource_Networks_016"
                                        Padding="7,5"

                                        Click="RemoveButton_Click">
                                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                    </Button>
                                </StackPanel>
                                </Grid>

                                <!-- Narrow: stacked card layout (shown when the row is too narrow for columns)  -->
                                <StackPanel x:Name="NarrowPanel" Spacing="8" Visibility="Collapsed">
                                    <TextBlock Text="{x:Bind SessionName}" TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{x:Bind SessionName}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE968;" />
                                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                        <Border x:Uid="Resource_Networks_017" i18n:Localization.Uid="Resource_Networks_017" Padding="8,2" VerticalAlignment="Center" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="10" Visibility="{x:Bind IsBuiltIn, Converter={StaticResource BoolToVis}}">
                                            <TextBlock x:Uid="Resource_Networks_018" i18n:Localization.Uid="Resource_Networks_018" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                    </StackPanel>

                                    <Grid ColumnSpacing="8" RowSpacing="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="76" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock x:Uid="Resource_Networks_019" i18n:Localization.Uid="Resource_Networks_019" Grid.Row="0" Grid.Column="0" Style="{ThemeResource CaptionTextBlockStyle}" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind DriverDisplay}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Uid="Resource_Networks_020" i18n:Localization.Uid="Resource_Networks_020" Grid.Row="1" Grid.Column="0" Style="{ThemeResource CaptionTextBlockStyle}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind UsedByDisplay, Mode=OneWay}" TextWrapping="Wrap" ToolTipService.ToolTip="{x:Bind UsedByTooltip, Mode=OneWay}" />
                                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{ThemeResource CaptionTextBlockStyle}" Text="ID" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" FontFamily="Consolas" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ShortId, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Spacing="4" Visibility="{x:Bind CanModify, Converter={StaticResource BoolToVis}}">
                                        <Button x:Uid="Resource_Networks_021" i18n:Localization.Uid="Resource_Networks_021" Padding="7,5" Click="InspectButton_Click" >
                                            <FontIcon FontSize="14" Glyph="&#xE946;" />
                                        </Button>
                                        <Button x:Uid="Resource_Networks_022" i18n:Localization.Uid="Resource_Networks_022" Padding="7,5" Click="RemoveButton_Click" >
                                            <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock x:Uid="ResourceGrid_NoMatches" i18n:Localization.Uid="ResourceGrid_NoMatches"
                    Margin="0,60,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsHitTestVisible="False"
                    Visibility="{x:Bind ViewModel.Grid.HasNoMatches, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

                <StackPanel
                    Margin="0,60,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <FontIcon
                        HorizontalAlignment="Center"
                        FontSize="40"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Glyph="&#xE968;" />
                    <TextBlock x:Uid="Resource_Networks_023" i18n:Localization.Uid="Resource_Networks_023"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <ProgressBar
                    VerticalAlignment="Top"
                    IsIndeterminate="True"
                    Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </Border>
        </Grid>
    </Grid>
</Page>
