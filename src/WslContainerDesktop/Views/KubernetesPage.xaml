                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </Grid>
                        </Border>

                        <!--  CronJobs  -->
                        <Border
                            Style="{StaticResource ListCard}"
                            Visibility="{x:Bind ViewModel.SelectedSection, Mode=OneWay, Converter={StaticResource SectionVis}, ConverterParameter=CronJobs}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Padding="16,10,12,10" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" MinWidth="150" />
                                            <ColumnDefinition Width="1.2*" MinWidth="100" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="118" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="Workload_KubernetesPage_078" i18n:Localization.Uid="Workload_KubernetesPage_078" Grid.Column="0" Style="{StaticResource ColHead}"  />
                                        <TextBlock x:Uid="Workload_KubernetesPage_079" i18n:Localization.Uid="Workload_KubernetesPage_079" Grid.Column="1" Style="{StaticResource ColHead}"  />
                                        <TextBlock x:Uid="Workload_KubernetesPage_080" i18n:Localization.Uid="Workload_KubernetesPage_080" Grid.Column="2" Style="{StaticResource ColHead}"  />
                                        <TextBlock x:Uid="Workload_KubernetesPage_081" i18n:Localization.Uid="Workload_KubernetesPage_081" Grid.Column="3" Style="{StaticResource ColHead}"  />
                                    </Grid>
                                </Border>
                                <Grid Grid.Row="1">
                                    <TextBlock x:Uid="Workload_KubernetesPage_082" i18n:Localization.Uid="Workload_KubernetesPage_082"
                                        Margin="16,14"
                                        VerticalAlignment="Top"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Visibility="{x:Bind ViewModel.CronJobs.Count, Mode=OneWay, Converter={StaticResource EmptyToVis}}" />
                                    <ListView
                                        Padding="0,4"
                                        IsItemClickEnabled="True"
                                        ItemClick="Resource_ItemClick"
                                        ItemContainerStyle="{StaticResource K8sRowStyle}"
                                        ItemsSource="{x:Bind ViewModel.CronJobs, Mode=OneWay}"
                                        SelectionMode="None">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="k8s:K8sCronJob">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2*" MinWidth="150" />
                                                        <ColumnDefinition Width="1.2*" MinWidth="100" />
                                                        <ColumnDefinition Width="140" />
                                                        <ColumnDefinition Width="60" />
                                                        <ColumnDefinition Width="118" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Namespace}" />
                                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" FontFamily="Consolas" FontSize="12" Text="{x:Bind Schedule}" />
                                                    <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="{x:Bind Active}" />
                                                    <StackPanel Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="2">
                                                        <Button x:Uid="Workload_KubernetesPage_083" i18n:Localization.Uid="Workload_KubernetesPage_083" Width="34" Height="34" Padding="0" Background="Transparent" BorderThickness="0"  Click="RunCron_Click" >
                                                            <FontIcon FontSize="14" Glyph="&#xE768;" />
                                                        </Button>
                                                        <Button x:Uid="Workload_KubernetesPage_084" i18n:Localization.Uid="Workload_KubernetesPage_084" Width="34" Height="34" Padding="0" Background="Transparent" BorderThickness="0"  Click="ToggleCron_Click" >
                                                            <FontIcon FontSize="14" Glyph="&#xE769;" />
                                                        </Button>
                                                        <Button x:Uid="Workload_KubernetesPage_085" i18n:Localization.Uid="Workload_KubernetesPage_085" Width="34" Height="34" Padding="0" Background="Transparent" BorderThickness="0"  Click="DeleteResource_Click" >
                                                            <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </Grid>
                        </Border>

                        <!--  Port Forwarding  -->
                        <Grid Visibility="{x:Bind ViewModel.SelectedSection, Mode=OneWay, Converter={StaticResource SectionVis}, ConverterParameter=Port Forwarding}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Button
                                Grid.Row="0"
                                Margin="0,0,0,10"
                                Command="{x:Bind ViewModel.AddPortForwardCommand}"
                                Style="{ThemeResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE71B;" />
                                    <TextBlock x:Uid="Workload_KubernetesPage_086" i18n:Localization.Uid="Workload_KubernetesPage_086"  />
                                </StackPanel>
                            </Button>

                            <Border Grid.Row="1" Style="{StaticResource ListCard}">
                                <Grid>
                                    <StackPanel
                                        Margin="0,60,0,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top"
                                        Spacing="10"
                                        Visibility="{x:Bind ViewModel.PortForwards.Count, Mode=OneWay, Converter={StaticResource EmptyToVis}}">
                                        <FontIcon
                                            HorizontalAlignment="Center"
                                            FontSize="36"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Glyph="&#xE71B;" />
                                        <TextBlock x:Uid="Workload_KubernetesPage_087" i18n:Localization.Uid="Workload_KubernetesPage_087"
                                            HorizontalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                             />
                                    </StackPanel>

                                    <ScrollViewer>
                                        <ItemsControl ItemsSource="{x:Bind ViewModel.PortForwards, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="k8s:PortForward">
                                                    <Grid Padding="16,10" ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="140" />
                                                            <ColumnDefinition Width="*" MinWidth="180" />
                                                            <ColumnDefinition Width="1.2*" MinWidth="110" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                                            <Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="#2DC85F" />
                                                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold">
                                                                <Run x:Uid="Workload_KubernetesPage_088" i18n:Localization.Uid="Workload_KubernetesPage_088"  />
                                                                <Run Text="{x:Bind LocalPort}" />
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            FontFamily="Consolas"
                                                            FontSize="12"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="{x:Bind TargetRef}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            Grid.Column="2"
                                                            VerticalAlignment="Center"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="{x:Bind Namespace}" />
                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
                                                            <Button x:Uid="Workload_KubernetesPage_089" i18n:Localization.Uid="Workload_KubernetesPage_089"
                                                                Padding="7,5"
                                                                Click="OpenForward_Click"
                                                                >
                                                                <FontIcon FontSize="14" Glyph="&#xE774;" />
                                                            </Button>
                                                            <Button x:Uid="Workload_KubernetesPage_090" i18n:Localization.Uid="Workload_KubernetesPage_090"
                                                                Padding="7,5"
                                                                Click="StopForward_Click"
                                                                >
                                                                <FontIcon FontSize="14" Glyph="&#xE71A;" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
