<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WslContainerDesktop.Views.KubernetesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i18n="using:WslContainerDesktop.Helpers"
    xmlns:converters="using:WslContainerDesktop.Helpers"
    xmlns:controls="using:WslContainerDesktop.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:WslContainerDesktop.Helpers"
    xmlns:k8s="using:WslContainerDesktop.Models"
    xmlns:vm="using:WslContainerDesktop.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="Root"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:EmptyToVisibilityConverter x:Key="EmptyToVis" />
        <converters:StringEqualsToVisibilityConverter x:Key="SectionVis" />
        <converters:StringEqualsToVisibilityConverter x:Key="SectionVisInverse" IsInverse="True" />

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="18,16" />
        </Style>
        <Style x:Key="ListCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="ColHead" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="K8sRowStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="16,4,12,4" />
            <Setter Property="MinHeight" Value="48" />
        </Style>
    </Page.Resources>

    <Grid Margin="24,16,24,16" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock x:Uid="Workload_KubernetesPage_001" i18n:Localization.Uid="Workload_KubernetesPage_001" Style="{ThemeResource TitleTextBlockStyle}"  />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay, Converter={StaticResource UiTextConverter}}" />
        </StackPanel>

        <!--  Status / control card  -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Width="52"
                    Height="52"
                    VerticalAlignment="Center"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                    <FontIcon
                        FontSize="24"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Glyph="&#xEB3C;" />
                </Border>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock x:Uid="Workload_KubernetesPage_002" i18n:Localization.Uid="Workload_KubernetesPage_002"
                            FontSize="18"
                            FontWeight="SemiBold"
                             />
                        <controls:InfoTip
                            VerticalAlignment="Center"
                            Title="{x:Bind helpers:FlagHelp.KubernetesLifetime.Title}"
                            Flag="{x:Bind helpers:FlagHelp.KubernetesLifetime.Flag}"
                            Text="{x:Bind helpers:FlagHelp.KubernetesLifetime.Text}" />
                        <Border
                            Padding="10,2"
                            VerticalAlignment="Center"
                            Background="#1F7A3D"
                            CornerRadius="10"
                            Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <TextBlock x:Uid="Workload_KubernetesPage_003" i18n:Localization.Uid="Workload_KubernetesPage_003" FontSize="12" Foreground="White"  />
                        </Border>
                        <Border
                            Padding="10,2"
                            VerticalAlignment="Center"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            CornerRadius="10"
                            Visibility="{x:Bind ViewModel.IsStarting, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <TextBlock x:Uid="Workload_KubernetesPage_004" i18n:Localization.Uid="Workload_KubernetesPage_004" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"  />
                        </Border>
                        <Border
                            Padding="10,2"
                            VerticalAlignment="Center"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            CornerRadius="10"
                            Visibility="{x:Bind ViewModel.IsStopped, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <TextBlock x:Uid="Workload_KubernetesPage_005" i18n:Localization.Uid="Workload_KubernetesPage_005" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"  />
                        </Border>
                        <Border
                            Padding="10,2"
                            VerticalAlignment="Center"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            CornerRadius="10"
                            Visibility="{x:Bind ViewModel.IsNotInstalled, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <TextBlock x:Uid="Workload_KubernetesPage_006" i18n:Localization.Uid="Workload_KubernetesPage_006" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"  />
                        </Border>
                        <Border
                            Padding="10,2"
                            VerticalAlignment="Center"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            CornerRadius="10"
                            Visibility="{x:Bind ViewModel.IsNoDistribution, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <TextBlock x:Uid="Workload_KubernetesPage_007" i18n:Localization.Uid="Workload_KubernetesPage_007" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"  />
                        </Border>
                    </StackPanel>
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="16"
                        Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}">
                            <Run x:Uid="Workload_KubernetesPage_008" i18n:Localization.Uid="Workload_KubernetesPage_008"  />
                            <Run Text="{x:Bind ViewModel.NodeName, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}">
                            <Run x:Uid="Workload_KubernetesPage_009" i18n:Localization.Uid="Workload_KubernetesPage_009"  />
                            <Run Text="{x:Bind ViewModel.KubernetesVersion, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}">
                            <Run x:Uid="Workload_KubernetesPage_010" i18n:Localization.Uid="Workload_KubernetesPage_010"  />
                            <Run Text="{x:Bind ViewModel.Distro, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <ProgressRing
                        Width="24"
                        Height="24"
                        IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                    <Button
                        Command="{x:Bind ViewModel.InstallCommand}"
                        Style="{ThemeResource AccentButtonStyle}"
                        Visibility="{x:Bind ViewModel.IsNotInstalled, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE896;" />
                            <TextBlock x:Uid="Workload_KubernetesPage_011" i18n:Localization.Uid="Workload_KubernetesPage_011"  />
                        </StackPanel>
                    </Button>
                    <Button
                        Command="{x:Bind ViewModel.StartCommand}"
                        Style="{ThemeResource AccentButtonStyle}"
                        Visibility="{x:Bind ViewModel.IsStopped, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE768;" />
                            <TextBlock x:Uid="Workload_KubernetesPage_012" i18n:Localization.Uid="Workload_KubernetesPage_012"  />
                        </StackPanel>
                    </Button>
                    <Button
                        Command="{x:Bind ViewModel.StopCommand}"
                        Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE71A;" />
                            <TextBlock x:Uid="Workload_KubernetesPage_013" i18n:Localization.Uid="Workload_KubernetesPage_013"  />
                        </StackPanel>
                    </Button>
                    <Button
                        Command="{x:Bind ViewModel.UpgradeCommand}"
                        Visibility="{x:Bind ViewModel.IsInstalled, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE896;" />
                            <TextBlock x:Uid="Workload_KubernetesPage_014" i18n:Localization.Uid="Workload_KubernetesPage_014"  />
                        </StackPanel>
                    </Button>
                    <Button
                        Command="{x:Bind ViewModel.UninstallCommand}"
                        Visibility="{x:Bind ViewModel.IsInstalled, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE74D;" />
                            <TextBlock x:Uid="Workload_KubernetesPage_015" i18n:Localization.Uid="Workload_KubernetesPage_015"  />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!--  Body  -->
        <Grid Grid.Row="2">

            <!--  Not-installed hero  -->
            <StackPanel
                MaxWidth="560"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="14"
                Visibility="{x:Bind ViewModel.IsNotInstalled, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <FontIcon
                    HorizontalAlignment="Center"
                    FontSize="52"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Glyph="&#xEB3C;" />
                <TextBlock x:Uid="Workload_KubernetesPage_016" i18n:Localization.Uid="Workload_KubernetesPage_016"
                    HorizontalAlignment="Center"
                    Style="{ThemeResource SubtitleTextBlockStyle}"
                     />
                <TextBlock x:Uid="Workload_KubernetesPage_017" i18n:Localization.Uid="Workload_KubernetesPage_017"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Button
                    HorizontalAlignment="Center"
                    Command="{x:Bind ViewModel.InstallCommand}"
                    Style="{ThemeResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE896;" />
                        <TextBlock x:Uid="Workload_KubernetesPage_018" i18n:Localization.Uid="Workload_KubernetesPage_018"  />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!--  No-distribution hero: k3s needs a WSL distro; containers do not.  -->
            <StackPanel
                MaxWidth="560"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="14"
                Visibility="{x:Bind ViewModel.IsNoDistribution, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <FontIcon
                    HorizontalAlignment="Center"
                    FontSize="52"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Glyph="&#xEB3C;" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{ThemeResource SubtitleTextBlockStyle}"
                    Text="{x:Bind ViewModel.NoDistributionTitle, Mode=OneWay, Converter={StaticResource UiTextConverter}}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.NoDistributionMessage, Mode=OneWay, Converter={StaticResource UiTextConverter}}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <HyperlinkButton x:Uid="Workload_KubernetesPage_019" i18n:Localization.Uid="Workload_KubernetesPage_019"  NavigateUri="https://learn.microsoft.com/windows/wsl/install" />
                    <Button x:Uid="Workload_KubernetesPage_020" i18n:Localization.Uid="Workload_KubernetesPage_020"
                        Command="{x:Bind ViewModel.UseDefaultDistributionCommand}"

                        Visibility="{x:Bind ViewModel.CanUseDefaultDistribution, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                    <Button Command="{x:Bind ViewModel.RefreshStatusCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE72C;" />
                            <TextBlock x:Uid="Workload_KubernetesPage_021" i18n:Localization.Uid="Workload_KubernetesPage_021"  />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>

            <!--  Operation log  -->
            <Border
                Background="#0C0C0F"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{x:Bind ViewModel.ShowOperationLog, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <ScrollViewer x:Name="LogScroll" Padding="14,10" VerticalScrollBarVisibility="Auto">
                        <TextBlock
                            x:Name="LogText"
                            FontFamily="Cascadia Mono, Consolas"
                            FontSize="12"
                            Foreground="#E4E4E8"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind ViewModel.OperationLog, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </ScrollViewer>
                    <Button x:Uid="Workload_KubernetesPage_022" i18n:Localization.Uid="Workload_KubernetesPage_022"
                        Margin="0,8,12,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Click="HideLog_Click"
                        Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                </Grid>
            </Border>

            <!--  Stopped hint  -->
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="10"
                Visibility="{x:Bind ViewModel.IsStopped, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <FontIcon
                    HorizontalAlignment="Center"
                    FontSize="44"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Glyph="&#xE769;" />
                <TextBlock x:Uid="Workload_KubernetesPage_023" i18n:Localization.Uid="Workload_KubernetesPage_023"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                     />
            </StackPanel>

            <!--  Starting hint  -->
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="10"
                Visibility="{x:Bind ViewModel.IsStarting, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <ProgressRing
                    Width="36"
                    Height="36"
                    HorizontalAlignment="Center"
                    IsActive="{x:Bind ViewModel.IsStarting, Mode=OneWay}" />
                <TextBlock x:Uid="Workload_KubernetesPage_024" i18n:Localization.Uid="Workload_KubernetesPage_024"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                     />
            </StackPanel>

            <!--  ===== Running: sub-nav shell =====  -->
            <Grid ColumnSpacing="14" Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  Sub-nav  -->
                <Border Grid.Column="0" Style="{StaticResource ListCard}">
                    <ListView
                        Padding="4,6"
                        SelectedItem="{x:Bind ViewModel.SelectedSection, Mode=TwoWay}"
                        SelectionMode="Single">
                        <x:String>Dashboard</x:String>
                        <x:String>Nodes</x:String>
                        <x:String>Deployments</x:String>
                        <x:String>Pods</x:String>
                        <x:String>Services</x:String>
                        <x:String>Ingresses</x:String>
                        <x:String>Persistent Volume Claims</x:String>
                        <x:String>ConfigMaps</x:String>
                        <x:String>Secrets</x:String>
                        <x:String>Jobs</x:String>
                        <x:String>CronJobs</x:String>
                        <x:String>Port Forwarding</x:String>
                    </ListView>
                </Border>

                <!--  Content  -->
                <Grid Grid.Column="1" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  Namespace bar  -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Text="{x:Bind ViewModel.SelectedSection, Mode=OneWay, Converter={StaticResource UiTextConverter}}"
                            TextTrimming="CharacterEllipsis" />
                        <StackPanel
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Spacing="12">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="8"
                                Visibility="{x:Bind ViewModel.SelectedSection, Mode=OneWay, Converter={StaticResource SectionVisInverse}, ConverterParameter=Port Forwarding}">
                                <TextBlock x:Uid="Workload_KubernetesPage_025" i18n:Localization.Uid="Workload_KubernetesPage_025"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                     />
                                <ComboBox
                                    MinWidth="180"
                                    ItemsSource="{x:Bind ViewModel.NamespaceOptions, Mode=OneWay}"
                                    SelectedValuePath="Value"
                                    SelectedValue="{x:Bind ViewModel.SelectedNamespace, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:K8sNamespaceOption">
                                            <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <Button x:Uid="Workload_KubernetesPage_026" i18n:Localization.Uid="Workload_KubernetesPage_026"
                                VerticalAlignment="Center"
                                Command="{x:Bind ViewModel.ApplyYamlCommand}"
                                Style="{ThemeResource AccentButtonStyle}"
                                >
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE898;" />
                                    <TextBlock x:Uid="Workload_KubernetesPage_027" i18n:Localization.Uid="Workload_KubernetesPage_027"  />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!--  Section panels  -->
                    <Grid Grid.Row="1">

                        <!--  Dashboard  -->
                        <controls:K8sDashboardSection
                            ViewModel="{x:Bind ViewModel}"
                            Visibility="{x:Bind ViewModel.SelectedSection, Mode=OneWay, Converter={StaticResource SectionVis}, ConverterParameter=Dashboard}" />

                        <!--  Nodes  -->
                        <Border
                            Style="{StaticResource ListCard}"
                            Visibility="{x:Bind ViewModel.SelectedSection, Mode=OneWay, Converter={StaticResource SectionVis}, ConverterParameter=Nodes}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Padding="16,10,12,10" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" MinWidth="140" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" MinWidth="120" />
                                            <ColumnDefinition Width="16" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="Workload_KubernetesPage_028" i18n:Localization.Uid="Workload_KubernetesPage_028" Grid.Column="0" Style="{StaticResource ColHead}"  />
                                        <TextBlock x:Uid="Workload_KubernetesPage_029" i18n:Localization.Uid="Workload_KubernetesPage_029" Grid.Column="1" Style="{StaticResource ColHead}"  />
                                        <TextBlock x:Uid="Workload_KubernetesPage_030" i18n:Localization.Uid="Workload_KubernetesPage_030" Grid.Column="2" Style="{StaticResource ColHead}"  />
                                        <TextBlock x:Uid="Workload_KubernetesPage_031" i18n:Localization.Uid="Workload_KubernetesPage_031" Grid.Column="3" Style="{StaticResource ColHead}"  />
                                    </Grid>
                                </Border>
                                <ListView
                                    Grid.Row="1"
                                    Padding="0,4"
                                    IsItemClickEnabled="True"
                                    ItemClick="Resource_ItemClick"
                                    ItemContainerStyle="{StaticResource K8sRowStyle}"
                                    ItemsSource="{x:Bind ViewModel.Nodes, Mode=OneWay}"
                                    SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="k8s:K8sNode">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*" MinWidth="140" />
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="*" MinWidth="120" />
                                                    <ColumnDefinition Width="16" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind Status, Converter={StaticResource UiTextConverter}}" />
                                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Roles}" />
                                                <TextBlock Grid.Column="3" VerticalAlignment="Center" FontFamily="Consolas" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Version}" />
                                                <FontIcon Grid.Column="4" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Glyph="&#xE76C;" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>

                        <!--  Deployments  -->
                        <Border
                            Style="{StaticResource ListCard}"
                            Visibility="{x:Bind ViewModel.SelectedSection, Mode=OneWay, Converter={StaticResource SectionVis}, ConverterParameter=Deployments}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Padding="16,10,12,10" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" MinWidth="160" />
                                            <ColumnDefinition Width="1.2*" MinWidth="110" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="120" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="Workload_KubernetesPage_032" i18n:Localization.Uid="Workload_KubernetesPage_032" Grid.Column="0" Style="{StaticResource ColHead}"  />
                                        <TextBlock x:Uid="Workload_KubernetesPage_033" i18n:Localization.Uid="Workload_KubernetesPage_033" Grid.Column="1" Style="{StaticResource ColHead}"  />
                                        <TextBlock x:Uid="Workload_KubernetesPage_034" i18n:Localization.Uid="Workload_KubernetesPage_034" Grid.Column="2" Style="{StaticResource ColHead}"  />
                                        <TextBlock x:Uid="Workload_KubernetesPage_035" i18n:Localization.Uid="Workload_KubernetesPage_035" Grid.Column="3" HorizontalAlignment="Right" Style="{StaticResource ColHead}"  />
                                    </Grid>
                                </Border>
                                <ListView
                                    Grid.Row="1"
                                    Padding="0,4"
                                    IsItemClickEnabled="True"
                                    ItemClick="Resource_ItemClick"
                                    ItemContainerStyle="{StaticResource K8sRowStyle}"
                                    ItemsSource="{x:Bind ViewModel.Deployments, Mode=OneWay}"
                                    SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="k8s:K8sDeployment">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*" MinWidth="160" />
                                                    <ColumnDefinition Width="1.2*" MinWidth="110" />
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="120" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Namespace}" />
                                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{x:Bind Ready}" />
                                                <StackPanel Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="2">
                                                    <Button x:Uid="Workload_KubernetesPage_036" i18n:Localization.Uid="Workload_KubernetesPage_036" Width="34" Height="34" Padding="0" Background="Transparent" BorderThickness="0"  Click="ScaleDeployment_Click" >
