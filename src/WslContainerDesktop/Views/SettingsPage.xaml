<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WslContainerDesktop.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i18n="using:WslContainerDesktop.Helpers"
    xmlns:converters="using:WslContainerDesktop.Helpers"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:WslContainerDesktop.ViewModels"
    xmlns:services="using:WslContainerDesktop.Services"
    x:Name="Root"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <DataTemplate x:Key="LocalizedOptionTemplate" x:DataType="services:LocalizedOption">
            <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" />
        </DataTemplate>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,12" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel
            MaxWidth="880"
            Margin="24,16,24,24"
            HorizontalAlignment="Stretch"
            Spacing="16">

            <TextBlock Style="{ThemeResource TitleTextBlockStyle}" x:Uid="Settings_Title" i18n:Localization.Uid="Settings_Title" />

            <!--  Language — first, so the whole page can be read in the chosen language  -->
            <TextBlock
                Margin="2,4,0,0"
                Style="{ThemeResource BodyStrongTextBlockStyle}"
                x:Uid="Settings_Language_Header" i18n:Localization.Uid="Settings_Language_Header" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="4">
                    <Grid Padding="0,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock x:Uid="Settings_Language_Label" i18n:Localization.Uid="Settings_Language_Label" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                x:Uid="Settings_Language_Help" i18n:Localization.Uid="Settings_Language_Help" />
                        </StackPanel>
                        <ComboBox
                            Grid.Column="1"
                            MinWidth="160"
                            ItemsSource="{x:Bind ViewModel.LanguageOptions}"
                            ItemTemplate="{StaticResource LocalizedOptionTemplate}"
                            SelectedIndex="{x:Bind ViewModel.SelectedLanguageIndex, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!--  Engine  -->
            <TextBlock
                Margin="2,4,0,0"
                Style="{ThemeResource BodyStrongTextBlockStyle}"
                x:Uid="Settings_Engine_Header" i18n:Localization.Uid="Settings_Engine_Header" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Grid.Column="0"
                            x:Uid="Settings_Engine_Path_Header" i18n:Localization.Uid="Settings_Engine_Path_Header"
                            Text="{x:Bind ViewModel.WslcPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Bottom"
                            Command="{x:Bind ViewModel.TestConnectionCommand}"
                            x:Uid="Settings_Engine_Test" i18n:Localization.Uid="Settings_Engine_Test" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            x:Uid="Settings_Engine_Version" i18n:Localization.Uid="Settings_Engine_Version" />
                        <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.EngineVersion, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  Dev Containers — hidden alongside the Dev Containers page; re-enable with the nav item  -->
            <TextBlock
                Margin="2,4,0,0"
                Style="{ThemeResource BodyStrongTextBlockStyle}"
                x:Uid="Settings_DevContainers_Header" i18n:Localization.Uid="Settings_DevContainers_Header"
                Visibility="Collapsed" />
            <Border Style="{StaticResource Card}" Visibility="Collapsed">
                <StackPanel Spacing="6">
                    <TextBox
                        x:Uid="Settings_DevContainers_Registry_Header" i18n:Localization.Uid="Settings_DevContainers_Registry_Header"
                        PlaceholderText="https://packagefeedproxy.microsoft.io/npm/"
                        Text="{x:Bind ViewModel.DevContainerNpmRegistry, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        x:Uid="Settings_DevContainers_Registry_Help" i18n:Localization.Uid="Settings_DevContainers_Registry_Help" />
                </StackPanel>
            </Border>

            <!--  Behavior  -->
            <TextBlock
                Margin="2,4,0,0"
                Style="{ThemeResource BodyStrongTextBlockStyle}"
                x:Uid="Settings_Behavior_Header" i18n:Localization.Uid="Settings_Behavior_Header" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="4">
                    <Grid Padding="0,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock x:Uid="Settings_Behavior_CloseToTray_Label" i18n:Localization.Uid="Settings_Behavior_CloseToTray_Label" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                x:Uid="Settings_Behavior_CloseToTray_Help" i18n:Localization.Uid="Settings_Behavior_CloseToTray_Help" />
                        </StackPanel>
                        <ToggleSwitch x:Uid="Settings_Toggle" i18n:Localization.Uid="Settings_Toggle"
                            Grid.Column="1"
                            MinWidth="0"
                            IsOn="{x:Bind ViewModel.CloseToTray, Mode=TwoWay}" />
                    </Grid>
                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Grid Padding="0,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock x:Uid="Settings_Behavior_Animations_Label" i18n:Localization.Uid="Settings_Behavior_Animations_Label" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                x:Uid="Settings_Behavior_Animations_Help" i18n:Localization.Uid="Settings_Behavior_Animations_Help"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch x:Uid="Root_Static_Settings_Animations" i18n:Localization.Uid="Root_Static_Settings_Animations"
                            Grid.Column="1"
                            MinWidth="0"
                            IsOn="{x:Bind ViewModel.PageAnimations, Mode=TwoWay}" />
                    </Grid>
                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Grid Padding="0,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock x:Uid="Settings_Behavior_StartMinimized_Label" i18n:Localization.Uid="Settings_Behavior_StartMinimized_Label" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                x:Uid="Settings_Behavior_StartMinimized_Help" i18n:Localization.Uid="Settings_Behavior_StartMinimized_Help" />
                        </StackPanel>
                        <ToggleSwitch x:Uid="Settings_Toggle" i18n:Localization.Uid="Settings_Toggle"
                            Grid.Column="1"
                            MinWidth="0"
                            IsOn="{x:Bind ViewModel.StartMinimized, Mode=TwoWay}" />
                    </Grid>
                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Grid Padding="0,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock x:Uid="Settings_Behavior_Restart_Label" i18n:Localization.Uid="Settings_Behavior_Restart_Label" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                x:Uid="Settings_Behavior_Restart_Help" i18n:Localization.Uid="Settings_Behavior_Restart_Help"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch x:Uid="Root_Static_Settings_RestartOnLaunch" i18n:Localization.Uid="Root_Static_Settings_RestartOnLaunch"
                            Grid.Column="1"
                            MinWidth="0"
                            IsOn="{x:Bind ViewModel.RestartRunningContainersOnLaunch, Mode=TwoWay}" />
                    </Grid>
                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Grid Padding="0,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock x:Uid="Settings_Behavior_SignIn_Label" i18n:Localization.Uid="Settings_Behavior_SignIn_Label" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.RunAtLoginNote, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch x:Uid="Root_Static_Settings_RunAtSignIn" i18n:Localization.Uid="Root_Static_Settings_RunAtSignIn"
                            Grid.Column="1"
                            MinWidth="0"
                            IsEnabled="{x:Bind ViewModel.RunAtLoginEnabled, Mode=OneWay}"
                            IsOn="{x:Bind ViewModel.RunAtLogin, Mode=TwoWay}" />
                    </Grid>
                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Grid Padding="0,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock x:Uid="Settings_Behavior_Refresh_Label" i18n:Localization.Uid="Settings_Behavior_Refresh_Label" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                x:Uid="Settings_Behavior_Refresh_Help" i18n:Localization.Uid="Settings_Behavior_Refresh_Help" />
                        </StackPanel>
                        <NumberBox
                            Grid.Column="1"
                            MinWidth="120"
                            Maximum="120"
                            Minimum="2"
                            SpinButtonPlacementMode="Inline"
                            Value="{x:Bind ViewModel.RefreshIntervalSeconds, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!--  Appearance  -->
            <TextBlock
                Margin="2,4,0,0"
                Style="{ThemeResource BodyStrongTextBlockStyle}"
                x:Uid="Settings_Appearance_Header" i18n:Localization.Uid="Settings_Appearance_Header" />
            <Border Style="{StaticResource Card}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock x:Uid="Settings_Theme_Label" i18n:Localization.Uid="Settings_Theme_Label" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            x:Uid="Settings_Theme_Help" i18n:Localization.Uid="Settings_Theme_Help" />
                    </StackPanel>
                    <ComboBox
                        Grid.Column="1"
                        MinWidth="160"
                        ItemsSource="{x:Bind ViewModel.ThemeOptions}"
                        ItemTemplate="{StaticResource LocalizedOptionTemplate}"
                        SelectedIndex="{x:Bind ViewModel.SelectedThemeIndex, Mode=TwoWay}" />
                </Grid>
            </Border>

            <!--  Notifications  -->
            <TextBlock
                Margin="2,4,0,0"
                Style="{ThemeResource BodyStrongTextBlockStyle}"
                x:Uid="Settings_Notify_Header" i18n:Localization.Uid="Settings_Notify_Header" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="4">
                    <Grid Padding="0,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock x:Uid="Settings_Notify_Master_Label" i18n:Localization.Uid="Settings_Notify_Master_Label" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                x:Uid="Settings_Notify_Master_Help" i18n:Localization.Uid="Settings_Notify_Master_Help" />
                        </StackPanel>
                        <ToggleSwitch x:Uid="Settings_Toggle" i18n:Localization.Uid="Settings_Toggle"
                            Grid.Column="1"
                            MinWidth="0"
                            IsOn="{x:Bind ViewModel.NotificationsEnabled, Mode=TwoWay}" />
                    </Grid>
                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Grid Padding="0,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock x:Uid="Settings_Notify_Image_Label" i18n:Localization.Uid="Settings_Notify_Image_Label" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                x:Uid="Settings_Notify_Image_Help" i18n:Localization.Uid="Settings_Notify_Image_Help" />
                        </StackPanel>
                        <ToggleSwitch x:Uid="Settings_Toggle" i18n:Localization.Uid="Settings_Toggle"
                            Grid.Column="1"
                            MinWidth="0"
                            IsEnabled="{x:Bind ViewModel.NotificationsEnabled, Mode=OneWay}"
                            IsOn="{x:Bind ViewModel.NotifyImageEvents, Mode=TwoWay}" />
                    </Grid>
                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Grid Padding="0,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock x:Uid="Settings_Notify_Stopped_Label" i18n:Localization.Uid="Settings_Notify_Stopped_Label" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                x:Uid="Settings_Notify_Stopped_Help" i18n:Localization.Uid="Settings_Notify_Stopped_Help" />
                        </StackPanel>
                        <ToggleSwitch x:Uid="Settings_Toggle" i18n:Localization.Uid="Settings_Toggle"
                            Grid.Column="1"
                            MinWidth="0"
                            IsEnabled="{x:Bind ViewModel.NotificationsEnabled, Mode=OneWay}"
                            IsOn="{x:Bind ViewModel.NotifyContainerEvents, Mode=TwoWay}" />
                    </Grid>
                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Grid Padding="0,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock x:Uid="Settings_Notify_Engine_Label" i18n:Localization.Uid="Settings_Notify_Engine_Label" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                x:Uid="Settings_Notify_Engine_Help" i18n:Localization.Uid="Settings_Notify_Engine_Help" />
                        </StackPanel>
                        <ToggleSwitch x:Uid="Settings_Toggle" i18n:Localization.Uid="Settings_Toggle"
                            Grid.Column="1"
                            MinWidth="0"
                            IsEnabled="{x:Bind ViewModel.NotificationsEnabled, Mode=OneWay}"
                            IsOn="{x:Bind ViewModel.NotifyEngineEvents, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!--  AI diagnostics  -->
            <TextBlock
                Margin="2,4,0,0"
                Style="{ThemeResource BodyStrongTextBlockStyle}"
                x:Uid="Settings_Ai_Header" i18n:Localization.Uid="Settings_Ai_Header" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock x:Uid="Settings_Ai_Enable_Label" i18n:Localization.Uid="Settings_Ai_Enable_Label" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                x:Uid="Settings_Ai_Enable_Help" i18n:Localization.Uid="Settings_Ai_Enable_Help"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch x:Uid="Settings_Toggle" i18n:Localization.Uid="Settings_Toggle"
                            Grid.Column="1"
                            MinWidth="0"
                            IsOn="{x:Bind ViewModel.AiFeaturesEnabled, Mode=TwoWay}" />
                    </Grid>
                    <Border
                        Padding="12"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon
                                VerticalAlignment="Center"
                                FontSize="16"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE9D9;" />
                            <StackPanel Spacing="2">
                                <TextBlock
                                    AutomationProperties.AutomationId="ActiveAiProviderText"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind ViewModel.ActiveProviderName, Mode=OneWay}" />
                                <TextBlock
                                    AutomationProperties.AutomationId="ActiveAiProviderDetailText"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.ActiveProviderDetail, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border
                        Padding="14"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <StackPanel Spacing="10">
                            <StackPanel Spacing="2">
                                <TextBlock FontWeight="SemiBold" x:Uid="Settings_Ai_QuickStart_Title" i18n:Localization.Uid="Settings_Ai_QuickStart_Title" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    x:Uid="Settings_Ai_QuickStart_Help" i18n:Localization.Uid="Settings_Ai_QuickStart_Help"
                                    TextWrapping="Wrap" />
                                <Expander
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    x:Uid="Settings_Ai_WhatSetup_Header" i18n:Localization.Uid="Settings_Ai_WhatSetup_Header">
                                    <StackPanel Spacing="8">
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            x:Uid="Settings_Ai_WhatSetup_P1" i18n:Localization.Uid="Settings_Ai_WhatSetup_P1"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            x:Uid="Settings_Ai_WhatSetup_P2" i18n:Localization.Uid="Settings_Ai_WhatSetup_P2"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            x:Uid="Settings_Ai_WhatSetup_P3" i18n:Localization.Uid="Settings_Ai_WhatSetup_P3"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    AutomationProperties.AutomationId="SetUpLocalAiButton"
                                    Command="{x:Bind ViewModel.SetUpLocalAiCommand}"
                                    IsEnabled="{x:Bind ViewModel.CanQuickStartOllama, Mode=OneWay}"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    Visibility="{x:Bind ViewModel.ShowLocalSetupButtons, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="13" Glyph="&#xE945;" />
                                        <TextBlock x:Uid="Settings_Ai_SetupOllama" i18n:Localization.Uid="Settings_Ai_SetupOllama" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    AutomationProperties.AutomationId="CancelSetUpLocalAiButton"
                                    Command="{x:Bind ViewModel.SetUpLocalAiCancelCommand}"
                                    x:Uid="Settings_Ai_CancelSetup" i18n:Localization.Uid="Settings_Ai_CancelSetup"
                                    Visibility="{x:Bind ViewModel.SetUpLocalAiCommand.IsRunning, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                <Button
                                    AutomationProperties.AutomationId="RemoveLocalAiButton"
                                    Command="{x:Bind ViewModel.RemoveLocalAiCommand}"
                                    x:Uid="Settings_Ai_RemoveOllama" i18n:Localization.Uid="Settings_Ai_RemoveOllama"
                                    Visibility="{x:Bind ViewModel.ShowRemoveOllama, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                            <TextBlock
                                AutomationProperties.AutomationId="QuickStartHintText"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.QuickStartHint, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <ProgressBar
                                IsIndeterminate="True"
                                Visibility="{x:Bind ViewModel.FoundryLocal.IsPreparingAnything, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.FoundryLocal.SetupStatus, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind ViewModel.FoundryLocal.IsPreparingAnything, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                            <ProgressBar
                                IsIndeterminate="True"
                                Visibility="{x:Bind ViewModel.IsOllamaBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                            <InfoBar
                                x:Name="LocalAiFeedbackBar"
                                AutomationProperties.AutomationId="LocalAiFeedbackInfoBar"
                                CloseButtonClick="LocalAiFeedbackBar_CloseButtonClick"
                                IsClosable="True"
                                IsOpen="{x:Bind ViewModel.LocalAiFeedback.IsVisible, Mode=OneWay}"
                                Message="{x:Bind ViewModel.LocalAiFeedback.Message, Mode=OneWay}"
                                Severity="{x:Bind converters:AiFeedbackDisplay.ToInfoBarSeverity(ViewModel.LocalAiFeedback.Severity), Mode=OneWay}"
                                Title="{x:Bind ViewModel.LocalAiFeedback.Title, Mode=OneWay}" />
                            <Expander
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                x:Uid="Settings_Ai_Technical_Header" i18n:Localization.Uid="Settings_Ai_Technical_Header"
                                Visibility="{x:Bind ViewModel.LocalAiFeedback.HasTechnicalDetails, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <StackPanel Spacing="8">
                                    <TextBlock
                                        AutomationProperties.AutomationId="LocalAiFeedbackDetailsText"
                                        FontFamily="Cascadia Mono, Consolas"
                                        FontSize="12"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind ViewModel.LocalAiFeedback.TechnicalDetails, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                    <Button
                                        AutomationProperties.AutomationId="CopyLocalAiFeedbackDetailsButton"
                                        Command="{x:Bind ViewModel.CopyLocalAiFeedbackDetailsCommand}"
                                        x:Uid="Settings_Ai_CopyDetails" i18n:Localization.Uid="Settings_Ai_CopyDetails" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>
                    <ComboBox
                        AutomationProperties.AutomationId="AiProviderComboBox"
                        x:Uid="Settings_Ai_Provider_Header" i18n:Localization.Uid="Settings_Ai_Provider_Header"
                        MinWidth="260"
                        SelectedIndex="{x:Bind ViewModel.SelectedAiProviderIndex, Mode=TwoWay}">
                        <ComboBoxItem x:Uid="Settings_Ai_Provider_None" i18n:Localization.Uid="Settings_Ai_Provider_None" />
                        <ComboBoxItem x:Uid="Settings_Ai_Provider_Copilot" i18n:Localization.Uid="Settings_Ai_Provider_Copilot" />
                        <ComboBoxItem x:Uid="Settings_Ai_Provider_Ollama" i18n:Localization.Uid="Settings_Ai_Provider_Ollama" />
                        <ComboBoxItem x:Uid="Settings_Ai_Provider_Azure" i18n:Localization.Uid="Settings_Ai_Provider_Azure" />
                        <ComboBoxItem x:Uid="Settings_Ai_Provider_OpenAI" i18n:Localization.Uid="Settings_Ai_Provider_OpenAI" />
                    </ComboBox>
                    <Expander
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        x:Uid="Settings_Ai_Privacy_Header" i18n:Localization.Uid="Settings_Ai_Privacy_Header"
                        Visibility="{x:Bind ViewModel.ShowAiProviderSettings, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <TextBlock
                            FontSize="12"
                            IsTextSelectionEnabled="True"
                            x:Uid="Settings_Ai_Privacy_Help" i18n:Localization.Uid="Settings_Ai_Privacy_Help"
                            TextWrapping="Wrap" />
                    </Expander>
                    <Expander
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        x:Uid="Settings_Ai_ProviderSettings_Header" i18n:Localization.Uid="Settings_Ai_ProviderSettings_Header"
                        Visibility="{x:Bind ViewModel.ShowAiProviderSettings, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <StackPanel Spacing="10">
                            <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.ShowGitHubCopilotSettings, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <Button
                                    Command="{x:Bind ViewModel.SignInGitHubCopilotCommand}"
                                    x:Uid="Settings_Ai_Copilot_SignIn" i18n:Localization.Uid="Settings_Ai_Copilot_SignIn" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox
                                        Grid.Column="0"
                                        DisplayMemberPath="LocalizedDisplayName"
                                        x:Uid="Settings_Ai_Copilot_Model_Header" i18n:Localization.Uid="Settings_Ai_Copilot_Model_Header"
                                        ItemsSource="{x:Bind ViewModel.GitHubCopilotModels, Mode=OneWay}"
                                        SelectedValue="{x:Bind ViewModel.AiGitHubCopilotModel, Mode=TwoWay}"
                                        SelectedValuePath="Id" />
                                    <Button
                                        Grid.Column="1"
                                        VerticalAlignment="Bottom"
                                        Command="{x:Bind ViewModel.RefreshGitHubCopilotModelsCommand}"
                                        x:Uid="Settings_Ai_Copilot_Refresh" i18n:Localization.Uid="Settings_Ai_Copilot_Refresh" />
                                </Grid>
                            </StackPanel>
                            <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.ShowOllamaSettings, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <TextBox
                                    AutomationProperties.AutomationId="AiOllamaEndpointTextBox"
                                    x:Uid="Settings_Ai_Ollama_Endpoint_Header" i18n:Localization.Uid="Settings_Ai_Ollama_Endpoint_Header"
                                    Text="{x:Bind ViewModel.AiOllamaEndpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox
                                        AutomationProperties.AutomationId="AiOllamaModelComboBox"
                                        Grid.Column="0"
                                        HorizontalAlignment="Stretch"
                                        DisplayMemberPath="LocalizedDisplayName"
                                        x:Uid="Settings_Ai_Ollama_Model_Header" i18n:Localization.Uid="Settings_Ai_Ollama_Model_Header"
                                        ItemsSource="{x:Bind ViewModel.OllamaModels, Mode=OneWay}"
                                        SelectedValue="{x:Bind ViewModel.AiOllamaModel, Mode=TwoWay}"
                                        SelectedValuePath="Id" />
                                    <Button
                                        x:Uid="Root_Static_Settings_RefreshOllamaModels" i18n:Localization.Uid="Root_Static_Settings_RefreshOllamaModels"
                                        AutomationProperties.AutomationId="RefreshOllamaModelsButton"
                                        Grid.Column="1"
                                        VerticalAlignment="Bottom"
                                        Command="{x:Bind ViewModel.RefreshOllamaModelsCommand}" />
                                </Grid>
                                <TextBlock
                                    x:Uid="Settings_Ai_Ollama_Model_Help" i18n:Localization.Uid="Settings_Ai_Ollama_Model_Help"
                                    TextWrapping="Wrap"
                                    Style="{StaticResource CaptionTextBlockStyle}" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        AutomationProperties.AutomationId="OllamaPullModelTextBox"
                                        Grid.Column="0"
                                        x:Uid="Settings_Ai_Ollama_Pull" i18n:Localization.Uid="Settings_Ai_Ollama_Pull"
                                        Text="{x:Bind ViewModel.OllamaPullModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button
                                        AutomationProperties.AutomationId="PullOllamaModelButton"
                                        Grid.Column="1"
                                        VerticalAlignment="Bottom"
                                        Command="{x:Bind ViewModel.PullOllamaModelCommand}"
                                        x:Uid="Settings_Ai_Ollama_PullButton" i18n:Localization.Uid="Settings_Ai_Ollama_PullButton" />
                                </Grid>
                                <ProgressBar
                                    IsIndeterminate="True"
                                    Visibility="{x:Bind ViewModel.IsOllamaBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                            <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.ShowAzureOpenAiSettings, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <TextBox
                                    x:Uid="Settings_Ai_Azure_Endpoint_Header" i18n:Localization.Uid="Settings_Ai_Azure_Endpoint_Header"
                                    PlaceholderText="https://your-resource.openai.azure.com"
                                    Text="{x:Bind ViewModel.AiAzureOpenAiEndpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox
                                    x:Uid="Settings_Ai_Azure_Deployment_Header" i18n:Localization.Uid="Settings_Ai_Azure_Deployment_Header"
                                    Text="{x:Bind ViewModel.AiAzureOpenAiDeployment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.ShowOpenAiSettings, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <TextBox
                                    x:Uid="Settings_Ai_OpenAI_Endpoint_Header" i18n:Localization.Uid="Settings_Ai_OpenAI_Endpoint_Header"
                                    PlaceholderText="https://api.openai.com/v1"
                                    Text="{x:Bind ViewModel.AiOpenAiEndpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    x:Uid="Settings_Ai_OpenAI_Endpoint_Help" i18n:Localization.Uid="Settings_Ai_OpenAI_Endpoint_Help"
                                    TextWrapping="Wrap" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox
                                        Grid.Column="0"
                                        HorizontalAlignment="Stretch"
                                        x:Uid="Settings_Ai_OpenAI_Model_Header" i18n:Localization.Uid="Settings_Ai_OpenAI_Model_Header"
                                        IsEditable="True"
                                        ItemsSource="{x:Bind ViewModel.OpenAiModels, Mode=OneWay}"
                                        Text="{x:Bind ViewModel.AiOpenAiModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button
                                        x:Uid="Root_Static_Settings_RefreshOpenAiModels" i18n:Localization.Uid="Root_Static_Settings_RefreshOpenAiModels"
                                        Grid.Column="1"
                                        VerticalAlignment="Bottom"
                                        Command="{x:Bind ViewModel.RefreshOpenAiModelsCommand}" />
                                </Grid>
                            </StackPanel>
                            <Grid ColumnSpacing="8" Visibility="{x:Bind ViewModel.ShowAiSecretSettings, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <PasswordBox
                                    x:Name="AiApiKeyBox"
                                    Grid.Column="0"
                                    x:Uid="Settings_Ai_ApiKey" i18n:Localization.Uid="Settings_Ai_ApiKey" />
                                <Button
                                    Grid.Column="1"
                                    VerticalAlignment="Bottom"
                                    Click="SaveAiApiKey_Click"
                                    x:Uid="Settings_Ai_SaveKey" i18n:Localization.Uid="Settings_Ai_SaveKey" />
                            </Grid>
                        </StackPanel>
                    </Expander>
                    <Grid ColumnSpacing="12" Visibility="{x:Bind ViewModel.ShowAiProviderSettings, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            x:Uid="Settings_Ai_Capabilities_Help" i18n:Localization.Uid="Settings_Ai_Capabilities_Help"
                            TextWrapping="Wrap" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button
                                AutomationProperties.AutomationId="TestAiProviderButton"
                                Command="{x:Bind ViewModel.TestAiProviderCommand}"
                                x:Uid="Settings_Ai_TestCapabilities" i18n:Localization.Uid="Settings_Ai_TestCapabilities" />
                            <Button
                                AutomationProperties.AutomationId="CancelAiCapabilityTestButton"
                                Command="{x:Bind ViewModel.TestAiProviderCancelCommand}"
                                x:Uid="Settings_Ai_CancelTest" i18n:Localization.Uid="Settings_Ai_CancelTest" />
                        </StackPanel>
                    </Grid>
                    <Expander
                        AutomationProperties.AutomationId="AiCapabilityStatusExpander"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Header="{x:Bind ViewModel.AiCapabilityHeadline, Mode=OneWay}">
                        <TextBlock
                            AutomationProperties.AutomationId="AiCapabilityStatusText"
                            FontSize="12"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind ViewModel.AiCapabilityStatus, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </Expander>
                    <InfoBar
                        x:Name="ProviderFeedbackBar"
                        AutomationProperties.AutomationId="ProviderFeedbackInfoBar"
                        CloseButtonClick="ProviderFeedbackBar_CloseButtonClick"
                        IsClosable="True"
                        IsOpen="{x:Bind ViewModel.ProviderFeedback.IsVisible, Mode=OneWay}"
                        Message="{x:Bind ViewModel.ProviderFeedback.Message, Mode=OneWay}"
                        Severity="{x:Bind converters:AiFeedbackDisplay.ToInfoBarSeverity(ViewModel.ProviderFeedback.Severity), Mode=OneWay}"
                        Title="{x:Bind ViewModel.ProviderFeedback.Title, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.ShowAiProviderSettings, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                    <Expander
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        x:Uid="Settings_Ai_Technical_Header" i18n:Localization.Uid="Settings_Ai_Technical_Header"
                        Visibility="{x:Bind ViewModel.ProviderFeedback.HasTechnicalDetails, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <StackPanel Spacing="8">
                            <TextBlock
                                AutomationProperties.AutomationId="ProviderFeedbackDetailsText"
                                FontFamily="Cascadia Mono, Consolas"
                                FontSize="12"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind ViewModel.ProviderFeedback.TechnicalDetails, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <Button
                                AutomationProperties.AutomationId="CopyProviderFeedbackDetailsButton"
                                Command="{x:Bind ViewModel.CopyProviderFeedbackDetailsCommand}"
                                x:Uid="Settings_Ai_CopyDetails" i18n:Localization.Uid="Settings_Ai_CopyDetails" />
                        </StackPanel>
                    </Expander>
                    <Expander
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        x:Uid="Settings_Ai_Permissions_Header" i18n:Localization.Uid="Settings_Ai_Permissions_Header"
                        Visibility="{x:Bind ViewModel.ShowAiProviderSettings, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <StackPanel Spacing="12">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                x:Uid="Settings_Ai_Permissions_Help" i18n:Localization.Uid="Settings_Ai_Permissions_Help"
                                TextWrapping="Wrap" />
                            <Border
                                Padding="12"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <StackPanel Spacing="14">
                                    <StackPanel Spacing="6">
                                        <ToggleSwitch
                                            AutomationProperties.AutomationId="AssistantAllowDestructiveToggle"
                                            IsOn="{x:Bind ViewModel.AssistantAllowDestructive, Mode=TwoWay}"
                                            x:Uid="Settings_Ai_AllowDelete" i18n:Localization.Uid="Settings_Ai_AllowDelete" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            x:Uid="Settings_Ai_AllowDelete_Help" i18n:Localization.Uid="Settings_Ai_AllowDelete_Help"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Spacing="6">
                                        <ToggleSwitch
                                            AutomationProperties.AutomationId="AssistantApproveEverythingToggle"
                                            IsOn="{x:Bind ViewModel.AssistantApproveEverything, Mode=TwoWay}"
                                            x:Uid="Settings_Ai_AutoApprove" i18n:Localization.Uid="Settings_Ai_AutoApprove" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            x:Uid="Settings_Ai_AutoApprove_Help" i18n:Localization.Uid="Settings_Ai_AutoApprove_Help"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.AssistantToolPermissions, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AssistantToolPermissionGroup">
                                        <StackPanel Margin="0,4,0,0" Spacing="4">
                                            <TextBlock
                                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                                Text="{x:Bind Header, Mode=OneWay}" />
                                            <ItemsControl ItemsSource="{x:Bind Tools}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:AssistantToolPermission">
                                                        <ToggleSwitch
                                                            Header="{x:Bind DisplayName, Mode=OneWay}"
                                                            IsEnabled="{x:Bind IsEnabled, Mode=OneWay}"
                                                            IsOn="{x:Bind AutoApprove, Mode=TwoWay}"
                                                            x:Uid="Settings_Ai_Perm" i18n:Localization.Uid="Settings_Ai_Perm" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>

            <!--  Diagnostics  -->
            <TextBlock
                Margin="2,4,0,0"
                Style="{ThemeResource BodyStrongTextBlockStyle}"
                x:Uid="Settings_Diag_Header" i18n:Localization.Uid="Settings_Diag_Header" />
            <Border Style="{StaticResource Card}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock x:Uid="Settings_Diag_Logs_Label" i18n:Localization.Uid="Settings_Diag_Logs_Label" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            x:Uid="Settings_Diag_Logs_Help" i18n:Localization.Uid="Settings_Diag_Logs_Help"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Command="{x:Bind ViewModel.OpenLogsFolderCommand}"
                        x:Uid="Settings_Diag_OpenLogs" i18n:Localization.Uid="Settings_Diag_OpenLogs" />
                </Grid>
            </Border>

            <!--  About  -->
            <TextBlock
                Margin="2,4,0,0"
                Style="{ThemeResource BodyStrongTextBlockStyle}"
                x:Uid="Settings_About_Header" i18n:Localization.Uid="Settings_About_Header" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="6">
                    <TextBlock FontWeight="SemiBold" x:Uid="Settings_About_Title" i18n:Localization.Uid="Settings_About_Title" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.AppVersion}" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        x:Uid="Settings_About_Tagline" i18n:Localization.Uid="Settings_About_Tagline" />
                    <StackPanel Margin="-12,0,0,0" Orientation="Horizontal">
                        <HyperlinkButton x:Uid="Settings_About_Learn" i18n:Localization.Uid="Settings_About_Learn" NavigateUri="https://aka.ms/wslc" />
                        <HyperlinkButton x:Uid="Settings_About_GitHub" i18n:Localization.Uid="Settings_About_GitHub" NavigateUri="{x:Bind ViewModel.RepositoryUri}" />
                        <HyperlinkButton x:Uid="Settings_About_Report" i18n:Localization.Uid="Settings_About_Report" NavigateUri="{x:Bind ViewModel.NewIssueUri}" />
                    </StackPanel>
                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Grid Padding="0,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock x:Uid="Settings_Updates_OnLaunch_Label" i18n:Localization.Uid="Settings_Updates_OnLaunch_Label" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                x:Uid="Settings_Updates_OnLaunch_Help" i18n:Localization.Uid="Settings_Updates_OnLaunch_Help"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch x:Uid="Root_Static_Settings_CheckUpdates" i18n:Localization.Uid="Root_Static_Settings_CheckUpdates"
                            Grid.Column="1"
                            MinWidth="0"
                            IsOn="{x:Bind ViewModel.CheckForUpdatesOnLaunch, Mode=TwoWay}" />
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind Updates.StatusTextDisplay, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <Button
                            Grid.Column="1"
                            AutomationProperties.AutomationId="CheckForUpdatesButton"
                            Command="{x:Bind Updates.CheckForUpdatesCommand}"
                            x:Uid="Settings_Updates_Check" i18n:Localization.Uid="Settings_Updates_Check" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
