<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WslContainerDesktop.Views.ContainerDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i18n="using:WslContainerDesktop.Helpers"
    xmlns:converters="using:WslContainerDesktop.Helpers"
    xmlns:controls="using:WslContainerDesktop.Views.Controls"
    xmlns:helpers="using:WslContainerDesktop.Helpers"
    xmlns:local="using:WslContainerDesktop.Views"
    xmlns:models="using:WslContainerDesktop.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="Root"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:StateToBrushConverter x:Key="StateToBrush" />
        <converters:StateToStringConverter x:Key="StateToString" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:HexToBrushConverter x:Key="HexToBrush" />
    </Page.Resources>

    <Grid Margin="24,14,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Breadcrumb / header  -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Uid="Resource_ContainerDetail_001" i18n:Localization.Uid="Resource_ContainerDetail_001"
                Grid.Column="0"
                Width="40"
                Height="40"
                Padding="0"
                VerticalAlignment="Center"

                Click="Back_Click">
                <FontIcon FontSize="15" Glyph="&#xE72B;" />
            </Button>

            <!-- Grids (not horizontal StackPanels) so a long name trims instead of pushing the
                  state and GPU badges out of view when the action buttons need the space.  -->
            <Grid
                Grid.Column="1"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="42"
                    Height="42"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <FontIcon
                        FontSize="19"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Glyph="&#xE7F4;" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Grid HorizontalAlignment="Left" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse
                            Width="12"
                            Height="12"
                            VerticalAlignment="Center"
                            Fill="{x:Bind ViewModel.Selected.State, Mode=OneWay, Converter={StaticResource StateToBrush}}" />
                        <TextBlock
                            Grid.Column="1"
                            MinWidth="60"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Text="{x:Bind ViewModel.Selected.Name, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{x:Bind ViewModel.Selected.Name, Mode=OneWay}" />
                        <Border
                            Grid.Column="2"
                            Padding="8,2"
                            VerticalAlignment="Center"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            CornerRadius="10">
                            <TextBlock
                                FontSize="12"
                                Text="{x:Bind ViewModel.Selected.State, Mode=OneWay, Converter={StaticResource StateToString}}" />
                        </Border>
                        <Border
                            Grid.Column="3"
                            Padding="8,2"
                            VerticalAlignment="Center"
                            Background="#1F7A3D"
                            CornerRadius="10"
                            ToolTipService.ToolTip="{x:Bind ViewModel.Selected.GpuTooltip, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.Selected.HasGpu, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon FontSize="12" Foreground="White" Glyph="&#xE950;" />
                                <TextBlock FontSize="12" Foreground="White" Text="GPU" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <TextBlock
                        FontSize="13"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Text="{x:Bind ViewModel.Selected.Image, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>

            <!-- Actions  -->
            <StackPanel
                Grid.Column="2"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="6">
                <Button x:Uid="Resource_ContainerDetail_002" i18n:Localization.Uid="Resource_ContainerDetail_002"

                    Command="{x:Bind ViewModel.StartCommand}"
                    CommandParameter="{x:Bind ViewModel.Selected, Mode=OneWay}"
                    Style="{ThemeResource AccentButtonStyle}"

                    Visibility="{x:Bind ViewModel.Selected.IsStopped, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <FontIcon FontSize="14" Glyph="&#xE768;" />
                </Button>
                <Button x:Uid="Resource_ContainerDetail_003" i18n:Localization.Uid="Resource_ContainerDetail_003"

                    Command="{x:Bind ViewModel.StopCommand}"
                    CommandParameter="{x:Bind ViewModel.Selected, Mode=OneWay}"

                    Visibility="{x:Bind ViewModel.Selected.IsRunning, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <FontIcon FontSize="14" Glyph="&#xE71A;" />
                </Button>
                <Button x:Uid="Resource_ContainerDetail_004" i18n:Localization.Uid="Resource_ContainerDetail_004"

                    Command="{x:Bind ViewModel.RestartCommand}"
                    CommandParameter="{x:Bind ViewModel.Selected, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.Selected.IsRunning, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <ToolTipService.ToolTip>
                        <ToolTip>
                            <StackPanel MaxWidth="360" Spacing="4">
                                <TextBlock x:Uid="Resource_ContainerDetail_005" i18n:Localization.Uid="Resource_ContainerDetail_005" FontWeight="SemiBold" />
                                <TextBlock FontFamily="Consolas" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind helpers:FlagHelp.ContainerRestart.Flag}" />
                                <TextBlock Text="{x:Bind helpers:FlagHelp.ContainerRestart.Text}" TextWrapping="Wrap" />
                            </StackPanel>
                        </ToolTip>
                    </ToolTipService.ToolTip>
                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                </Button>
                <Button x:Uid="Resource_ContainerDetail_006" i18n:Localization.Uid="Resource_ContainerDetail_006"

                    Command="{x:Bind ViewModel.KillCommand}"
                    CommandParameter="{x:Bind ViewModel.Selected, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.Selected.IsRunning, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <ToolTipService.ToolTip>
                        <ToolTip>
                            <StackPanel MaxWidth="360" Spacing="4">
                                <TextBlock x:Uid="Resource_ContainerDetail_007" i18n:Localization.Uid="Resource_ContainerDetail_007" FontWeight="SemiBold" />
                                <TextBlock FontFamily="Consolas" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind helpers:FlagHelp.ContainerKill.Flag}" />
                                <TextBlock Text="{x:Bind helpers:FlagHelp.ContainerKill.Text}" TextWrapping="Wrap" />
                            </StackPanel>
                        </ToolTip>
                    </ToolTipService.ToolTip>
                    <FontIcon FontSize="14" Glyph="&#xE8BB;" />
                </Button>
                <Button x:Uid="Resource_ContainerDetail_008" i18n:Localization.Uid="Resource_ContainerDetail_008"

                    Command="{x:Bind ViewModel.TerminalCommand}"
                    CommandParameter="{x:Bind ViewModel.Selected, Mode=OneWay}"

                    Visibility="{x:Bind ViewModel.Selected.IsRunning, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <FontIcon FontSize="14" Glyph="&#xE756;" />
                </Button>
                <Button x:Uid="Resource_ContainerDetail_009" i18n:Localization.Uid="Resource_ContainerDetail_009"

                    Command="{x:Bind ViewModel.OpenPortCommand}"
                    CommandParameter="{x:Bind ViewModel.Selected, Mode=OneWay}"

                    Visibility="{x:Bind ViewModel.Selected.CanOpenInBrowser, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <FontIcon FontSize="14" Glyph="&#xE774;" />
                </Button>
                <Button x:Uid="Resource_ContainerDetail_010" i18n:Localization.Uid="Resource_ContainerDetail_010"

                    Command="{x:Bind ViewModel.PrepareAiDiagnosisCommand}"
                    Visibility="{x:Bind local:ContainerDetailPage.BoolToVisibility(ViewModel.IsAiAvailable), Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE945;" />
                        <TextBlock x:Uid="Resource_ContainerDetail_011" i18n:Localization.Uid="Resource_ContainerDetail_011" />
                    </StackPanel>
                </Button>
                <!-- Occasional actions live here so the toolbar keeps the everyday ones.  -->
                <Button x:Uid="Resource_ContainerDetail_012" i18n:Localization.Uid="Resource_ContainerDetail_012" >
                    <FontIcon FontSize="14" Glyph="&#xE712;" />
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem x:Uid="Resource_ContainerDetail_013" i18n:Localization.Uid="Resource_ContainerDetail_013" Click="ExportContainer_Click" ToolTipService.ToolTip="{x:Bind helpers:FlagHelp.ContainerExport.Text}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE74E;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Uid="Resource_ContainerDetail_014" i18n:Localization.Uid="Resource_ContainerDetail_014"
                                Command="{x:Bind ViewModel.AttachCommand}"
                                CommandParameter="{x:Bind ViewModel.Selected, Mode=OneWay}"

                                ToolTipService.ToolTip="{x:Bind helpers:FlagHelp.ContainerAttach.Text}"
                                Visibility="{x:Bind ViewModel.Selected.IsRunning, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8A7;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button x:Uid="Resource_ContainerDetail_015" i18n:Localization.Uid="Resource_ContainerDetail_015" Click="Remove_Click">
                    <FontIcon FontSize="14" Glyph="&#xE74D;" />
                </Button>
            </StackPanel>
        </Grid>

        <Border
            Grid.Row="1"
            Height="1"
            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <!-- Tabs  -->
        <SelectorBar
            x:Name="DetailTabs"
            Grid.Row="2"
            SelectionChanged="DetailTabs_SelectionChanged">
            <SelectorBarItem x:Uid="Resource_ContainerDetail_016" i18n:Localization.Uid="Resource_ContainerDetail_016"
                x:Name="TabLogs"
                IsSelected="True">
                <SelectorBarItem.Icon>
                    <FontIcon Glyph="&#xE9D9;" />
                </SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem x:Uid="Resource_ContainerDetail_017" i18n:Localization.Uid="Resource_ContainerDetail_017" x:Name="TabSummary" >
                <SelectorBarItem.Icon>
                    <FontIcon Glyph="&#xE946;" />
                </SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem x:Uid="Resource_ContainerDetail_018" i18n:Localization.Uid="Resource_ContainerDetail_018" x:Name="TabStats" >
                <SelectorBarItem.Icon>
                    <FontIcon Glyph="&#xE9D9;" />
                </SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem x:Uid="Resource_ContainerDetail_019" i18n:Localization.Uid="Resource_ContainerDetail_019" x:Name="TabInspect" >
                <SelectorBarItem.Icon>
                    <FontIcon Glyph="&#xE943;" />
                </SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem x:Uid="Resource_ContainerDetail_020" i18n:Localization.Uid="Resource_ContainerDetail_020" x:Name="TabFiles" >
                <SelectorBarItem.Icon>
                    <FontIcon Glyph="&#xE838;" />
                </SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem x:Uid="Resource_ContainerDetail_021" i18n:Localization.Uid="Resource_ContainerDetail_021" x:Name="TabChanges" >
                <SelectorBarItem.Icon>
                    <FontIcon Glyph="&#xE1CB;" />
                </SelectorBarItem.Icon>
            </SelectorBarItem>
        </SelectorBar>

        <!-- AI diagnose-and-fix preview/results  -->
        <Border
            Grid.Row="3"
            Padding="14"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6"
            MaxHeight="360"
            Visibility="{x:Bind ViewModel.IsAiPanelVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="Resource_ContainerDetail_022" i18n:Localization.Uid="Resource_ContainerDetail_022"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold" />
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Top">
                        <Button
                            AutomationProperties.AutomationId="SendAiDiagnosisButton"
                            Command="{x:Bind ViewModel.SendAiDiagnosisCommand}"
                            IsEnabled="{x:Bind ViewModel.AiHasPreview, Mode=OneWay}"
                            Style="{ThemeResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="13" Glyph="&#xE724;" />
                                <TextBlock x:Uid="Resource_ContainerDetail_023" i18n:Localization.Uid="Resource_ContainerDetail_023" />
                            </StackPanel>
                        </Button>
                        <Button
                            AutomationProperties.Name="{x:Bind local:ContainerDetailPage.CollapseTooltip(ViewModel.AiPanelCollapsed), Mode=OneWay}"
                            Command="{x:Bind ViewModel.ToggleAiPanelCollapsedCommand}"
                            ToolTipService.ToolTip="{x:Bind local:ContainerDetailPage.CollapseTooltip(ViewModel.AiPanelCollapsed), Mode=OneWay}">
                            <FontIcon FontSize="13" Glyph="{x:Bind local:ContainerDetailPage.CollapseGlyph(ViewModel.AiPanelCollapsed), Mode=OneWay}" />
                        </Button>
                        <Button x:Uid="Resource_ContainerDetail_024" i18n:Localization.Uid="Resource_ContainerDetail_024"

                            Command="{x:Bind ViewModel.DismissAiDiagnosisCommand}">
                            <FontIcon FontSize="13" Glyph="&#xE711;" />
                        </Button>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1" Spacing="8">
                    <InfoBar
                        x:Name="DiagnosisFeedbackBar"
                        AutomationProperties.AutomationId="DiagnosisFeedbackInfoBar"
                        CloseButtonClick="DiagnosisFeedbackBar_CloseButtonClick"
                        IsClosable="True"
                        IsOpen="{x:Bind ViewModel.DiagnosisFeedback.IsVisible, Mode=OneWay}"
                        Message="{x:Bind ViewModel.DiagnosisFeedback.Message, Mode=OneWay, Converter={StaticResource UiTextConverter}}"
                        Severity="{x:Bind converters:AiFeedbackDisplay.ToInfoBarSeverity(ViewModel.DiagnosisFeedback.Severity), Mode=OneWay}"
                        Title="{x:Bind ViewModel.DiagnosisFeedback.Title, Mode=OneWay, Converter={StaticResource UiTextConverter}}" />
                    <Expander x:Uid="Resource_ContainerDetail_025" i18n:Localization.Uid="Resource_ContainerDetail_025"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"

                        Visibility="{x:Bind ViewModel.DiagnosisFeedback.HasTechnicalDetails, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <StackPanel Spacing="8">
                            <TextBlock
                                AutomationProperties.AutomationId="DiagnosisFeedbackDetailsText"
                                FontFamily="Cascadia Mono, Consolas"
                                FontSize="12"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind ViewModel.DiagnosisFeedback.TechnicalDetails, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <Button x:Uid="Resource_ContainerDetail_026" i18n:Localization.Uid="Resource_ContainerDetail_026"
                                AutomationProperties.AutomationId="CopyDiagnosisFeedbackDetailsButton"
                                Command="{x:Bind ViewModel.CopyDiagnosisFeedbackDetailsCommand}" />
                        </StackPanel>
                    </Expander>
                </StackPanel>

                <ProgressBar
                    Grid.Row="2"
                    IsIndeterminate="{x:Bind ViewModel.IsAiBusy, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsAiBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

                <ScrollViewer
                    Grid.Row="3"
                    VerticalScrollBarVisibility="Auto"
                    VerticalScrollMode="Auto"
                    Visibility="{x:Bind local:ContainerDetailPage.InvertBoolToVisibility(ViewModel.AiPanelCollapsed), Mode=OneWay}">
                    <StackPanel Spacing="10">
                        <Expander x:Uid="Resource_ContainerDetail_027" i18n:Localization.Uid="Resource_ContainerDetail_027"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch">
                            <ScrollViewer MaxHeight="220">
                                <TextBlock
                                    FontFamily="Cascadia Mono, Consolas"
                                    FontSize="12"
                                    IsTextSelectionEnabled="True"
                                    Text="{x:Bind ViewModel.AiPreviewPayload, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Expander>
                        <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.AiHasDiagnosis, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock x:Uid="Resource_ContainerDetail_028" i18n:Localization.Uid="Resource_ContainerDetail_028" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.AiSummary, Mode=OneWay}" TextWrapping="Wrap" />
                                    <TextBlock x:Uid="Resource_ContainerDetail_029" i18n:Localization.Uid="Resource_ContainerDetail_029" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.AiLikelyCause, Mode=OneWay}" TextWrapping="Wrap" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind ViewModel.AiConfidenceDisplay, Mode=OneWay}" />
                                </StackPanel>
                                <Button x:Uid="Resource_ContainerDetail_030" i18n:Localization.Uid="Resource_ContainerDetail_030"
                                    Grid.Column="1"
                                    Command="{x:Bind ViewModel.CopyAiSuggestedFixCommand}" />
                            </Grid>
                    <Expander x:Uid="Resource_ContainerDetail_031" i18n:Localization.Uid="Resource_ContainerDetail_031"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.AiEvidenceCitations, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Margin="0,2" Text="{x:Bind}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                    <Border
                        Padding="12"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        CornerRadius="6">
                        <StackPanel Spacing="6">
                            <TextBlock x:Uid="Resource_ContainerDetail_032" i18n:Localization.Uid="Resource_ContainerDetail_032" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind ViewModel.AiSuggestedFixDescription, Mode=OneWay}" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.AiSuggestedCommands, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock
                                            Margin="0,2"
                                            FontFamily="Cascadia Mono, Consolas"
                                            IsTextSelectionEnabled="True"
                                            Text="{x:Bind}"
                                            TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.AiSuggestedFileEdits, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock
                                            Margin="0,2"
                                            FontFamily="Cascadia Mono, Consolas"
                                            IsTextSelectionEnabled="True"
                                            Text="{x:Bind}"
                                            TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Tab content  -->
        <Grid Grid.Row="4">
            <!--  ===== Logs (default, full height) =====  -->
            <Grid x:Name="LogsPanel" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="6">
                        <TextBox x:Uid="Resource_ContainerDetail_033" i18n:Localization.Uid="Resource_ContainerDetail_033"
                            x:Name="SearchBox"
                            Width="240"
                            MinWidth="120"

                            TextChanged="SearchBox_TextChanged" />
                        <TextBlock
                            x:Name="MatchCountText"
                            MinWidth="64"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}" />
                        <Button x:Uid="Resource_ContainerDetail_034" i18n:Localization.Uid="Resource_ContainerDetail_034"
                            x:Name="PrevMatchButton"
                            Padding="7,5"

                            Click="PrevMatch_Click"
                            IsEnabled="False">
                            <FontIcon FontSize="12" Glyph="&#xE70E;" />
                        </Button>
                        <Button x:Uid="Resource_ContainerDetail_035" i18n:Localization.Uid="Resource_ContainerDetail_035"
                            x:Name="NextMatchButton"
                            Padding="7,5"

                            Click="NextMatch_Click"
                            IsEnabled="False">
                            <FontIcon FontSize="12" Glyph="&#xE70D;" />
                        </Button>
                        <ToggleButton x:Uid="Resource_ContainerDetail_036" i18n:Localization.Uid="Resource_ContainerDetail_036"
                            x:Name="CaseToggle"
                            Padding="9,5"

                            Click="SearchOption_Click"
                            Content="Aa" />
                        <ToggleButton x:Uid="Resource_ContainerDetail_037" i18n:Localization.Uid="Resource_ContainerDetail_037"
                            x:Name="FilterToggle"
                            Padding="8,5"

                            Click="SearchOption_Click">
                            <FontIcon FontSize="14" Glyph="&#xE71C;" />
                        </ToggleButton>
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8">
                        <ToggleButton x:Uid="Resource_ContainerDetail_038" i18n:Localization.Uid="Resource_ContainerDetail_038"
                            x:Name="HighlightErrorsToggle"
                            Padding="8,5"

                            Click="HighlightErrors_Click">
                            <FontIcon FontSize="14" Glyph="&#xE7BA;" />
                        </ToggleButton>
                        <ToggleButton x:Uid="Resource_ContainerDetail_039" i18n:Localization.Uid="Resource_ContainerDetail_039"
                            Padding="8,5"

                            IsChecked="{x:Bind ViewModel.LogTimestamps, Mode=TwoWay}">
                            <FontIcon FontSize="14" Glyph="&#xE823;" />
                        </ToggleButton>
                        <ToggleButton x:Uid="Resource_ContainerDetail_040" i18n:Localization.Uid="Resource_ContainerDetail_040"
                            x:Name="WrapToggle"
                            Padding="8,5"

                            Click="WrapToggle_Click">
                            <FontIcon FontSize="14" Glyph="&#xE751;" />
                        </ToggleButton>
                        <AppBarSeparator Margin="0" Padding="0" />
                        <Button x:Uid="Resource_ContainerDetail_041" i18n:Localization.Uid="Resource_ContainerDetail_041"

                            Click="ExportLogs_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="13" Glyph="&#xE74E;" />
                                <TextBlock x:Uid="Resource_ContainerDetail_042" i18n:Localization.Uid="Resource_ContainerDetail_042" />
                            </StackPanel>
                        </Button>
                        <Button x:Uid="Resource_ContainerDetail_043" i18n:Localization.Uid="Resource_ContainerDetail_043"

                            Click="ClearLogs_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="13" Glyph="&#xE74D;" />
                                <TextBlock x:Uid="Resource_ContainerDetail_044" i18n:Localization.Uid="Resource_ContainerDetail_044" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Border
                    Grid.Row="1"
                    Background="#0C0C0F"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <ScrollViewer
                        x:Name="LogScroll"
                        Padding="14,10"
                        HorizontalScrollBarVisibility="Auto"
                        HorizontalScrollMode="Auto"
                        VerticalScrollBarVisibility="Auto">
                        <TextBlock
                            x:Name="LogText"
                            FontFamily="Cascadia Mono, Consolas"
                            FontSize="13"
                            Foreground="#E4E4E8"
                            IsTextSelectionEnabled="True"
                            LineHeight="19"
                            TextWrapping="NoWrap" />
                    </ScrollViewer>
                </Border>
            </Grid>

            <!--  ===== Summary =====  -->
            <ScrollViewer x:Name="SummaryPanel" Visibility="Collapsed">
                <StackPanel MaxWidth="900" Spacing="12">
                    <Border
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <Grid ColumnSpacing="24" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock x:Uid="Resource_ContainerDetail_045" i18n:Localization.Uid="Resource_ContainerDetail_045"
                                Grid.Row="0"
                                Grid.Column="0"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                FontFamily="Consolas"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind ViewModel.Selected.ShortId, Mode=OneWay}" />

                            <TextBlock x:Uid="Resource_ContainerDetail_046" i18n:Localization.Uid="Resource_ContainerDetail_046"
                                Grid.Row="1"
                                Grid.Column="0"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="1"
                                Text="{x:Bind ViewModel.Selected.State, Mode=OneWay, Converter={StaticResource StateToString}}" />

                            <TextBlock x:Uid="Resource_ContainerDetail_047" i18n:Localization.Uid="Resource_ContainerDetail_047"
                                Grid.Row="2"
                                Grid.Column="0"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="1"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind ViewModel.Selected.Image, Mode=OneWay}"
                                TextWrapping="Wrap" />

                            <TextBlock x:Uid="Resource_ContainerDetail_048" i18n:Localization.Uid="Resource_ContainerDetail_048"
                                Grid.Row="3"
                                Grid.Column="0"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="1"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind ViewModel.Selected.PortsDisplayText, Mode=OneWay}"
                                TextWrapping="Wrap" />

                            <TextBlock x:Uid="Resource_ContainerDetail_049" i18n:Localization.Uid="Resource_ContainerDetail_049"
                                Grid.Row="4"
                                Grid.Column="0"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock
                                Grid.Row="4"
                                Grid.Column="1"
                                FontFamily="Consolas"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind ViewModel.DetailIp, Mode=OneWay}" />

                            <TextBlock x:Uid="Resource_ContainerDetail_050" i18n:Localization.Uid="Resource_ContainerDetail_050"
                                Grid.Row="5"
                                Grid.Column="0"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock
                                Grid.Row="5"
                                Grid.Column="1"
                                Text="{x:Bind ViewModel.DetailNetwork, Mode=OneWay}" />

                            <TextBlock x:Uid="Resource_ContainerDetail_051" i18n:Localization.Uid="Resource_ContainerDetail_051"
                                Grid.Row="6"
                                Grid.Column="0"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock
                                Grid.Row="6"
                                Grid.Column="1"
                                Text="{x:Bind ViewModel.DetailStarted, Mode=OneWay}" />

                            <TextBlock x:Uid="Resource_ContainerDetail_052" i18n:Localization.Uid="Resource_ContainerDetail_052"
                                Grid.Row="7"
                                Grid.Column="0"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock
                                Grid.Row="7"
                                Grid.Column="1"
                                FontFamily="Consolas"
                                FontSize="12"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind ViewModel.DetailCommand, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <StackPanel
                                Grid.Row="8"
                                Grid.Column="0"
                                Orientation="Horizontal"
                                Spacing="4">
                                <TextBlock x:Uid="Resource_ContainerDetail_053" i18n:Localization.Uid="Resource_ContainerDetail_053"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <controls:InfoTip
                                    Title="{x:Bind helpers:FlagHelp.ContainersSize.Title}"
                                    Flag="{x:Bind helpers:FlagHelp.ContainersSize.Flag}"
                                    Text="{x:Bind helpers:FlagHelp.ContainersSize.Text}" />
                            </StackPanel>
                            <TextBlock
                                Grid.Row="8"
                                Grid.Column="1"
                                FontFamily="Consolas"
                                Text="{x:Bind ViewModel.DetailSizeRw, Mode=OneWay}" />
                            <TextBlock x:Uid="Resource_ContainerDetail_054" i18n:Localization.Uid="Resource_ContainerDetail_054"
                                Grid.Row="9"
                                Grid.Column="0"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock
                                Grid.Row="9"
                                Grid.Column="1"
                                FontFamily="Consolas"
                                Text="{x:Bind ViewModel.DetailSizeRootFs, Mode=OneWay}" />
                        </Grid>
                    </Border>

                    <Expander x:Uid="Resource_ContainerDetail_055" i18n:Localization.Uid="Resource_ContainerDetail_055"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.DetailEnvironment, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock
                                        Margin="0,2"
                                        FontFamily="Consolas"
                                        FontSize="12"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind}"
                                        TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                    <Expander x:Uid="Resource_ContainerDetail_056" i18n:Localization.Uid="Resource_ContainerDetail_056"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.DetailMounts, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock
                                        Margin="0,2"
                                        FontFamily="Consolas"
                                        FontSize="12"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind}"
                                        TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                    <Expander
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch">
                        <Expander.Header>
                            <TextBlock x:Uid="Resource_ContainerDetail_057" i18n:Localization.Uid="Resource_ContainerDetail_057" VerticalAlignment="Center" />
                        </Expander.Header>
                        <StackPanel Spacing="8">
                            <Button
                                Command="{x:Bind ViewModel.ConnectNetworkCommand}"
                                Style="{ThemeResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="13" Glyph="&#xE710;" />
                                    <TextBlock x:Uid="Resource_ContainerDetail_058" i18n:Localization.Uid="Resource_ContainerDetail_058" />
                                </StackPanel>
                            </Button>
                            <ListView
                                ItemsSource="{x:Bind ViewModel.DetailNetworks, Mode=OneWay}"
                                SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:NetworkAttachment">
                                        <Grid Padding="0,4" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock x:Uid="Resource_ContainerDetail_059" i18n:Localization.Uid="Resource_ContainerDetail_059" Style="{ThemeResource CaptionTextBlockStyle}" />
                                                <TextBlock FontWeight="SemiBold" Text="{x:Bind Network}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="IPV4" />
                                                <TextBlock FontFamily="Consolas" Text="{x:Bind Ipv4Display}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock x:Uid="Resource_ContainerDetail_060" i18n:Localization.Uid="Resource_ContainerDetail_060" Style="{ThemeResource CaptionTextBlockStyle}" />
                                                <TextBlock Text="{x:Bind AliasesDisplay}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Button x:Uid="Resource_ContainerDetail_061" i18n:Localization.Uid="Resource_ContainerDetail_061"
                                                Grid.Column="3"
                                                Click="DisconnectNetwork_Click"

                                                VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <!--  ===== Stats =====  -->
            <ScrollViewer x:Name="StatsPanel" Visibility="Collapsed">
                <StackPanel MaxWidth="900" Spacing="14">
                    <!-- CPU + Memory big meters  -->
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="0"
                            Padding="16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon
                                        FontSize="16"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Glyph="&#xE950;" />
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="CPU" />
                                </StackPanel>
                                <TextBlock FontSize="30" FontWeight="SemiBold" Text="{x:Bind ViewModel.StatCpu, Mode=OneWay}" />
                                <ProgressBar Maximum="100" Value="{x:Bind ViewModel.StatCpuValue, Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Column="1"
                            Padding="16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon
                                        FontSize="16"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Glyph="&#xEEA0;" />
                                    <TextBlock x:Uid="Resource_ContainerDetail_062" i18n:Localization.Uid="Resource_ContainerDetail_062" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock FontSize="30" FontWeight="SemiBold" Text="{x:Bind ViewModel.StatMem, Mode=OneWay}" />
                                <ProgressBar Maximum="100" Value="{x:Bind ViewModel.StatMemValue, Mode=OneWay}" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.StatMemUsage, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- I/O + PIDs  -->
                    <Border
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid ColumnSpacing="24" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock x:Uid="Resource_ContainerDetail_063" i18n:Localization.Uid="Resource_ContainerDetail_063"
                                Grid.Row="0"
                                Grid.Column="0"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                FontFamily="Consolas"
                                Text="{x:Bind ViewModel.StatNetIO, Mode=OneWay}" />

                            <TextBlock x:Uid="Resource_ContainerDetail_064" i18n:Localization.Uid="Resource_ContainerDetail_064"
                                Grid.Row="1"
                                Grid.Column="0"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="1"
                                FontFamily="Consolas"
                                Text="{x:Bind ViewModel.StatBlockIO, Mode=OneWay}" />

                            <TextBlock x:Uid="Resource_ContainerDetail_065" i18n:Localization.Uid="Resource_ContainerDetail_065"
                                Grid.Row="2"
                                Grid.Column="0"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="1"
                                FontFamily="Consolas"
                                Text="{x:Bind ViewModel.StatPids, Mode=OneWay}" />
                        </Grid>
                    </Border>

                    <TextBlock x:Uid="Resource_ContainerDetail_066" i18n:Localization.Uid="Resource_ContainerDetail_066"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </ScrollViewer>

            <!--  ===== Files =====  -->
            <Grid
                x:Name="FilesPanel"
                RowSpacing="8"
                Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Navigation toolbar  -->
                <Grid
                    Grid.Row="0"
                    ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:Uid="Resource_ContainerDetail_067" i18n:Localization.Uid="Resource_ContainerDetail_067"
                        Grid.Column="0"
                        Height="32"
                        Padding="10,0"

                        Click="FilesUp_Click"
                        IsEnabled="{x:Bind ViewModel.CanNavigateUp, Mode=OneWay}">
                        <FontIcon FontSize="13" Glyph="&#xE74A;" />
                    </Button>
                    <Button x:Uid="Resource_ContainerDetail_068" i18n:Localization.Uid="Resource_ContainerDetail_068"
                        Grid.Column="1"
                        Height="32"
                        Padding="10,0"

                        Click="FilesRefresh_Click">
                        <FontIcon FontSize="13" Glyph="&#xE72C;" />
                    </Button>
                    <Border
                        Grid.Column="2"
                        Height="32"
                        Padding="10,0"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <TextBlock
                            FontFamily="Consolas"
                            FontSize="12"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind ViewModel.FilesCurrentPath, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            VerticalAlignment="Center" />
                    </Border>
                    <Button x:Uid="Resource_ContainerDetail_069" i18n:Localization.Uid="Resource_ContainerDetail_069"
                        Grid.Column="3"
                        Height="32"
                        Padding="10,0"

                        Click="FilesNewFolder_Click"

                        Visibility="{x:Bind ViewModel.FilesBrowseAvailable, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon FontSize="13" Glyph="&#xE8F4;" />
                            <TextBlock x:Uid="Resource_ContainerDetail_070" i18n:Localization.Uid="Resource_ContainerDetail_070"
                                FontSize="12"

                                VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Uid="Resource_ContainerDetail_071" i18n:Localization.Uid="Resource_ContainerDetail_071"
                        Grid.Column="4"
                        Height="32"
                        Padding="10,0"

                        Click="CopyInFile_Click">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon FontSize="13" Glyph="&#xE898;" />
                            <TextBlock x:Uid="Resource_ContainerDetail_072" i18n:Localization.Uid="Resource_ContainerDetail_072"
                                FontSize="12"

                                VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Uid="Resource_ContainerDetail_073" i18n:Localization.Uid="Resource_ContainerDetail_073"
                        Grid.Column="5"
                        Height="32"
                        Padding="10,0"

                        Click="CopyInFolder_Click">
                        <FontIcon FontSize="13" Glyph="&#xE8DA;" />
                    </Button>
                </Grid>

                <!-- File list area with drag-drop  -->
                <Border
                    x:Name="DropZoneBorder"
                    Grid.Row="1"
                    AllowDrop="True"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    DragEnter="DropZone_DragEnter"
                    DragLeave="DropZone_DragLeave"
                    DragOver="DropZone_DragOver"
                    Drop="DropZone_Drop">
                    <Grid>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Column headers  -->
                            <Grid
                                Grid.Row="0"
                                Padding="16,8"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="0,0,0,1"
                                ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="128" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="Resource_ContainerDetail_074" i18n:Localization.Uid="Resource_ContainerDetail_074"
                                    Grid.Column="1"
                                    FontSize="12"
                                    FontWeight="SemiBold" />
                                <TextBlock x:Uid="Resource_ContainerDetail_075" i18n:Localization.Uid="Resource_ContainerDetail_075"
                                    Grid.Column="2"
                                    FontSize="12"
                                    FontWeight="SemiBold" />
                                <TextBlock x:Uid="Resource_ContainerDetail_076" i18n:Localization.Uid="Resource_ContainerDetail_076"
                                    Grid.Column="3"
                                    FontSize="12"
                                    FontWeight="SemiBold" />
                                <TextBlock x:Uid="Resource_ContainerDetail_077" i18n:Localization.Uid="Resource_ContainerDetail_077"
                                    Grid.Column="4"
                                    FontSize="12"
                                    FontWeight="SemiBold" />
                                <TextBlock x:Uid="Resource_ContainerDetail_078" i18n:Localization.Uid="Resource_ContainerDetail_078"
                                    Grid.Column="5"
                                    FontSize="12"
                                    FontWeight="SemiBold" />
                            </Grid>

                            <!-- File list  -->
                            <ListView
                                x:Name="FilesList"
                                Grid.Row="1"
                                CanDragItems="True"
                                DragItemsStarting="FilesList_DragItemsStarting"
                                DoubleTapped="FilesList_DoubleTapped"
                                ItemsSource="{x:Bind ViewModel.DetailFiles, Mode=OneWay}"
                                RightTapped="FilesList_RightTapped"
                                SelectedItem="{x:Bind ViewModel.SelectedFile, Mode=TwoWay}"
                                SelectionMode="Single">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="MinHeight" Value="0" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:ContainerFileEntry">
                                        <Grid
                                            Padding="16,6"
                                            ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="72" />
                                                <ColumnDefinition Width="76" />
                                                <ColumnDefinition Width="128" />
                                                <ColumnDefinition Width="100" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon
                                                Grid.Column="0"
                                                FontSize="15"
                                                Glyph="{x:Bind IconGlyph}"
                                                VerticalAlignment="Center" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{x:Bind Name}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTipService.ToolTip="{x:Bind Name}"
                                                VerticalAlignment="Center" />
                                            <TextBlock
                                                Grid.Column="2"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind LocalizedTypeDisplay, Mode=OneWay}"
                                                VerticalAlignment="Center" />
                                            <TextBlock
                                                Grid.Column="3"
                                                FontSize="12"
                                                Text="{x:Bind SizeDisplay}"
                                                VerticalAlignment="Center" />
                                            <TextBlock
                                                Grid.Column="4"
                                                FontSize="12"
                                                Text="{x:Bind ModifiedDisplay}"
                                                VerticalAlignment="Center" />
                                            <TextBlock
                                                Grid.Column="5"
                                                FontFamily="Consolas"
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind Permissions}"
                                                VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- Shown when the list can't be loaded (container stopped, or no shell to list with).
                                  Native copy still works then, so offer a download by known path here, in context.  -->
                            <StackPanel
                                Grid.Row="1"
                                MaxWidth="520"
                                Margin="24"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="10"
                                Visibility="{x:Bind ViewModel.FilesBrowseUnavailable, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <FontIcon
                                    FontSize="32"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Glyph="&#xE8B7;" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Text="{x:Bind ViewModel.FilesUnavailableReasonDisplay, Mode=OneWay}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                                <TextBlock x:Uid="Resource_ContainerDetail_079" i18n:Localization.Uid="Resource_ContainerDetail_079"
                                    HorizontalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"

                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                                <Button x:Uid="Resource_ContainerDetail_080" i18n:Localization.Uid="Resource_ContainerDetail_080"
                                    HorizontalAlignment="Center"
                                    AutomationProperties.AutomationId="DownloadContainerPath"
                                    Click="DownloadPath_Click" />
                            </StackPanel>
                        </Grid>

                        <!-- Drop overlay (shown when files are dragged over the panel)  -->
                        <Border
                            x:Name="DropOverlay"
                            Background="#220078D4"
                            BorderBrush="#780078D4"
                            BorderThickness="2"
                            CornerRadius="8"
                            IsHitTestVisible="False"
                            Visibility="Collapsed">
                            <StackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="8">
                                <FontIcon
                                    FontSize="40"
                                    Foreground="#0078D4"
                                    Glyph="&#xE898;" />
                                <TextBlock x:Uid="Resource_ContainerDetail_081" i18n:Localization.Uid="Resource_ContainerDetail_081"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Foreground="#0078D4"
                                    HorizontalAlignment="Center" />
                                <TextBlock x:Uid="Resource_ContainerDetail_082" i18n:Localization.Uid="Resource_ContainerDetail_082"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Status bar  -->
                <TextBlock
                    Grid.Row="2"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.FilesStatusMessageDisplay, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>

            <!--  ===== Inspect =====  -->
            <Border
                x:Name="InspectPanel"
                Background="#0C0C0F"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Visibility="Collapsed">
                <ScrollViewer
                    Padding="14,10"
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Auto"
                    VerticalScrollBarVisibility="Auto">
                    <TextBlock
                        FontFamily="Cascadia Mono, Consolas"
                        FontSize="12"
                        Foreground="#E4E4E8"
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind ViewModel.DetailInspectJson, Mode=OneWay}"
                        TextWrapping="NoWrap" />
                </ScrollViewer>
            </Border>

            <!--  ===== Changes (docker diff equivalent) =====  -->
            <Grid
                x:Name="ChangesPanel"
                RowSpacing="8"
                Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Toolbar  -->
                <Grid Grid.Row="0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Uid="Resource_ContainerDetail_083" i18n:Localization.Uid="Resource_ContainerDetail_083"
                        Grid.Column="0"
                        Height="32"
                        Padding="10,0"

                        Click="ChangesRefresh_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="13" Glyph="&#xE72C;" />
                            <TextBlock x:Uid="Resource_ContainerDetail_084" i18n:Localization.Uid="Resource_ContainerDetail_084"
                                FontSize="12"

                                VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock x:Uid="Resource_ContainerDetail_085" i18n:Localization.Uid="Resource_ContainerDetail_085"
                        Grid.Column="1"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"

                        TextTrimming="CharacterEllipsis"
                        VerticalAlignment="Center" />
                    <ProgressRing
                        Grid.Column="2"
                        Width="18"
                        Height="18"
                        IsActive="{x:Bind ViewModel.IsChangesBusy, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsChangesBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                </Grid>

                <!-- Change list  -->
                <Border
                    Grid.Row="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <ListView
                            x:Name="ChangesList"
                            Padding="4"
                            IsItemClickEnabled="False"
                            ItemsSource="{x:Bind ViewModel.DetailChanges, Mode=OneWay}"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:ContainerFsChange">
                                    <Grid ColumnSpacing="10" Padding="6,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Grid.Column="0"
                                            Width="22"
                                            Height="22"
                                            Background="{x:Bind KindColorHex, Converter={StaticResource HexToBrush}}"
                                            CornerRadius="4"
                                            ToolTipService.ToolTip="{x:Bind KindLabel, Converter={StaticResource UiTextConverter}}"
                                            VerticalAlignment="Center">
                                            <TextBlock
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Foreground="White"
                                                HorizontalAlignment="Center"
                                                Text="{x:Bind KindGlyph}"
                                                VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock
                                            Grid.Column="1"
                                            FontFamily="Cascadia Mono, Consolas"
                                            FontSize="12"
                                            IsTextSelectionEnabled="True"
                                            Text="{x:Bind Path}"
                                            TextTrimming="CharacterEllipsis"
                                            VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <!-- Status bar  -->
                <TextBlock
                    Grid.Row="2"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.ChangesStatusMessageDisplay, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </Grid>
    </Grid>
</Page>
