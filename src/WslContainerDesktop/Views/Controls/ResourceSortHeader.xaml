<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="WslContainerDesktop.Views.Controls.ResourceSortHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Button x:Name="SortButton" Click="Sort_Click" Padding="0" MinWidth="0" MinHeight="0"
        Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch"
        HorizontalContentAlignment="Left">
        <StackPanel Orientation="Horizontal" Spacing="4">
            <ContentPresenter Content="{x:Bind Header, Mode=OneWay}" />
            <TextBlock x:Name="Indicator" />
        </StackPanel>
    </Button>
</UserControl>
