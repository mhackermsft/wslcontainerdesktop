<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="WslContainerDesktop.Views.Controls.K8sDashboardSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i18n="using:WslContainerDesktop.Helpers"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:WslContainerDesktop.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="CardButton" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="18,16" />
            <Setter Property="Width" Value="210" />
            <Setter Property="MinHeight" Value="96" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer>
        <helpers:WrapPanel HorizontalSpacing="12" VerticalSpacing="12">
            <Button x:Uid="Workload_K8sDashboardSection_001" i18n:Localization.Uid="Workload_K8sDashboardSection_001"
                Grid.Row="0"
                Grid.Column="0"
                Click="DashboardCard_Click"
                Style="{StaticResource CardButton}"
                Tag="Nodes"
                >
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE968;" />
                        <TextBlock x:Uid="Workload_K8sDashboardSection_002" i18n:Localization.Uid="Workload_K8sDashboardSection_002" Foreground="{ThemeResource TextFillColorSecondaryBrush}"  />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <StackPanel>
                            <TextBlock x:Uid="Workload_K8sDashboardSection_003" i18n:Localization.Uid="Workload_K8sDashboardSection_003" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"  />
                            <TextBlock FontSize="26" FontWeight="SemiBold" Text="{x:Bind ViewModel.NodeActiveCount, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock x:Uid="Workload_K8sDashboardSection_004" i18n:Localization.Uid="Workload_K8sDashboardSection_004" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"  />
                            <TextBlock FontSize="26" FontWeight="SemiBold" Text="{x:Bind ViewModel.NodeCount, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Button>

            <Button x:Uid="Workload_K8sDashboardSection_005" i18n:Localization.Uid="Workload_K8sDashboardSection_005"
                Grid.Row="0"
                Grid.Column="1"
                Click="DashboardCard_Click"
                Style="{StaticResource CardButton}"
                Tag="Deployments"
                >
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE7B8;" />
                        <TextBlock x:Uid="Workload_K8sDashboardSection_006" i18n:Localization.Uid="Workload_K8sDashboardSection_006" Foreground="{ThemeResource TextFillColorSecondaryBrush}"  />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <StackPanel>
                            <TextBlock x:Uid="Workload_K8sDashboardSection_007" i18n:Localization.Uid="Workload_K8sDashboardSection_007" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"  />
                            <TextBlock FontSize="26" FontWeight="SemiBold" Text="{x:Bind ViewModel.DeploymentActiveCount, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock x:Uid="Workload_K8sDashboardSection_008" i18n:Localization.Uid="Workload_K8sDashboardSection_008" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"  />
                            <TextBlock FontSize="26" FontWeight="SemiBold" Text="{x:Bind ViewModel.DeploymentCount, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Button>

            <Button x:Uid="Workload_K8sDashboardSection_009" i18n:Localization.Uid="Workload_K8sDashboardSection_009"
                Grid.Row="0"
                Grid.Column="2"
                Click="DashboardCard_Click"
                Style="{StaticResource CardButton}"
                Tag="Pods"
                >
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE7F4;" />
                        <TextBlock x:Uid="Workload_K8sDashboardSection_010" i18n:Localization.Uid="Workload_K8sDashboardSection_010" Foreground="{ThemeResource TextFillColorSecondaryBrush}"  />
                    </StackPanel>
                    <TextBlock FontSize="26" FontWeight="SemiBold" Text="{x:Bind ViewModel.PodCount, Mode=OneWay}" />
                </StackPanel>
            </Button>

            <Button x:Uid="Workload_K8sDashboardSection_011" i18n:Localization.Uid="Workload_K8sDashboardSection_011"
                Grid.Row="0"
                Grid.Column="3"
                Click="DashboardCard_Click"
                Style="{StaticResource CardButton}"
                Tag="Services"
                >
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE9D2;" />
                        <TextBlock x:Uid="Workload_K8sDashboardSection_012" i18n:Localization.Uid="Workload_K8sDashboardSection_012" Foreground="{ThemeResource TextFillColorSecondaryBrush}"  />
                    </StackPanel>
                    <TextBlock FontSize="26" FontWeight="SemiBold" Text="{x:Bind ViewModel.ServiceCount, Mode=OneWay}" />
                </StackPanel>
            </Button>

            <Button x:Uid="Workload_K8sDashboardSection_013" i18n:Localization.Uid="Workload_K8sDashboardSection_013"
                Grid.Row="1"
                Grid.Column="0"
                Click="DashboardCard_Click"
                Style="{StaticResource CardButton}"
                Tag="Ingresses"
                >
                <StackPanel Spacing="6">
                    <TextBlock x:Uid="Workload_K8sDashboardSection_014" i18n:Localization.Uid="Workload_K8sDashboardSection_014" Foreground="{ThemeResource TextFillColorSecondaryBrush}"  />
                    <TextBlock FontSize="26" FontWeight="SemiBold" Text="{x:Bind ViewModel.IngressCount, Mode=OneWay}" />
                </StackPanel>
            </Button>
            <Button x:Uid="Workload_K8sDashboardSection_015" i18n:Localization.Uid="Workload_K8sDashboardSection_015"
                Grid.Row="1"
                Grid.Column="1"
                Click="DashboardCard_Click"
                Style="{StaticResource CardButton}"
                Tag="Persistent Volume Claims"
                >
                <StackPanel Spacing="6">
                    <TextBlock x:Uid="Workload_K8sDashboardSection_016" i18n:Localization.Uid="Workload_K8sDashboardSection_016" Foreground="{ThemeResource TextFillColorSecondaryBrush}"  TextWrapping="Wrap" />
                    <TextBlock FontSize="26" FontWeight="SemiBold" Text="{x:Bind ViewModel.PvcCount, Mode=OneWay}" />
                </StackPanel>
            </Button>
            <Button x:Uid="Workload_K8sDashboardSection_017" i18n:Localization.Uid="Workload_K8sDashboardSection_017"
                Grid.Row="1"
                Grid.Column="2"
                Click="DashboardCard_Click"
                Style="{StaticResource CardButton}"
                Tag="ConfigMaps"
                >
                <StackPanel Spacing="6">
                    <TextBlock x:Uid="Workload_K8sDashboardSection_018" i18n:Localization.Uid="Workload_K8sDashboardSection_018" Foreground="{ThemeResource TextFillColorSecondaryBrush}"  />
                    <TextBlock FontSize="26" FontWeight="SemiBold" Text="{x:Bind ViewModel.ConfigMapCount, Mode=OneWay}" />
                </StackPanel>
            </Button>
            <Button x:Uid="Workload_K8sDashboardSection_019" i18n:Localization.Uid="Workload_K8sDashboardSection_019"
                Grid.Row="1"
                Grid.Column="3"
                Click="DashboardCard_Click"
                Style="{StaticResource CardButton}"
                Tag="Secrets"
                >
                <StackPanel Spacing="6">
                    <TextBlock x:Uid="Workload_K8sDashboardSection_020" i18n:Localization.Uid="Workload_K8sDashboardSection_020" Foreground="{ThemeResource TextFillColorSecondaryBrush}"  />
                    <TextBlock FontSize="26" FontWeight="SemiBold" Text="{x:Bind ViewModel.SecretCount, Mode=OneWay}" />
                </StackPanel>
            </Button>

            <Button x:Uid="Workload_K8sDashboardSection_021" i18n:Localization.Uid="Workload_K8sDashboardSection_021"
                Grid.Row="2"
                Grid.Column="0"
                Click="DashboardCard_Click"
                Style="{StaticResource CardButton}"
                Tag="Jobs"
                >
                <StackPanel Spacing="6">
                    <TextBlock x:Uid="Workload_K8sDashboardSection_022" i18n:Localization.Uid="Workload_K8sDashboardSection_022" Foreground="{ThemeResource TextFillColorSecondaryBrush}"  />
                    <TextBlock FontSize="26" FontWeight="SemiBold" Text="{x:Bind ViewModel.JobCount, Mode=OneWay}" />
                </StackPanel>
            </Button>
            <Button x:Uid="Workload_K8sDashboardSection_023" i18n:Localization.Uid="Workload_K8sDashboardSection_023"
                Grid.Row="2"
                Grid.Column="1"
                Click="DashboardCard_Click"
                Style="{StaticResource CardButton}"
                Tag="CronJobs"
                >
                <StackPanel Spacing="6">
                    <TextBlock x:Uid="Workload_K8sDashboardSection_024" i18n:Localization.Uid="Workload_K8sDashboardSection_024" Foreground="{ThemeResource TextFillColorSecondaryBrush}"  />
                    <TextBlock FontSize="26" FontWeight="SemiBold" Text="{x:Bind ViewModel.CronJobCount, Mode=OneWay}" />
                </StackPanel>
            </Button>
            <Button x:Uid="Workload_K8sDashboardSection_025" i18n:Localization.Uid="Workload_K8sDashboardSection_025"
                Grid.Row="2"
                Grid.Column="2"
                Click="DashboardCard_Click"
                Style="{StaticResource CardButton}"
                Tag="Port Forwarding"
                >
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE71B;" />
                        <TextBlock x:Uid="Workload_K8sDashboardSection_026" i18n:Localization.Uid="Workload_K8sDashboardSection_026" Foreground="{ThemeResource TextFillColorSecondaryBrush}"  />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock FontSize="26" FontWeight="SemiBold" Text="{x:Bind ViewModel.PortForwards.Count, Mode=OneWay}" />
                        <TextBlock x:Uid="Workload_K8sDashboardSection_027" i18n:Localization.Uid="Workload_K8sDashboardSection_027"
                            Margin="0,0,0,4"
                            VerticalAlignment="Bottom"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                             />
                    </StackPanel>
                </StackPanel>
            </Button>
        </helpers:WrapPanel>
    </ScrollViewer>
</UserControl>
