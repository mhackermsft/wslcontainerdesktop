<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WslContainerDesktop.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i18n="using:WslContainerDesktop.Helpers"
    xmlns:converters="using:WslContainerDesktop.Helpers"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:WslContainerDesktop.ViewModels"
    x:Name="Root"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:EmptyToVisibilityConverter x:Key="EmptyToVis" />
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="18,16" />
            <Setter Property="MinWidth" Value="210" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Margin="24,16,24,24" Spacing="16">

            <!-- Header  -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock x:Uid="Resource_Dashboard_001" i18n:Localization.Uid="Resource_Dashboard_001" Style="{ThemeResource TitleTextBlockStyle}" />
                    <TextBlock x:Uid="Resource_Dashboard_002" i18n:Localization.Uid="Resource_Dashboard_002"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}" />
                </StackPanel>
                <Button x:Uid="Dashboard_Refresh" i18n:Localization.Uid="Dashboard_Refresh"
                    Grid.Column="1" VerticalAlignment="Top" Command="{x:Bind ViewModel.RefreshCommand}">
                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                </Button>
            </Grid>

            <StackPanel Spacing="4">
                <TextBlock x:Uid="Dashboard_AllSessionsNotice" i18n:Localization.Uid="Dashboard_AllSessionsNotice"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                <TextBlock Text="{x:Bind ViewModel.InventoryStatus, Mode=OneWay}" TextWrapping="Wrap" />
                <TextBlock Text="{x:Bind ViewModel.InventoryWarning, Mode=OneWay}"
                    Foreground="{ThemeResource SystemFillColorCautionBrush}" TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.InventoryWarning, Mode=OneWay, Converter={StaticResource EmptyToVis}, ConverterParameter=invert}" />
            </StackPanel>

            <!-- Summary cards (reflow onto multiple rows when narrow)  -->
            <converters:WrapPanel HorizontalSpacing="14" VerticalSpacing="14">

                <Border Style="{StaticResource StatCard}">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                FontSize="16"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE7F4;" />
                            <TextBlock x:Uid="Resource_Dashboard_003" i18n:Localization.Uid="Resource_Dashboard_003" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock
                                FontSize="30"
                                FontWeight="SemiBold"
                                Text="{x:Bind ViewModel.RunningContainersDisplay, Mode=OneWay}" />
                            <TextBlock x:Uid="Resource_Dashboard_004" i18n:Localization.Uid="Resource_Dashboard_004"
                                Margin="0,0,0,4"
                                VerticalAlignment="Bottom"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}">
                            <Run x:Uid="Resource_Dashboard_005" i18n:Localization.Uid="Resource_Dashboard_005" />
                            <Run Text="{x:Bind ViewModel.TotalContainersDisplay, Mode=OneWay}" />
                            <Run x:Uid="Resource_Dashboard_006" i18n:Localization.Uid="Resource_Dashboard_006" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource StatCard}">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                FontSize="16"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xEB9F;" />
                            <TextBlock x:Uid="Resource_Dashboard_007" i18n:Localization.Uid="Resource_Dashboard_007" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock
                            FontSize="30"
                            FontWeight="SemiBold"
                            Text="{x:Bind ViewModel.ImageCountDisplay, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource StatCard}">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                FontSize="16"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE8B7;" />
                            <TextBlock x:Uid="Resource_Dashboard_008" i18n:Localization.Uid="Resource_Dashboard_008" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock
                            FontSize="30"
                            FontWeight="SemiBold"
                            Text="{x:Bind ViewModel.VolumeCountDisplay, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource StatCard}">
                    <StackPanel Spacing="6">
                        <TextBlock x:Uid="Dashboard_ActiveSessions" i18n:Localization.Uid="Dashboard_ActiveSessions"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            FontSize="30"
                            FontWeight="SemiBold"
                            Text="{x:Bind ViewModel.ActiveSessionsDisplay, Mode=OneWay}" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="{x:Bind ViewModel.EngineVersionDisplay, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </converters:WrapPanel>

            <!-- Aggregate CPU  -->
            <Border Style="{StaticResource StatCard}">
                <StackPanel Spacing="8">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                FontSize="16"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE950;" />
                            <TextBlock x:Uid="Dashboard_CombinedCpu" i18n:Localization.Uid="Dashboard_CombinedCpu" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock
                            HorizontalAlignment="Right"
                            FontWeight="SemiBold"
                            Text="{x:Bind ViewModel.TotalCpu, Mode=OneWay}" />
                    </Grid>
                    <TextBlock x:Uid="Dashboard_CombinedCpuHelp" i18n:Localization.Uid="Dashboard_CombinedCpuHelp"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind ViewModel.StatsWarning, Mode=OneWay}"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}" TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.StatsWarning, Mode=OneWay, Converter={StaticResource EmptyToVis}, ConverterParameter=invert}" />
                    <TextBlock Text="{x:Bind ViewModel.StatsFreshness, Mode=OneWay}"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Visibility="{x:Bind ViewModel.StatsFreshness, Mode=OneWay, Converter={StaticResource EmptyToVis}, ConverterParameter=invert}" />
                </StackPanel>
            </Border>

            <!-- Live per-container stats  -->
            <TextBlock x:Uid="Resource_Dashboard_011" i18n:Localization.Uid="Resource_Dashboard_011"
                Margin="2,4,0,0"
                Style="{ThemeResource BodyStrongTextBlockStyle}" />

            <Border
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <ScrollViewer x:Name="PerfViewport" SizeChanged="PerfViewport_SizeChanged"
                    HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto"
                    VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                <Grid x:Name="PerfRoot">
                    <!-- Column header (wide only)  -->
                    <Grid x:Name="PerfHeader" Padding="16,10" VerticalAlignment="Top" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" MinWidth="80" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="ResourceSessionColumn" i18n:Localization.Uid="ResourceSessionColumn" Grid.Column="0" Style="{ThemeResource CaptionTextBlockStyle}" />
                        <TextBlock x:Uid="Resource_Dashboard_012" i18n:Localization.Uid="Resource_Dashboard_012" Grid.Column="1" Style="{ThemeResource CaptionTextBlockStyle}" />
                        <TextBlock Grid.Column="2" Style="{ThemeResource CaptionTextBlockStyle}" Text="CPU" />
                        <TextBlock x:Uid="Resource_Dashboard_013" i18n:Localization.Uid="Resource_Dashboard_013" Grid.Column="3" Style="{ThemeResource CaptionTextBlockStyle}" />
                        <TextBlock x:Uid="Resource_Dashboard_014" i18n:Localization.Uid="Resource_Dashboard_014" Grid.Column="4" Style="{ThemeResource CaptionTextBlockStyle}" />
                        <TextBlock x:Uid="Resource_Dashboard_015" i18n:Localization.Uid="Resource_Dashboard_015" Grid.Column="5" Style="{ThemeResource CaptionTextBlockStyle}" />
                    </Grid>

                    <!-- Clicking a row opens that container's detail page, like the Containers list.  -->
                    <ListView x:Uid="Resource_Dashboard_016" i18n:Localization.Uid="Resource_Dashboard_016"
                        x:Name="PerfList"
                        Margin="0,40,0,6"

                        IsItemClickEnabled="True"
                        ItemClick="PerfList_ItemClick"
                        ItemsSource="{x:Bind ViewModel.LiveStats, Mode=OneWay}"
                        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollMode="Disabled"
                        SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:DashboardStatRow">
                                <Grid x:Name="PerfRowRoot">
                                <Grid x:Name="PerfWideGrid" Padding="16,8" ColumnSpacing="8"
                                    Visibility="{x:Bind IsWideLayout, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" MinWidth="80" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                        Text="{x:Bind SessionName, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{x:Bind SessionName, Mode=OneWay}" />
                                    <Grid Grid.Column="1" VerticalAlignment="Center" ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Text="{x:Bind Name, Mode=OneWay}"
                                            ToolTipService.ToolTip="{x:Bind Name, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />
                                        <Border
                                            Grid.Column="1"
                                            Padding="5,1"
                                            VerticalAlignment="Center"
                                            Background="#1F7A3D"
                                            CornerRadius="4"
                                            ToolTipService.ToolTip="{x:Bind GpuTooltip, Mode=OneWay}"
                                            Visibility="{x:Bind HasGpu, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal" Spacing="3">
                                                <FontIcon FontSize="10" Foreground="White" Glyph="&#xE950;" />
                                                <TextBlock FontSize="10" Foreground="White" Text="GPU" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <StackPanel
                                        Grid.Column="2"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        Spacing="3">
                                        <TextBlock FontSize="13" Text="{x:Bind Cpu, Mode=OneWay}" />
                                        <ProgressBar
                                            Maximum="100"
                                            Minimum="0"
                                            Visibility="{x:Bind StatsAvailable, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                            Value="{x:Bind CpuBarValue, Mode=OneWay}" />
                                    </StackPanel>

                                    <StackPanel
                                        Grid.Column="3"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        Spacing="3">
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind MemUsage, Mode=OneWay}"
                                            ToolTipService.ToolTip="{x:Bind MemUsage, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />
                                        <ProgressBar
                                            Maximum="100"
                                            Minimum="0"
                                            Visibility="{x:Bind StatsAvailable, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                            Value="{x:Bind MemBarValue, Mode=OneWay}" />
                                    </StackPanel>

                                    <TextBlock
                                        Grid.Column="4"
                                        VerticalAlignment="Center"
                                        FontFamily="Consolas"
                                        FontSize="12"
                                        Text="{x:Bind NetIO, Mode=OneWay}"
                                        ToolTipService.ToolTip="{x:Bind NetIO, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="5"
                                        VerticalAlignment="Center"
                                        FontFamily="Consolas"
                                        FontSize="12"
                                        Text="{x:Bind BlockIO, Mode=OneWay}"
                                        ToolTipService.ToolTip="{x:Bind BlockIO, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                </Grid>

                                <!-- Narrow: stacked card layout  -->
                                <StackPanel x:Name="PerfNarrowPanel" Padding="16,10" Spacing="8"
                                    Visibility="{x:Bind IsWideLayout, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                    <TextBlock Text="{x:Bind SessionName, Mode=OneWay}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Text="{x:Bind Name, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />
                                        <Border
                                            Padding="5,1"
                                            VerticalAlignment="Center"
                                            Background="#1F7A3D"
                                            CornerRadius="4"
                                            ToolTipService.ToolTip="{x:Bind GpuTooltip, Mode=OneWay}"
                                            Visibility="{x:Bind HasGpu, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal" Spacing="3">
                                                <FontIcon FontSize="10" Foreground="White" Glyph="&#xE950;" />
                                                <TextBlock FontSize="10" Foreground="White" Text="GPU" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}" Text="CPU" />
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock FontSize="13" Text="{x:Bind Cpu, Mode=OneWay}" />
                                            <ProgressBar Maximum="100" Minimum="0" Value="{x:Bind CpuBarValue, Mode=OneWay}"
                                                Visibility="{x:Bind StatsAvailable, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="Resource_Dashboard_017" i18n:Localization.Uid="Resource_Dashboard_017" Grid.Column="0" VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}" />
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind MemUsage, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis" />
                                            <ProgressBar Maximum="100" Minimum="0" Value="{x:Bind MemBarValue, Mode=OneWay}"
                                                Visibility="{x:Bind StatsAvailable, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock x:Uid="Resource_Dashboard_018" i18n:Localization.Uid="Resource_Dashboard_018" Grid.Row="0" Grid.Column="0" Style="{ThemeResource CaptionTextBlockStyle}" />
                                        <TextBlock
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            FontFamily="Consolas"
                                            FontSize="12"
                                            Text="{x:Bind NetIO, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Uid="Resource_Dashboard_019" i18n:Localization.Uid="Resource_Dashboard_019" Grid.Row="1" Grid.Column="0" Style="{ThemeResource CaptionTextBlockStyle}" />
                                        <TextBlock
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            FontFamily="Consolas"
                                            FontSize="12"
                                            Text="{x:Bind BlockIO, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel
                        Margin="0,70,0,20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Spacing="8"
                        Visibility="{x:Bind ViewModel.LiveStats.Count, Mode=OneWay, Converter={StaticResource EmptyToVis}}">
                        <FontIcon
                            HorizontalAlignment="Center"
                            FontSize="36"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="&#xE9D9;" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.EmptyStatsMessage, Mode=OneWay}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
                </ScrollViewer>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
