<ContentDialog
    x:Class="WslContainerDesktop.Dialogs.ComposePreviewDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:WslContainerDesktop.Models"
    xmlns:converters="using:WslContainerDesktop.Helpers"
    AutomationProperties.AutomationId="ComposePreviewDialog"
    Title="{x:Bind ViewModel.Title}"
    PrimaryButtonText="{x:Bind ViewModel.ApplyLabel}"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanApply}"
    CloseButtonText="Cancel"
    DefaultButton="Close">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">880</x:Double>
        <!-- Without a height cap the dialog grows to fit its content, so its built-in scroll viewer
             never has anything to scroll and the review simply runs off the screen. -->
        <x:Double x:Key="ContentDialogMaxHeight">680</x:Double>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
    </ContentDialog.Resources>
    <!-- Two bounded scroll regions, not one unbounded pair. The inner one (in the Expander) gives
         that section a finite extent, which is what the outer one needs in order to measure the
         dialog correctly; previously the Expander reported its collapsed size and the outer
         scrollbar rendered with nothing to scroll. -->
    <ScrollViewer
        MinWidth="480"
        MaxWidth="800"
        MaxHeight="560"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Enabled"
        HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="12">
            <InfoBar
                AutomationProperties.AutomationId="ComposePreviewStatus"
                IsOpen="True"
                IsClosable="False"
                Severity="{x:Bind Severity}"
                Message="{x:Bind ViewModel.Summary}" />
            <StackPanel Spacing="4">
                <TextBlock Text="What this does" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock
                    AutomationProperties.AutomationId="ComposePreviewOutcome"
                    Text="{x:Bind ViewModel.Outcome}"
                    TextWrapping="Wrap"
                    IsTextSelectionEnabled="True" />
            </StackPanel>
            <!-- Blocked, approximated and ignored settings are the only ones that need a decision. -->
            <StackPanel
                Spacing="8"
                Visibility="{x:Bind ViewModel.HasAttention, Converter={StaticResource BoolToVis}}">
                <TextBlock
                    AutomationProperties.AutomationId="ComposePreviewAttentionHeader"
                    Text="{x:Bind ViewModel.AttentionHeader}"
                    Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ItemsControl
                    AutomationProperties.AutomationId="ComposePreviewAttention"
                    ItemsSource="{x:Bind ViewModel.Attention}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:ComposeCompatibilitySetting">
                            <StackPanel Spacing="4" Padding="0,6">
                                <TextBlock Text="{x:Bind Summary}" TextWrapping="Wrap" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{x:Bind Detail}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <Expander
                AutomationProperties.AutomationId="ComposePreviewAllSettings"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Header="{x:Bind ViewModel.AllSettingsHeader}">
                <!-- Scroll the long list itself rather than the whole dialog. An Expander nested
                     inside a ScrollViewer reports its collapsed extent, so the outer scrollbar
                     appeared but had nothing to scroll; keeping the scroll region here also means
                     the dialog stays short while the section is collapsed. -->
                <ScrollViewer
                    MaxHeight="380"
                    VerticalScrollBarVisibility="Auto"
                    VerticalScrollMode="Enabled"
                    HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl
                        AutomationProperties.AutomationId="ComposePreviewSettings"
                        AutomationProperties.Name="Resolved Compose settings and compatibility"
                        ItemsSource="{x:Bind ViewModel.Settings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:ComposeCompatibilitySetting">
                                <StackPanel Spacing="4" Padding="0,6">
                                    <TextBlock Text="{x:Bind Summary}" TextWrapping="Wrap" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock
                                        Text="{x:Bind Detail}"
                                        TextWrapping="Wrap"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        IsTextSelectionEnabled="True" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
